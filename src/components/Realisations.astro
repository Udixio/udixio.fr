---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import { Button, Card, classNames } from "@udixio/ui-react";
import { BackgroundColor } from "@components/BackgroundColor";

import type { ProjectProps } from "./project/Project";
import { ProjectsShowcase } from "./home/modern/ProjectsShowcase";
import ShowcaseManager from "./home/modern/ShowcaseManager.astro";
import { getImage } from "astro:assets";
import { Project } from "./project/Project.tsx";

interface Props {
  max?: number;
  manageShowcase?: boolean;
}

const { max, manageShowcase = true }: Props = Astro.props;

const realisations = await getCollection("realisation");
realisations.sort(
  (a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity),
);

const renders     = import.meta.glob("@assets/renders/*.webp",     { eager: true });
const backgrounds = import.meta.glob("@assets/backgrounds/*.webp", { eager: true });

const projectsProps: ProjectProps[] = await Promise.all(
  realisations.map(async (realisation) => {
    const bg   = realisation.data.images.background;
    const slug = realisation.id;

    // Priorité : background src/assets/backgrounds/ → render src/assets/renders/ → src MDX brut
    const bgEntry =
      (Object.entries(backgrounds).find(([path]) => path.endsWith(`${slug}-background.webp`))?.[1] as any)?.default
      ?? (Object.entries(renders).find(([path]) => path.endsWith(`${slug}.webp`))?.[1] as any)?.default;

    const resolvedSrc = bgEntry
      ? (await getImage({ src: bgEntry, format: "webp", width: max ? 600 : 800 })).src
      : (bg?.src ?? "");

    return {
      slug,
      ...realisation.data,
      images: {
        ...realisation.data.images,
        background: {
          src: resolvedSrc,
          alt: bg?.alt ?? "",
          sourceColor: bg?.sourceColor,
        },
      },
    };
  }),
);

const visibleProjects = max ? projectsProps.slice(0, max) : projectsProps;
---

{
  max ? (
    <>
      {manageShowcase && (
        <ShowcaseManager
          total={visibleProjects.length}
          colors={visibleProjects.map((p) => p.images?.background?.sourceColor)}
        />
      )}
      <ProjectsShowcase projects={visibleProjects} client:visible />
    </>
  ) : (
    <div class="max-width padding-x gap-x-8 gap-y-16  md:gap-y-32 grid grid-cols-1 sm:grid-cols-20 ">
      {visibleProjects.map((realisation, index) => {
        const isTrue = [0, 3, 4, 7].includes(index % 8); // Détermine "true" ou "false"

        return (
          <a
            class={classNames("col-span-1 row-span-1", {
              "sm:col-span-11 sm:aspect-10/7 ": isTrue,
              "sm:col-span-9 sm:aspect-8/9": !isTrue,
              "self-end": index % 4 == 0,
              "sm:-mt-[25%] ": index % 4 === 1 && index != 0 && index != 1,
            })}
            href={"/realisations/" + realisation.slug}
          >
            <Project client:load view="mini" {...realisation} />
          </a>
        );
      })}
    </div>
  )
}
