---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import { Button, Card, classNames } from "@udixio/ui-react";
import { BackgroundColor } from "@components/BackgroundColor";

import type { ProjectProps } from "./project/Project";
import { ProjectsShowcase } from "./home/modern/ProjectsShowcase";
import { ShowcaseItem } from "./home/modern/ShowcaseItem";
import ShowcaseManager from "./home/modern/ShowcaseManager.astro";
import { getImage } from "astro:assets";
import { Project } from "./project/Project.tsx";
import { getProjects } from "@/utils/getProjects";

interface Props {
  max?: number;
  manageShowcase?: boolean;
}

const { max, manageShowcase = true }: Props = Astro.props;

const visibleProjects = await getProjects(max);
---

{
  max ? (
    <>
      {manageShowcase && (
        <ShowcaseManager
          total={visibleProjects.length}
          colors={visibleProjects.map((p) => p.images?.background?.sourceColor)}
        />
      )}
      <ProjectsShowcase projects={visibleProjects} client:visible />
    </>
  ) : (
    <div class="max-width padding-x gap-x-8 gap-y-16  md:gap-y-32 grid grid-cols-1 sm:grid-cols-20 ">
      {visibleProjects.map((realisation, index) => {
        const isTrue = [0, 3, 4, 7].includes(index % 8); // Détermine "true" ou "false"

        return (
          <ShowcaseItem
            client:load
            className={classNames("col-span-1 row-span-1", {
              "sm:col-span-11 sm:aspect-10/7 ": isTrue,
              "sm:col-span-9 sm:aspect-8/9": !isTrue,
              "self-end": index % 4 == 0,
              "sm:-mt-[25%] ": index % 4 === 1 && index != 0 && index != 1,
            })}
            project={realisation}
          />
        );
      })}
    </div>
  )
}
