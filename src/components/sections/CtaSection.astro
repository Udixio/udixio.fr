---
import { Button } from "@udixio/ui-react";

interface Props {
  title: string;
  description?: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  title,
  description,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
} = Astro.props;
---

<section class="section py-36 relative overflow-hidden">
  <div class="absolute inset-0 bg-primary opacity-5 skew-y-3 scale-110"></div>
  <div class="max-width padding-x relative z-10 text-center">
    <h2 class="text-headline-medium mb-8">{title}</h2>
    {
      description && (
        <p class="text-title-medium text-on-surface-variant mb-12 max-w-2xl mx-auto">
          {description}
        </p>
      )
    }
    <div class="flex justify-center gap-6 flex-wrap">
      <Button href={primaryHref} shape="squared" label={primaryLabel} />
      {
        secondaryLabel && secondaryHref && (
          <Button
            href={secondaryHref}
            label={secondaryLabel}
            variant="outlined"
          />
        )
      }
    </div>
  </div>
</section>
