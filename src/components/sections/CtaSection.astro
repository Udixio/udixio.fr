---
import { Button } from "@udixio/ui-react";
import { Card } from "../Card";

interface Props {
  title: string;
  description?: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  title,
  description,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
} = Astro.props;
---

<section class="">
  <Card
    className="section min-h-[50vh] bg-primary-container text-on-primary-container flex items-center relative z-10 text-center justify-center"
  >
    <div>
      <h2 class="text-headline-medium mb-8">{title}</h2>
      {
        description && (
          <p class="text-title-medium text-on-surface-variant mb-12 max-w-2xl mx-auto">
            {description}
          </p>
        )
      }
      <div class="flex justify-center gap-6 flex-wrap">
        <Button href={primaryHref} shape="squared" label={primaryLabel} />
        {
          secondaryLabel && secondaryHref && (
            <Button
              href={secondaryHref}
              label={secondaryLabel}
              variant="outlined"
            />
          )
        }
      </div>
    </div>
  </Card>
</section>
