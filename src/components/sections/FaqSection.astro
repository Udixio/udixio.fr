---
import { Button } from "@udixio/ui-react";
import { FaqAccordion } from "@components/home/modern/FaqAccordion";

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
  items: FaqItem[];
}

const {
  title = "Vous avez des questions ?",
  description = "Voici des réponses concrètes avant d'aller plus loin.",
  ctaLabel = "Poser une autre question",
  ctaHref = "/contact",
  items,
} = Astro.props;
---

<section class="section py-32">
  <div class="max-width padding-x grid md:grid-cols-2 gap-16">
    <div>
      <h2 class="text-headline-large mb-8">{title}</h2>
      <p class="text-title-medium text-on-surface-variant mb-8">
        {description}
      </p>
      <Button
        href={ctaHref}
        label={ctaLabel}
        variant="outlined"
        className="w-fit"
      />
    </div>
    <div>
      <FaqAccordion client:visible items={items} />
    </div>
  </div>
</section>
