---
import Layout from "../../layouts/Layout.astro";
import {Icon, Button,} from "@udixio/ui-react"
import {Card} from "@/components/Card"
import {
    faTriangleExclamation,
    faPhoneVolume,
    faCircleCheck,
    faRocket, faMagnifyingGlass,
    faRocketLaunch, faUserTie, faHandHoldingDollar, faHandshake
} from "@fortawesome/pro-solid-svg-icons";
import {faDisplay, faMoneyBillTrendUp, faUser} from "@fortawesome/pro-regular-svg-icons";
import {faQuoteRight} from "@fortawesome/free-solid-svg-icons";
import Compare from "@/components/Compare";
---
<Layout seo={{
    noindex: true,
    title: `Agence de conseil en stratégie digitale écoresponsable & SEO • udixio.fr`,
    description: "Udixio est une agence experte dans la création de sites web éco-conçus et optimisés pour le SEO. Optez pour des solutions digitales durables et performantes.",
}}>
    <section class="section min-h-screen flex items-center">
        <div>
            <h1 class="text-display-medium max-w-prose">
                DÉPLOYEZ UNE MACHINE
                DE CROISSANCE POUR
                VOTRE ENTREPRISE
            </h1>
            <p class="text-body-large mt-8 max-w-prose">Développer une entreprise est difficile...
                Obtenir plus de marge, de demandes récurrentes et qualifiées
                chaque mois l’est encore plus.
            </p>
            <p class="text-body-large mt-8 max-w-prose">
                Nous rendons cela beaucoup plus simple, plus prévisible et moins
                stressant grâce à un système qui fonctionne 24 heures sur 24 et 7
                jours sur 7 pour booster votre chiffre d’affaires.
            </p>

            <p class="flex gap-3 items-center mt-8 max-w-prose text-warning text-body-medium ml-1">
                <Icon className="size-5" icon={faTriangleExclamation}></Icon>
                Service soumis à éligibilité et validation.
            </p>

            <Button className="w-fit mt-8" client:load href="#contact">Demander un devis gratuit</Button>
        </div>
    </section>

    <section class="section grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        <Card className={"p-12 md:col-span-2"}>
            <div class="p-6  aspect-square flex items-center justify-center rounded-2xl bg-secondary-container w-fit">
                <Icon className="size-10 text-on-secondary-container" icon={faPhoneVolume}></Icon>
            </div>
            <p class="text-headline-small mt-8">
                Imaginez être en <span class="text-gradient text-headline-medium">top position</span>
                sur <span class="text-gradient  text-headline-medium">Google</span> recevez des
                <span class="text-gradient  text-headline-medium">demandes</span> en continu
            </p>
        </Card>
        <Card className={"p-12 col-span-1 theme-warning"}>
            <div class="p-6  aspect-square flex items-center justify-center rounded-2xl bg-secondary-container w-fit">
                <Icon className="size-10 text-on-secondary-container" icon={faTriangleExclamation}></Icon>
            </div>
            <p class="text-headline-small mt-8">
               <span class="text-gradient text-headline-medium mb-1">  Sous réserve de votre
                   éligibilité</span>
            </p>
            <p class="text-body-large mt-2">
                Des documents de
                vérifications sont
                nécessaires pour ce service.
            </p>
        </Card>
        <Card className={"p-12 col-span-1  theme-success"}>
            <div class="p-6  aspect-square flex items-center justify-center rounded-2xl bg-secondary-container w-fit">
                <Icon className="size-10 text-on-secondary-container" icon={faCircleCheck}></Icon>
            </div>
            <p class="text-headline-small mt-8">
                <span class="text-gradient  text-headline-medium">Améliorez</span>
                votre
                <span class="text-gradient  text-headline-medium">notoriété</span>
            </p>
            <p class="text-body-large mt-2">
                Plus de visibilité, plus
                d’opportunités.
            </p>
        </Card>
        <Card className={"p-12 col-span-1  "}>
            <div class="p-6  aspect-square flex items-center justify-center rounded-2xl bg-secondary-container w-fit">
                <Icon className="size-10 text-on-secondary-container" icon={faRocketLaunch}></Icon>
            </div>
            <p class="text-headline-small mt-8">
                <span class="text-gradient  text-headline-medium">100% clé en main</span>
            </p>
            <p class="text-body-large mt-2">
                Dominez votre secteur en
                propulsant votre visibilité
                digitale dans une zone
                stratégique définie.
            </p>
        </Card>
        <Card className={"p-12 col-span-1 overflow-visible flex flex-col justify-between"}>
            <Icon className="absolute text-display-medium right-0 top-0 -translate-y-1/3 translate-x-1/3 size-18"
                  icon={faQuoteRight}/>
            <p class="text-headline-small">
                <span class=" text-headline-large mb-1 block">“J’ai eu 48
                demandes le
                mois dernier”</span>
            </p>
            <div class="w-fit ml-auto flex gap-4">
                <div class="text-body-large text-right">
                    <p>Laurent</p>
                    <p>Avocat dans le 64</p>
                </div>
                <div class="p-2 aspect-square flex items-center justify-center rounded-2xl bg-secondary-container w-fit">
                    <Icon className="size-10 text-on-secondary-container" icon={faUser}></Icon>
                </div>
            </div>
        </Card>
    </section>

    <section class="section">
        <h2 class="text-display-medium text-center">Pourquoi est-il important
            d’avoir un site internet ?</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
            <Card className={"p-12 flex-1"}>
                <div class="flex gap-4 items-center ">
                    <Icon className="size-10 " icon={faMagnifyingGlass}></Icon>
                    <h3 class="text-headline-medium">Visibilité</h3>
                </div>
                <p class="text-body-large text-on-surface-variant mt-8">
                    Exister sur internet pour <span class="text-on-surface ">être
                    trouvé à tout instant</span> quand
                    quelqu’un a besoin de vos
                    services.
                </p>
                <p class="text-body-large mt-4">
                    97% des consommateurs
                    utilisent internet pour trouver
                    un professionnel
                </p>
            </Card>
            <Card className={"p-12 flex-1"}>
                <div class="flex gap-4 items-center ">
                    <Icon className="size-10 " icon={faUserTie}></Icon>
                    <h3 class="text-headline-medium">Crédibilité</h3>
                </div>
                <p class="text-body-large text-on-surface-variant mt-8">
                    Votre vitrine témoigne de votre
                    sérieux. Avoir un <span class="text-on-surface ">site optimisé,
                    beau</span> et <span class="text-on-surface ">adapté sur mobile</span>
                    vous permet de ne pas faire
                    peur aux visiteurs.
                </p>
                <p class="text-body-large mt-4">
                    75% des consommateurs
                    jugent la crédibilité d’une
                    entreprise sur le design de son
                    site web
                </p>
            </Card>
            <Card className={"p-12 flex-1"}>
                <div class="flex gap-4 items-center ">
                    <Icon className="size-10 " icon={faHandHoldingDollar}></Icon>
                    <h3 class="text-headline-medium">Vente 24/7</h3>
                </div>
                <p class="text-body-large text-on-surface-variant mt-8">
                    Votre site ne dors pas, ne prend
                    pas de congés et travaille
                    <span class="text-on-surface ">24h/24 7j/7</span>.<br/>
                    Il génère des appels et des
                    demandes de devis.
                </p>
                <p class="text-body-large mt-4">
                    81 % des dirigeants
                    considèrent le numérique
                    comme un bénéfice réel pour
                    leur entreprise.
                </p>
            </Card>
        </div>
    </section>
    <section class="section grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">
        <Card className="p-12">
            <div class="flex gap-6">
                <img loading="lazy" class="size-24" alt="Logo de Udixio" src="/favicon.svg"/>
                <div>
                    <p class="text-display-medium">UDIXIO</p>
                    <p class="text-title-small">Votre levier digital</p>
                </div>
            </div>

            <h3 class="mt-8 text-headline-large">PLUS DE VISIBILITÉ,
                PLUS DE CLIENTS</h3>
            <p class="mt-8 text-body-large">Pourquoi nous faire confiance</p>
            <p class="mt-8 text-body-large">Nous comprenons vos problématiques et
                les transformons en opportunité.</p>
            <p class="mt-8 ">Vous en avez assez d’être invisible ?</p>
            <p class="mt-8 ">Désactivons le mode fantôme et faisons
                connaître vos services partout autour de
                vous</p>
        </Card>
        <div class="flex flex-col gap-6 lg:gap-8">
            <Card className="p-12 flex gap-12 items-center">
                <div class="p-6 aspect-square flex items-center justify-center bg-secondary-container w-fit rounded-full">
                    <Icon className="size-16 text-on-secondary-container" icon={faDisplay}></Icon>
                </div>
                <div>
                    <h3 class="text-headline-medium">WEB HAUT DE GAMME</h3>
                    <p class="text-body-large text-on-surface-variant mt-4">
                        Création de <span class="text-on-surface ">vitrine web
                        professionnelle</span> qui <span class="text-on-surface ">met en valeur
                        votre expertise</span></p>
                </div>
            </Card>
            <Card className="p-12 flex gap-12 items-center">
                <div class="p-6 aspect-square flex items-center justify-center bg-secondary-container w-fit rounded-full">
                    <Icon className="size-16 text-on-secondary-container" icon={faMoneyBillTrendUp}></Icon>
                </div>
                <div>
                    <h3 class="text-headline-medium">RENTABILITÉ</h3>
                    <p class="text-body-large text-on-surface-variant mt-4">Votre solution fonctionne sans
                        relâche, <span class="text-on-surface ">24h/24, 7j/7, attirant un
                            flux d’appels et de prospects</span></p>
                </div>
            </Card>
            <Card className="p-12 flex gap-12 items-center">
                <div class="p-6 aspect-square flex items-center justify-center bg-secondary-container w-fit rounded-full">
                    <Icon className="size-16 text-on-secondary-container" icon={faHandshake}></Icon>
                </div>
                <div>
                    <h3 class="text-headline-medium">ECOUTE ET PROXIMITÉ</h3>
                    <p class="text-body-large text-on-surface-variant mt-4">Bénéficiez d’une proximité
                        d'écoute et de <span class="text-on-surface ">solutions adaptées
                            à vos besoins</span>.</p>
                </div>
            </Card>
        </div>
    </section>
    <section class="section">
        <h2 class="text-display-medium text-center">Comparez nos offres</h2>
        <div class="mt-8">
            <Compare client:load groups={[
                {
                    id: 'site',
                    label: 'Sites vitrines',
                    plans: [
                        { id: 'start', name: 'Start', price: 'à partir de 890 €', badge: 'Populaire' },
                        { id: 'pro', name: 'Pro', price: 'à partir de 1 990 €' },
                        { id: 'business', name: 'Business', price: 'à partir de 3 490 €' },
                        { id: 'elite', name: 'Elite', price: 'sur devis' },
                    ],
                    categories: [
                        {
                            id: 'design',
                            label: 'Design & branding',
                            features: [
                                { id: 'ui', label: 'Design moderne et responsive', value: { start: true, pro: true, business: true, elite: true } },
                                { id: 'branding', label: 'Personnalisation avancée du thème', value: { start: 'Basique', pro: 'Standard', business: 'Avancée', elite: 'Sur-mesure' } },
                            ],
                        },
                        {
                            id: 'seo',
                            label: 'SEO & performance',
                            features: [
                                { id: 'seo-tech', label: 'SEO technique de base', value: { start: true, pro: true, business: true, elite: true } },
                                { id: 'seo-adv', label: 'Optimisation SEO avancée', value: { start: false, pro: 'partial', business: true, elite: true }, note: 'Schema, maillage interne, contenus piliers' },
                                { id: 'perf', label: 'Optimisation des performances', value: { start: true, pro: true, business: true, elite: true } },
                            ],
                        },
                        {
                            id: 'content',
                            label: 'Contenus inclus',
                            features: [
                                { id: 'pages', label: 'Nombre de pages incluses', value: { start: '1–3', pro: '4–6', business: '7–12', elite: 'Illimité*' }, note: '* selon cahier des charges' },
                                { id: 'blog', label: 'Blog', value: { start: false, pro: true, business: true, elite: true } },
                            ],
                        },
                        {
                            id: 'support',
                            label: 'Accompagnement',
                            features: [
                                { id: 'formation', label: 'Formation à la prise en main', value: { start: true, pro: true, business: true, elite: true } },
                                { id: 'suivi', label: 'Support & maintenance', value: { start: '30 j', pro: '3 mois', business: '6 mois', elite: '12 mois' } },
                            ],
                        },
                    ],
                },
                {
                    id: 'marketing',
                    label: 'Marketing local',
                    plans: [
                        { id: 'basic', name: 'Essentiel', price: 'à partir de 390 €/mois' },
                        { id: 'boost', name: 'Boost', price: 'à partir de 690 €/mois', badge: 'Recommandé' },
                        { id: 'growth', name: 'Croissance', price: 'à partir de 1 190 €/mois' },
                        { id: 'dominate', name: 'Domination', price: 'sur devis' },
                    ],
                    categories: [
                        {
                            id: 'ads',
                            label: 'Publicité & acquisition',
                            features: [
                                { id: 'google-ads', label: 'Gestion Google Ads', value: { basic: false, boost: true, growth: true, dominate: true } },
                                { id: 'meta-ads', label: 'Gestion Meta Ads', value: { basic: false, boost: 'partial', growth: true, dominate: true } },
                            ],
                        },
                        {
                            id: 'tracking',
                            label: 'Suivi & analytics',
                            features: [
                                { id: 'ga4', label: 'Mise en place GA4 + conversions', value: { basic: true, boost: true, growth: true, dominate: true } },
                                { id: 'report', label: 'Rapport mensuel', value: { basic: true, boost: true, growth: true, dominate: true } },
                                { id: 'call', label: 'Call stratégique mensuel', value: { basic: false, boost: true, growth: true, dominate: true } },
                            ],
                        },
                    ],
                }
            ]} />
        </div>
    </section>
</Layout>
