                      ultimate: "Support + 6 bilans / an",
                    },
                  },
                ],
              },
              {
                id: "fonctionnalités",
                label: "Fonctionnalités",
                features: [
                  {
                    label: "Formulaire contact",
                    value: {
                      Starter: true,
                      croissance: true,
                      performance: true,
                      ultimate: true,
                    },
                  },
                  {
                    label: "Growth Marketing : popup capture de données",
                    value: {
                      Starter: true,
                      croissance: true,
                      performance: true,
                      ultimate: true,
                    },
                  },
                  {
                    label: "Connection avis Google en temps réel",
                    value: {
                      Starter: true,
                      croissance: true,
                      performance: true,
                      ultimate: true,
                    },
                  },
                  {
                    label: "Growth Marketing : exit overlay",
                    value: {
                      Starter: false,
                      croissance: true,
                      performance: true,
                      ultimate: true,
                    },
                  },
                  {
                    label: "Optimisation Fiche Google My Business",
                    value: {
                      Starter: false,
                      croissance: false,
                      performance: true,
                      ultimate: true,
                    },
                  },
                  {
                    label: "Social Wall",
                    value: {
                      Starter: false,
                      croissance: false,
                      performance: true,
                      ultimate: true,
                    },
                  },
                ],
              },
            ],
          },
        ]}
