---
import Layout from "@layouts/Layout.astro";
import { Button, Icon, Card } from "@udixio/ui-react";

import Compare from "@/components/Compare";
import { Image } from "astro:assets";
import astronautRidingRocket from "@assets/images/astronaut-ride-a-rocket.webp";
import astronautAnalyzingData from "@assets/images/astronaut-analyzing-data.png";
import { iPhoneInTalk } from "@udixio/icons-rounded-400/phone_in_talk";

import { iCheckCircle } from "@udixio/icons-rounded-400/check_circle";
import { iRocketLaunch } from "@udixio/icons-rounded-400/rocket_launch";
import { iFormatQuote } from "@udixio/icons-rounded-400/format_quote";
import { iPerson } from "@udixio/icons-rounded-400/person";
import { iMoneyBag } from "@udixio/icons-rounded-400/money_bag";
import { iTvDisplays } from "@udixio/icons-rounded-400/tv_displays";
import { iAttachMoney } from "@udixio/icons-rounded-400/attach_money";
import { iWarning } from "@udixio/icons-rounded-400/warning";
import { iSearch } from "@udixio/icons-rounded-400/search";
import { iHandshake } from "@udixio/icons-rounded-400/handshake";
---

<Layout
  menu={true}
  seo={{
    noindex: true,
    title: "Création de site internet • Udixio",
    description:
      "Page en cours de mise à jour. Retrouvez l'ensemble de nos services et notre méthode.",
  }}
>
  <section class="max-width min-h-[80vh] flex items-center">
    <div class="padding xl:pr-0">
      <div class="flex gap-6 mt-8">
        <img
          loading="lazy"
          class="size-24"
          alt="Logo de Udixio"
          src="/favicon.svg"
        />
        <div>
          <p class="text-display-medium">UDIXIO</p>
          <p class="text-title-small">Votre levier digital</p>
        </div>
      </div>
      <h1 class="text-display-medium xl:text-display-large my-12 max-w-5xl">
        DÉPLOYEZ UNE MACHINE DE CROISSANCE POUR VOTRE ENTREPRISE
      </h1>
      <p class="text-body-large mt-8 max-w-prose">
        Développer une entreprise est difficile... Obtenir plus de marge, de
        demandes récurrentes et qualifiées chaque mois l’est encore plus.
      </p>
      <p class="text-body-large mt-8 max-w-prose">
        Nous rendons cela beaucoup plus simple, plus prévisible et moins
        stressant grâce à un système qui fonctionne 24 heures sur 24 et 7 jours
        sur 7 pour booster votre chiffre d’affaires.
      </p>

      <p
        class="flex gap-3 items-center mt-8 max-w-prose text-warning text-body-medium ml-1"
      >
        <Icon className="size-5" icon={iWarning} />
        Service soumis à éligibilité et validation.
      </p>

      <Button className="w-fit mt-8" client:load href="#contact"
        >Demander un devis gratuit</Button
      >
    </div>
    <Image
      loading="eager"
      class="absolute hidden xl:block animate-float right-0 bottom-0 translate-x-1/3 translate-y-16 scale-125"
      width={600}
      src={astronautRidingRocket}
      alt=""
    />
  </section>

  <section
    class="section grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8"
  >
    <Card className={"md:col-span-2 flex flex-wrap justify-center"}>
      <div class="p-12 flex-1">
        <div
          class="p-6 aspect-square flex items-center justify-center rounded-2xl bg-secondary-container w-fit"
        >
          <Icon
            className="size-10 text-on-secondary-container"
            icon={iPhoneInTalk}
          />
        </div>
        <p class="text-headline-small mt-8">
          Imaginez être en <span class="text-gradient text-headline-medium"
            >top position</span
          >
          sur <span class="text-gradient text-headline-medium">Google</span> recevez
          des
          <span class="text-gradient text-headline-medium">demandes</span> en continu
        </p>
      </div>
      <Image
        class="self-end md:pr-12"
        height={300}
        src={astronautAnalyzingData}
        alt=""
      />
    </Card>
    <Card className={"p-12 col-span-1 theme-warning"}>
      <div
        class="p-6 aspect-square flex items-center justify-center rounded-2xl bg-secondary-container w-fit"
      >
        <Icon className="size-10 text-on-secondary-container" icon={iWarning} />
      </div>
      <p class="text-headline-small mt-8">
        <span class="text-gradient text-headline-medium mb-1">
          Sous réserve de votre éligibilité</span
        >
      </p>
      <p class="text-body-large mt-2">
        Des documents de vérifications sont nécessaires pour ce service.
      </p>
    </Card>
    <Card className={"p-12 col-span-1  theme-success"}>
      <div
        class="p-6 aspect-square flex items-center justify-center rounded-2xl bg-secondary-container w-fit"
      >
        <Icon
          className="size-10 text-on-secondary-container"
          icon={iCheckCircle}
        />
      </div>
      <p class="text-headline-small mt-8">
        <span class="text-gradient text-headline-medium">Améliorez</span>
        votre
        <span class="text-gradient text-headline-medium">notoriété</span>
      </p>
      <p class="text-body-large mt-2">
        Plus de visibilité, plus d’opportunités.
      </p>
    </Card>
    <Card className={"p-12 col-span-1  "}>
      <div
        class="p-6 aspect-square flex items-center justify-center rounded-2xl bg-secondary-container w-fit"
      >
        <Icon
          className="size-10 text-on-secondary-container"
          icon={iRocketLaunch}
        />
      </div>
      <p class="text-headline-small mt-8">
        <span class="text-gradient text-headline-medium">100% clé en main</span>
      </p>
      <p class="text-body-large mt-2">
        Dominez votre secteur en croissancepulsant votre visibilité digitale
        dans une zone stratégique définie.
      </p>
    </Card>
    <Card
      className={"p-12 col-span-1 overflow-visible flex flex-col justify-between"}
    >
      <Icon
        className="absolute text-display-medium right-0 top-0 -translate-y-1/3 translate-x-1/3 size-18"
        icon={iFormatQuote}
      />
      <p class="text-headline-small">
        <span class="text-headline-large mb-1 block"
          >“J’ai eu 48 demandes le mois dernier”</span
        >
      </p>
      <div class="w-fit ml-auto flex gap-4">
        <div class="text-body-large text-right">
          <p>Laurent</p>
          <p>Avocat dans le 64</p>
        </div>
        <div
          class="p-2 aspect-square flex items-center justify-center rounded-2xl bg-secondary-container w-fit"
        >
          <Icon
            className="size-10 text-on-secondary-container"
            icon={iPerson}
          />
        </div>
      </div>
    </Card>
  </section>

  <section class="section">
    <h2 class="text-display-medium text-center max-w-3xl mx-auto my-16">
      Pourquoi est-il important d’avoir un site internet ?
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      <Card className={"xl:p-12 p-6 flex-1"}>
        <div class="flex gap-4 items-center">
          <Icon className="size-10 " icon={iSearch} />
          <h3 class="text-headline-medium">Visibilité</h3>
        </div>
        <p class="text-body-large text-on-surface-variant mt-8">
          Exister sur internet pour <span class="text-on-surface"
            >être trouvé à tout instant</span
          > quand quelqu’un a besoin de vos services.
        </p>
        <p class="text-body-large mt-4">
          97% des consommateurs utilisent internet pour trouver un professionnel
        </p>
      </Card>
      <Card className={"xl:p-12 p-6 flex-1"}>
        <div class="flex gap-4 items-center">
          <Icon className="size-10 " icon={iPerson} />
          <h3 class="text-headline-medium">Crédibilité</h3>
        </div>
        <p class="text-body-large text-on-surface-variant mt-8">
          Votre vitrine témoigne de votre sérieux. Avoir un <span
            class="text-on-surface">site optimisé, beau</span
          > et <span class="text-on-surface">adapté sur mobile</span>
          vous permet de ne pas faire peur aux visiteurs.
        </p>
        <p class="text-body-large mt-4">
          75% des consommateurs jugent la crédibilité d’une entreprise sur le
          design de son site web
        </p>
      </Card>
      <Card className={"xl:p-12 p-6  flex-1"}>
        <div class="flex gap-4 items-center">
          <Icon className="size-10 " icon={iMoneyBag} />
          <h3 class="text-headline-medium">Vente 24/7</h3>
        </div>
        <p class="text-body-large text-on-surface-variant mt-8">
          Votre site ne dors pas, ne prend pas de congés et travaille
          <span class="text-on-surface">24h/24 7j/7</span>.<br />
          Il génère des appels et des demandes de devis.
        </p>
        <p class="text-body-large mt-4">
          81 % des dirigeants considèrent le numérique comme un bénéfice réel
          pour leur entreprise.
        </p>
      </Card>
    </div>
  </section>
  <section class="section grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 mt-16">
    <Card className="p-12">
      <div class="flex gap-6">
        <img
          loading="lazy"
          class="size-24"
          alt="Logo de Udixio"
          src="/favicon.svg"
        />
        <div>
          <p class="text-display-medium">UDIXIO</p>
          <p class="text-title-small">Votre levier digital</p>
        </div>
      </div>

      <h2 class="my-12 text-headline-large">
        PLUS DE VISIBILITÉ, PLUS DE CLIENTS
      </h2>
      <p class="mt-8 text-body-large">Pourquoi nous faire confiance</p>
      <p class="mt-8 text-body-large">
        Nous comprenons vos problématiques et les transformons en opportunité.
      </p>
      <p class="mt-8">Vous en avez assez d’être invisible ?</p>
      <p class="mt-8">
        Désactivons le mode fantôme et faisons connaître vos services partout
        autour de vous
      </p>
    </Card>
    <div class="flex flex-col gap-6 lg:gap-8">
      <Card
        className="p-6 md:p-12 flex gap-6 md:gap-12 items-start md:items-center"
      >
        <div
          class="p-6 aspect-square flex items-center justify-center bg-secondary-container w-fit rounded-full"
        >
          <Icon
            className="size-10 md:size-16 text-on-secondary-container"
            icon={iTvDisplays}
          />
        </div>
        <div>
          <h3 class="text-headline-medium">WEB HAUT DE GAMME</h3>
          <p class="text-body-large text-on-surface-variant mt-4">
            Création de <span class="text-on-surface"
              >vitrine web professionnelle</span
            > qui <span class="text-on-surface"
              >met en valeur votre expertise</span
            >
          </p>
        </div>
      </Card>
      <Card
        className="p-6 md:p-12 flex gap-6 md:gap-12 items-start md:items-center"
      >
        <div
          class="p-6 aspect-square flex items-center justify-center bg-secondary-container w-fit rounded-full"
        >
          <Icon
            className="size-10 md:size-16 text-on-secondary-container"
            icon={iAttachMoney}
          />
        </div>
        <div>
          <h3 class="text-headline-medium">RENTABILITÉ</h3>
          <p class="text-body-large text-on-surface-variant mt-4">
            Votre solution fonctionne sans relâche, <span
              class="text-on-surface"
              >24h/24, 7j/7, attirant un flux d’appels et de prospects</span
            >
          </p>
        </div>
      </Card>
      <Card
        className="p-6 md:p-12 flex gap-6 md:gap-12 items-start md:items-center"
      >
        <div
          class="p-6 aspect-square flex items-center justify-center bg-secondary-container w-fit rounded-full"
        >
          <Icon
            className="size-10 md:size-16 text-on-secondary-container"
            icon={iHandshake}
          />
        </div>
        <div>
          <h3 class="text-headline-medium">ECOUTE ET PROXIMITÉ</h3>
          <p class="text-body-large text-on-surface-variant mt-4">
            Bénéficiez d’une proximité d'écoute et de <span
              class="text-on-surface">solutions adaptées à vos besoins</span
            >.
          </p>
        </div>
      </Card>
    </div>
  </section>
  <section class="section">
    <h2 class="text-display-medium text-center my-16">
      Comparez nos offres <span class="text-on-surface-variant">(24 mois)</span>
    </h2>
    <div class="mt-8">
      <Compare
        client:load
        groups={[
          {
            id: "site",
            label: "Sites vitrines",
            plans: [
              {
                id: "Starter",
                name: "Starter",
                price: {
                  setup: 750,
                  monthly: 169,
                },
                badge: "Populaire",
              },
              {
                id: "croissance",
                name: "Croissance",
                price: {
                  setup: 1500,
                  monthly: 189,
                },
              },
              {
                id: "performance",
                name: "Performance",
                price: {
                  setup: 2500,
                  monthly: 244,
                },
              },
              {
                id: "ultimate",
                name: "Ultimate",
                price: {
                  setup: 3700,
                  monthly: 298,
                },
              },
            ],
            categories: [
              {
                id: "design",
                label: "Design & contenu",
                features: [
                  {
                    label: "Design personnalisé dynamique",
                    value: {
                      Starter: true,
                      croissance: true,
                      performance: true,
                      ultimate: true,
                    },
                  },
                  {
                    label: "Responsive design : PC, Tablette & Smartphone",
                    value: {
                      Starter: true,
                      croissance: true,
                      performance: true,
                      ultimate: true,
                    },
                  },
                  {
                    label: "Nombre de pages avec rédaction de contenu",
                    value: {
                      Starter: "One Page Performance",
                      croissance: "Jusqu’à 10 pages",
                      performance: "Jusqu’à 15 pages",
                      ultimate: "Sur Mesure",
                    },
                  },
                  {
                    label: "Nom de domaine privé et email professionnel",
                    value: {
                      Starter: true,
                      croissance: true,
                      performance: true,
                      ultimate: true,
                    },
                  },
                  {
                    label: "Protocoles de sécurité avancés ",
                    value: {
                      Starter:
                        "SSL / Protection contre les attaques / Sauvegardes régulières",
                      croissance:
                        "SSL / Protection contre les attaques / Sauvegardes régulières",
                      performance:
                        "SSL / Protection contre les attaques / Sauvegardes régulières",
                      ultimate:
                        "SSL / Protection contre les attaques / Sauvegardes régulières",
                    },
                  },
                  {
                    label:
                      "Branding publicitaire unique : Logo, Carte de visite\n" +
                      "digitale, fond d’écran de téléphone, QR codes",
                    value: {
                      Starter: true,
                      croissance: true,
                      performance: true,
                      ultimate: true,
                    },
                  },
                ],
              },
              {
                id: "seo",
                label: "Référencement et visibilité",
                features: [
                  {
                    label: "Conformité technique SEO, stratégie & optimisation",
                    value: {
                      Starter: true,
                      croissance: true,
                      performance: "Expert SEO ",
                      ultimate: "Expert SEO",
                    },
                  },
                  {
                    label: "Nombre de mots clés SEO",
                    value: {
                      Starter: "10 mots clés",
                      croissance: "15 mots clés",
                      performance: "30 mots clés",
                      ultimate: "Plus de 40 mots clés",
                    },
                  },
                  {
                    label: "Localité(s) référencée(s)",
                    value: {
                      Starter: "1 Localité",
                      croissance: "10 Localités",
                      performance: "30 Localités",
                      ultimate: "40 Localités",
                    },
                  },
                  {
                    label: "Paramétrage & Setup des annonces Google Ads",
                    value: {
                      Starter: true,
                      croissance: true,
                      performance: true,
                      ultimate: true,
                    },
                  },
                  {
                    label: "Optimisation google my business",
                    note: "budget Ads non inclus",
                    value: {
                      Starter: false,
                      croissance: "Bonus : 2 mois de gestion",
                      performance: "Bonus : 4 mois de gestion",
                      ultimate: "Bonus : 6 mois de gestion",
                    },
                  },
                  {
                    label: "Page d’acquisition de prospect SEA",
                    value: {
                      Starter: false,
                      croissance: false,
                      performance: true,
                      ultimate: true,
                    },
                  },
                ],
              },
              {
                id: "accompagnement",
                label: "Accompagnement",
                features: [
                  {
                    label: "Intervenant création",
                    value: {
                      Starter: "Webmaster dédié",
                      croissance: "Webmaster dédié",
                      performance: "Webmaster dédié + Expert SEO",
                      ultimate: "Webmaster dédié + Expert SEO",
                    },
                  },
                  {
                    label: "Suivi post livraison",
                    value: {
                      Starter: "Support + 1 bilan /an",
                      croissance: "Support + 2 bilan /an",
