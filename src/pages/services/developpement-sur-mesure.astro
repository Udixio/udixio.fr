---
import Layout from "@layouts/Layout.astro";
import { Button, Icon } from "@udixio/ui-react";
import { Card } from "@/components/Card";
import { Hero } from "@components/Hero";
import { SectionPadding } from "@components/SectionPadding";
import FaqSection from "@components/sections/FaqSection.astro";
import CtaSection from "@components/sections/CtaSection.astro";
import { iCheckCircleFilled } from "@udixio/icons-rounded-400/filled/check_circle";
import { iTune } from "@udixio/icons-rounded-400/tune";
import { iKey } from "@udixio/icons-rounded-400/key";
import { iVerifiedUser } from "@udixio/icons-rounded-400/verified_user";
import { iChecklist } from "@udixio/icons-rounded-400/checklist";
import { iBolt } from "@udixio/icons-rounded-400/bolt";
import { iPartnerExchange } from "@udixio/icons-rounded-400/partner_exchange";

const faqItems = [
  {
    question: "Quand choisir du sur-mesure ?",
    answer:
      "Quand vos besoins dépassent les limites d'un site standard : outils internes, parcours complexes, automatisations, intégrations spécifiques.",
  },
  {
    question: "Comment démarre un projet sur-mesure ?",
    answer:
      "Par un cadrage précis pour prioriser un périmètre maîtrisé. Nous définissons d'abord un noyau utile et livrable.",
  },
  {
    question: "Puis-je faire évoluer l'outil ensuite ?",
    answer:
      "Oui. Le sur-mesure est pensé pour évoluer par étapes, selon vos priorités.",
  },
  {
    question: "Qui possède le code et les accès ?",
    answer: "Le client. Les livrables et les accès sont remis à la livraison.",
  },
];
---

<Layout
  seo={{
    title: "Développement web sur‑mesure • Udixio",
    description:
      "Fonctionnalités et outils métiers sur‑mesure, cadrés pour rester maîtrisables.",
  }}
  background={false}
>
  <Hero client:load>
    <div class="flex-1 flex flex-col justify-between gap-12">
      <div>
        <span class="sub-title">Sur-mesure</span>
        <h1
          class="max-w-2xl text-display-medium text-on-surface-variant anim-fade anim-slide-from-left anim-duration-1000 ease-out anim-delay-100"
        >
          Développement web <span class="text-gradient">sur‑mesure</span>
        </h1>
      </div>
      <div>
        <p
          class="text-body-large max-w-96 mb-12 anim-fade anim-slide-from-left anim-duration-1000 ease-out anim-delay-200"
        >
          Quand un site standard ne suffit pas, nous construisons un outil
          adapté, sans opacité.
        </p>
        <div class="flex flex-wrap gap-4">
          <Button href="/contact" shape="squared" label="Demander un diagnostic" />
          <Button href="/methode" label="Notre méthode" variant="outlined" />
        </div>
      </div>
    </div>
  </Hero>

  {/* PROBLÈME + APPROCHE */}
  <SectionPadding client:visible start end as="section">
    <div class="py-32 bg-surface-container-low">
      <div class="section">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-24">
          <div class="md:col-span-4 relative">
            <div class="sticky top-32">
              <span class="sub-title">Le problème</span>
              <h2 class="text-headline-large leading-tight">
                Des outils <span class="text-gradient">inadaptés</span> qui
                freinent vos équipes
              </h2>
              <p class="mt-6 text-body-large text-on-surface-variant">
                Process métiers mal outillés, données dispersées, automatisations
                inexistantes. Nous cadrons un périmètre utile et livrable, puis
                on itère.
              </p>
            </div>
          </div>

          <div class="md:col-span-8 space-y-8">
            <span class="sub-title">Notre approche</span>
            {
              [
                {
                  number: 1,
                  title: "Cadrage précis & priorisation",
                  description:
                    "On identifie le problème réel, on priorise les fonctionnalités indispensables et on définit un périmètre maîtrisable.",
                },
                {
                  number: 2,
                  title: "Conception orientée usage",
                  description:
                    "Architecture et interface pensées pour vos utilisateurs réels. Maquettes validées avant développement.",
                },
                {
                  number: 3,
                  title: "Développement par étapes",
                  description:
                    "Livraisons progressives et testables. Vous voyez l'avancement et pouvez valider à chaque étape.",
                },
                {
                  number: 4,
                  title: "Tests & livraison",
                  description:
                    "Tests fonctionnels complets avant mise en production. Documentation et passation incluses.",
                },
              ].map((step) => (
                <div class="group relative pl-8 border-l-2 border-outline-variant transition-colors duration-500 anim-fade-up delay-200">
                  <span class="text-title-medium absolute -left-[1.35rem] top-0 flex h-10 w-10 items-center justify-center rounded-full bg-surface border-2 border-outline-variant transition-all">
                    {step.number}
                  </span>
                  <h3 class="text-headline-small mb-4 text-on-surface">
                    {step.title}
                  </h3>
                  <p class="text-body-large text-on-surface-variant font-light max-w-lg pb-16">
                    {step.description}
                  </p>
                </div>
              ))
            }

            <Button
              href="/methode"
              label="Voir la méthode complète"
              variant="outlined"
              className="w-fit"
            />
          </div>
        </div>
      </div>
    </div>
  </SectionPadding>

  {/* BÉNÉFICES */}
  <section class="py-24 bg-surface">
      <div class="section">
        <div class="max-w-4xl mb-12">
          <span class="sub-title">Bénéfices</span>
          <h2 class="text-headline-large">
            Un outil taillé pour vous.<br />
            <span class="text-gradient">Évolutif par nature.</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            [
              {
                icon: iTune,
                title: "Adapté à vos process",
                description:
                  "Chaque fonctionnalité répond à un besoin réel de vos équipes, pas à un template préfabriqué.",
              },
              {
                icon: iBolt,
                title: "Livraisons progressives",
                description:
                  "On livre par étapes pour que vous puissiez valider et utiliser rapidement, sans attendre la version finale.",
              },
              {
                icon: iVerifiedUser,
                title: "Décisions expliquées",
                description:
                  "Chaque choix technique est expliqué avec un impact concret. Rien n'est imposé sans échange.",
              },
              {
                icon: iKey,
                title: "Vous gardez la main",
                description:
                  "Code source, accès et documentation vous appartiennent. Aucune dépendance à notre infrastructure.",
              },
              {
                icon: iPartnerExchange,
                title: "Sans intermédiaire",
                description:
                  "Vous travaillez directement avec les développeurs. Les décisions sont prises plus vite.",
              },
              {
                icon: iChecklist,
                title: "Évolutif sans verrou",
                description:
                  "Architecture pensée pour grandir avec vos besoins, par étapes et sans repartir de zéro.",
              },
            ].map((benefit) => (
              <Card variant="outlined" className="group p-6">
                <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-6">
                  <Icon icon={benefit.icon} className="w-6 h-6 fill-current" />
                </div>
                <h3 class="text-headline-small mb-2">{benefit.title}</h3>
                <p class="text-on-surface-variant">{benefit.description}</p>
              </Card>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {/* INVESTISSEMENT */}
  <section class="py-24 bg-surface-container-low">
      <div class="section">
        <div class="bg-surface-container p-8 md:p-12 rounded-4xl">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div>
              <span class="sub-title">Investissement</span>
              <h2
                class="text-headline-medium md:text-headline-large text-on-surface mb-6"
              >
                Un périmètre défini, un budget maîtrisé.
              </h2>
              <p class="text-title-medium text-on-surface-variant mb-8">
                Le budget dépend du périmètre, des intégrations et des
                contraintes métier. On commence par un cadrage pour définir un
                noyau clair, puis on planifie les évolutions.
              </p>
              <Button
                href="/contact"
                label="Demander une estimation"
                variant="outlined"
                className="w-fit"
              />
            </div>

            <div
              class="bg-surface rounded-2xl p-6 border border-outline-variant/30 font-mono text-body-medium"
            >
              <div class="space-y-4">
                <div class="flex justify-between items-center">
                  <span class="text-on-surface">Application / e-commerce</span>
                  <span
                    class="bg-tertiary-container text-on-tertiary-container px-2 py-1 rounded text-label-small whitespace-nowrap"
                    >À partir de 5 000€</span
                  >
                </div>
                <p
                  class="text-body-small text-on-surface-variant pb-4 border-b border-outline-variant/30"
                >
                  Plateforme métier, espace client ou tunnel d'achat sur-mesure.
                </p>
                <div class="flex justify-between items-center">
                  <span class="text-on-surface">Évolutions & itérations</span>
                  <span
                    class="bg-surface-container text-on-surface-variant px-2 py-1 rounded text-label-small whitespace-nowrap border border-outline-variant/40"
                    >Sur devis</span
                  >
                </div>
                <p class="text-body-small text-on-surface-variant">
                  Nouvelles fonctionnalités et améliorations planifiées selon
                  vos priorités.
                </p>
              </div>
              <div
                class="mt-6 pt-4 border-t border-outline-variant/30 flex justify-between items-center"
              >
                <span class="text-on-surface-variant text-body-medium"
                  >Frais cachés</span
                >
                <span class="text-headline-small text-primary">0€</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FaqSection
    title="Questions fréquentes"
    description="Voici des réponses concrètes sur le développement sur-mesure."
    items={faqItems}
  />

  <CtaSection
    title="Un besoin spécifique ? On en discute."
    description="Décrivez-nous votre besoin, on vous répond rapidement avec un premier retour concret."
    primaryLabel="Demander un diagnostic"
    primaryHref="/contact"
    secondaryLabel="Voir nos réalisations"
    secondaryHref="/realisations"
  />
</Layout>
