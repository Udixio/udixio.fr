---
import Layout from "@layouts/Layout.astro";
import { Button, Icon } from "@udixio/ui-react";
import { Card } from "@/components/Card";
import { Hero } from "@components/Hero";
import { SectionPadding } from "@components/SectionPadding";
import FaqSection from "@components/sections/FaqSection.astro";
import CtaSection from "@components/sections/CtaSection.astro";
import { iCheckCircleFilled } from "@udixio/icons-rounded-400/filled/check_circle";
import { iVisibility } from "@udixio/icons-rounded-400/visibility";
import { iHandshake } from "@udixio/icons-rounded-400/handshake";
import { iTrendingUp } from "@udixio/icons-rounded-400/trending_up";
import { iChecklist } from "@udixio/icons-rounded-400/checklist";
import { iKey } from "@udixio/icons-rounded-400/key";
import { iVerifiedUser } from "@udixio/icons-rounded-400/verified_user";
import { iStorefront } from "@udixio/icons-rounded-400/storefront";
import { iGroups } from "@udixio/icons-rounded-400/groups";
import { iRocketLaunch } from "@udixio/icons-rounded-400/rocket_launch";

const faqItems = [
  {
    question: "Que comprend la prestation ?",
    answer:
      "Cadrage, architecture de pages, design, intégration, développement, tests et mise en ligne. Le périmètre exact est défini ensemble.",
  },
  {
    question: "Fournissez-vous les contenus ?",
    answer:
      "Vous pouvez nous fournir vos contenus. Si besoin, nous vous aidons à les structurer et à les clarifier.",
  },
  {
    question: "Le site m'appartient-il ?",
    answer: "Oui. Les livrables et les accès sont remis au client.",
  },
  {
    question: "Quid du suivi après mise en ligne ?",
    answer: "Un suivi est possible en option, selon vos besoins.",
  },
  {
    question: "Quel est le délai moyen de livraison ?",
    answer:
      "En général, 4 à 8 semaines pour un site vitrine selon le périmètre. Un planning détaillé est fourni dès le cadrage.",
  },
  {
    question: "Quelle garantie après la mise en ligne ?",
    answer:
      "Une période de corrections est incluse après la mise en ligne pour traiter les ajustements identifiés. Les conditions exactes sont précisées dans le devis.",
  },
];
---

<Layout
  seo={{
    title: "Création & refonte de site web • Udixio",
    description:
      "Une offre claire pour un site vitrine ou une refonte maîtrisée : cadrage, design, développement, mise en ligne.",
  }}
  background={false}
>
  <Hero client:load>
    <div class="flex-1 flex flex-col justify-between gap-12">
      <div>
        <span class="sub-title">Site web</span>
        <h1
          class="max-w-2xl text-display-medium text-on-surface-variant anim-fade anim-slide-from-left anim-duration-1000 ease-out anim-delay-100"
        >
          Création & refonte de <span class="text-gradient">site web</span>
        </h1>
      </div>
      <div>
        <p
          class="text-body-large max-w-96 mb-12 anim-fade anim-slide-from-left anim-duration-1000 ease-out anim-delay-200"
        >
          Un site clair, crédible et simple à faire évoluer, avec un cadre sans
          flou.
        </p>
        <div class="flex flex-wrap gap-4">
          <Button href="/contact" shape="squared" label="Demander un diagnostic" />
          <Button href="/methode" label="Notre méthode" variant="outlined" />
        </div>
      </div>
    </div>
  </Hero>

  {/* PROBLÈME + APPROCHE */}
  <SectionPadding client:visible start end as="section">
    <div class="py-32 bg-surface-container-low">
      <div class="section">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-24">
          <div class="md:col-span-4 relative">
            <div class="sticky top-32">
              <span class="sub-title">Le problème</span>
              <h2 class="text-headline-large leading-tight">
                Des sites qui <span class="text-gradient">nuisent</span> à votre
                crédibilité
              </h2>
              <p class="mt-6 text-body-large text-on-surface-variant">
                Site confus, messages flous, structure vieillissante. Notre
                objectif : remettre de l'ordre et construire une base durable.
              </p>
            </div>
          </div>

          <div class="md:col-span-8 space-y-8">
            <span class="sub-title">Notre approche</span>
            {
              [
                {
                  number: 1,
                  title: "Cadrage & objectifs",
                  description:
                    "Périmètre écrit et validé avant toute production. Vous savez exactement ce qui est inclus, ce qui ne l'est pas, et pourquoi.",
                },
                {
                  number: 2,
                  title: "Design & développement",
                  description:
                    "Maquettes validées avant développement. Code testé, performant (Lighthouse 100/100) et accessible.",
                },
                {
                  number: 3,
                  title: "Livraison & passation",
                  description:
                    "Mise en ligne maîtrisée. Dépôt Git, accès admin, hébergement documenté — tout vous est remis.",
                },
              ].map((step) => (
                <div class="group relative pl-8 border-l-2 border-outline-variant transition-colors duration-500 anim-fade-up delay-200">
                  <span class="text-title-medium absolute -left-[1.35rem] top-0 flex h-10 w-10 items-center justify-center rounded-full bg-surface border-2 border-outline-variant transition-all">
                    {step.number}
                  </span>
                  <h3 class="text-headline-small mb-4 text-on-surface">
                    {step.title}
                  </h3>
                  <p class="text-body-large text-on-surface-variant font-light max-w-lg pb-16">
                    {step.description}
                  </p>
                </div>
              ))
            }

            <Button
              href="/methode"
              label="Voir la méthode complète"
              variant="outlined"
              className="w-fit"
            />
          </div>
        </div>
      </div>
    </div>
  </SectionPadding>

  {/* BÉNÉFICES */}
  <section class="py-24 bg-surface">
      <div class="section">
        <div class="max-w-4xl mb-12">
          <span class="sub-title">Ce que vous obtenez</span>
          <h2 class="text-headline-large">
            Des résultats mesurables.<br />
            <span class="text-gradient">Pas des promesses.</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            [
              {
                icon: iVisibility,
                title: "Design aligné avec votre identité",
                description:
                  "Interface conçue à partir de votre image — pas un template générique. Vos prospects vous identifient immédiatement.",
              },
              {
                icon: iTrendingUp,
                title: "Architecture SEO + pages qui convertissent",
                description:
                  "Structure de pages pensée pour le référencement et le parcours utilisateur — pour transformer vos visiteurs en contacts.",
              },
              {
                icon: iHandshake,
                title: "Développement testé, Lighthouse 100/100",
                description:
                  "Code performant, accessible, optimisé. Des scores vérifiables sur chaque livraison.",
              },
              {
                icon: iKey,
                title: "Git, hébergement et CMS : tout vous appartient",
                description:
                  "Dépôt Git, accès admin et hébergement documentés — remis à la livraison, sans condition.",
              },
              {
                icon: iVerifiedUser,
                title: "Base évolutive, sans repartir de zéro",
                description:
                  "Architecture modulaire documentée. Un autre prestataire peut reprendre sans difficulté.",
              },
              {
                icon: iChecklist,
                title: "Périmètre écrit avant tout démarrage",
                description:
                  "Un document de cadrage précise ce qui est inclus, les délais et le budget. Rien n'avance sans votre accord.",
              },
            ].map((benefit) => (
              <Card variant="outlined" className="group p-6">
                <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-6">
                  <Icon icon={benefit.icon} className="w-6 h-6 fill-current" />
                </div>
                <h3 class="text-headline-small mb-2">{benefit.title}</h3>
                <p class="text-on-surface-variant">{benefit.description}</p>
              </Card>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {/* CAS D'USAGE */}
  <section class="py-24 bg-surface-container-low">
    <div class="section text-center">
      <span class="sub-title anim-in anim-fade">Cas d'usage</span>
      <h2 class="text-headline-large text-on-surface mb-4 anim-in anim-fade anim-delay-150">
        Ce service est fait pour vous si…
      </h2>
      <p class="text-title-medium text-on-surface-variant max-w-2xl mx-auto mb-12 anim-in anim-fade anim-delay-300">
        Que vous partiez de zéro ou d'un site existant à remettre à niveau, nous
        cadrons une solution adaptée à votre réalité.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          [
            {
              icon: iStorefront,
              title: "Votre site existe mais ne génère aucun contact",
              description:
                "Vos concurrents captent les leads à votre place. On restructure le parcours et le SEO pour que votre site travaille pour vous.",
              containerClass: "bg-tertiary-container",
              iconClass: "fill-on-tertiary-container",
            },
            {
              icon: iGroups,
              title: "Votre design est daté, il ne reflète plus votre niveau",
              description:
                "Vous perdez en crédibilité avant même le premier échange. On repart de votre identité pour une interface qui inspire confiance.",
              containerClass: "bg-primary-container",
              iconClass: "fill-on-primary-container",
            },
            {
              icon: iRocketLaunch,
              title: "Vous lancez votre activité et avez besoin d'une base solide",
              description:
                "Un mauvais départ est coûteux à corriger. On cadre le minimum viable qui vous ouvre le marché, sans sur-investir.",
              containerClass: "bg-secondary-container",
              iconClass: "fill-on-secondary-container",
            },
          ].map((cas, index) => (
            <div
              class="bg-surface-container rounded-3xl border border-outline-variant/40 p-8 flex flex-col items-center gap-5 text-center anim-in anim-fade anim-slide-from-bottom"
              style={{ ["--anim-delay"]: `${index * 150}ms` }}
            >
              <div
                class={`w-16 h-16 rounded-full flex items-center justify-center ${cas.containerClass}`}
              >
                <Icon icon={cas.icon} className={`w-8 h-8 ${cas.iconClass}`} />
              </div>
              <div>
                <h3 class="text-headline-small mb-2">{cas.title}</h3>
                <p class="text-body-medium text-on-surface-variant">{cas.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* INVESTISSEMENT */}
  <section class="py-24 bg-surface-container-low">
      <div class="section">
        <div class="bg-surface-container p-8 md:p-12 rounded-4xl">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div>
              <span class="sub-title">Investissement</span>
              <h2
                class="text-headline-medium md:text-headline-large text-on-surface mb-6"
              >
                Des bases claires pour comprendre ce que vous payez.
              </h2>
              <p class="text-title-medium text-on-surface-variant mb-8">
                Le budget dépend du nombre de pages, du contenu, des
                intégrations et du niveau de personnalisation. Après un cadrage
                rapide, nous vous proposons une estimation claire.
              </p>
              <Button
                href="/contact"
                label="Demander une estimation"
                variant="outlined"
                className="w-fit"
              />
            </div>

            <div
              class="bg-surface rounded-2xl p-6 border border-outline-variant/30 font-mono text-body-medium"
            >
              <div class="space-y-4">
                <div class="flex justify-between items-center">
                  <span class="text-on-surface">Site vitrine performant</span>
                  <span
                    class="bg-tertiary-container text-on-tertiary-container px-2 py-1 rounded text-label-small whitespace-nowrap"
                    >Dès 2 500€</span
                  >
                </div>
                <p
                  class="text-body-small text-on-surface-variant pb-4 border-b border-outline-variant/30"
                >
                  Pour TPE/PME : audit, SEO technique, design sur-mesure et
                  formation inclus.
                </p>
                <div class="flex justify-between items-center">
                  <span class="text-on-surface">Refonte complète</span>
                  <span
                    class="bg-surface-container text-on-surface-variant px-2 py-1 rounded text-label-small whitespace-nowrap border border-outline-variant/40"
                    >À partir de 3 500€</span
                  >
                </div>
                <p class="text-body-small text-on-surface-variant">
                  Audit de l'existant, reprise du design et du contenu,
                  optimisation technique complète.
                </p>
              </div>
              <div
                class="mt-6 pt-4 border-t border-outline-variant/30 flex justify-between items-center"
              >
                <span class="text-on-surface-variant text-body-medium"
                  >Frais cachés</span
                >
                <span class="text-headline-small text-primary">0€</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FaqSection
    title="Questions fréquentes"
    description="Voici des réponses concrètes sur cette prestation."
    items={faqItems}
  />

  <CtaSection
    title="Vous voulez un site clair et maîtrisé ?"
    description="Décrivez-nous votre projet, on vous répond rapidement avec un premier retour concret."
    primaryLabel="Demander un diagnostic"
    primaryHref="/contact"
    secondaryLabel="Voir nos réalisations"
    secondaryHref="/realisations"
  />
</Layout>
