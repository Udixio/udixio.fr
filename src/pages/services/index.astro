---
import Layout from "@layouts/Layout.astro";
import { Button, Icon } from "@udixio/ui-react";
import { Card } from "@/components/Card";
import { Hero } from "@components/Hero";
import { SectionPadding } from "@components/SectionPadding";
import FaqSection from "@components/sections/FaqSection.astro";
import CtaSection from "@components/sections/CtaSection.astro";
import { iCheckCircleFilled } from "@udixio/icons-rounded-400/filled/check_circle";
import { iVisibility } from "@udixio/icons-rounded-400/visibility";
import { iKey } from "@udixio/icons-rounded-400/key";
import { iTune } from "@udixio/icons-rounded-400/tune";
import { iChecklist } from "@udixio/icons-rounded-400/checklist";
import { icon } from "@fortawesome/fontawesome-svg-core";
import { iShoppingCart } from "@udixio/icons-rounded-400/shopping_cart";

const faqItems = [
  {
    question: "Comment cadrer le périmètre avant de se lancer ?",
    answer:
      "Nous commençons par clarifier les objectifs, les contraintes et les priorités. Cela permet de définir un périmètre cohérent et d'éviter les zones floues. Nous vous partageons ensuite une estimation claire avec des options (périmètre minimal vs périmètre complet).",
  },
  {
    question: "Proposez-vous un suivi après mise en ligne ?",
    answer:
      "Oui, le suivi après mise en ligne est disponible en option, selon vos besoins.",
  },
  {
    question: "Les livrables m'appartiennent-ils ?",
    answer:
      "Oui. La propriété des livrables est clarifiée dès le départ, et fait partie de notre cadre de travail.",
  },
];
---

<Layout
  seo={{
    title: "Services web : clarté du cadrage, maîtrise du résultat • Udixio",
    description:
      "Un hub clair pour choisir la bonne prestation : site vitrine/refonte, développement sur‑mesure, cadrage & audit.",
  }}
  background={false}
>
  <Hero client:load>
    <div class="flex-1 flex flex-col justify-between gap-12">
      <div>
        <span class="sub-title">Nos services</span>
        <h1
          class="text-display-medium text-on-surface-variant anim-fade anim-slide-from-left anim-duration-1000 ease-out anim-delay-100"
        >
          Services web,<br />
          <span class="text-gradient">clairs et maîtrisés</span>
        </h1>
      </div>
      <div>
        <p
          class="text-body-large max-w-xl mb-12 anim-fade anim-slide-from-left anim-duration-1000 ease-out anim-delay-200"
        >
          Chaque service est cadré pour éviter les dérives et garder le
          contrôle. Nous faisons un diagnostic rapide et vous orientons vers la
          bonne option.
        </p>
        <Button
          href="/contact"
          label="Demander un diagnostic gratuit"
          shape="squared"
        />
      </div>
    </div>
  </Hero>

  {/* SERVICES GRID */}
  <section>
    <div class="section">
      <span class="sub-title">Nos prestations</span>
      <h2 class="text-headline-large mb-12">
        Choisir la bonne prestation <span class="text-gradient">sans flou</span>
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          [
            {
              icon: iVisibility,
              iconBg: "bg-primary/10",
              iconColor: "text-primary",
              title: "Site vitrine",
              description:
                "Présentez votre activité avec clarté et crédibilité.",
              features: [
                "Design moderne et responsive",
                "Optimisation SEO",
                "Performance et rapidité",
                "Formulaire de contact",
              ],
              buttons: [
                {
                  href: "/services/site-vitrine",
                  label: "Voir l'offre",
                },
              ],
              checkIconColor: "text-primary",
            },
            {
              icon: iShoppingCart,
              iconBg: "bg-secondary/10",
              iconColor: "text-secondary",
              title: "Site e-commerce",
              description: "Vendez en ligne simplement et efficacement.",
              features: [
                "Gestion produits et stocks",
                "Paiement sécurisé",
                "Parcours d'achat optimisé",
                "Suivi des commandes",
              ],
              buttons: [
                {
                  href: "/services/site-e-commerce",
                  label: "Voir l'offre",
                },
              ],
              checkIconColor: "text-secondary",
            },
            {
              icon: iTune,
              iconBg: "bg-tertiary/10",
              iconColor: "text-tertiary",
              title: "Développement sur-mesure",
              description: "Des fonctionnalités adaptées à vos besoins métier.",
              features: [
                "Fonctionnalités spécifiques",
                "Intégrations API tierces",
                "Back-office personnalisé",
                "Évolutivité garantie",
              ],
              buttons: [
                {
                  href: "/services/developpement-sur-mesure",
                  label: "Voir l'offre",
                },
              ],
              checkIconColor: "text-tertiary",
            },
          ].map((service) => (
            <Card className={"p-8 md:p-10 flex flex-col justify-between gap-6"}>
              <div>
                <div
                  class={`w-12 h-12 rounded-xl ${service.iconBg} ${service.iconColor} flex items-center justify-center`}
                >
                  <Icon icon={service.icon} className="w-6 h-6 fill-current" />
                </div>
                <h3 class="text-headline-small text-on-surface my-3">
                  {service.title}
                </h3>
                <p class="text-body-large text-on-surface-variant mb-6">
                  {service.description}
                </p>
              </div>
              <div>
                <ul class="space-y-2">
                  {service.features.map((item) => (
                    <li class="flex items-center gap-2 text-body-medium text-on-surface-variant">
                      <Icon
                        className={`size-5 ${service.checkIconColor} shrink-0`}
                        icon={iCheckCircleFilled}
                      />
                      {item}
                    </li>
                  ))}
                </ul>
                <div
                  class={`mt-8 ${service.buttons.length > 1 ? "flex flex-wrap gap-3" : ""}`}
                >
                  {service.buttons.map((button) => (
                    <Button
                      href={button.href}
                      label={button.label}
                      variant={"outlined"}
                    />
                  ))}
                </div>
              </div>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  {/* DANS TOUTES NOS MISSIONS */}
  <section class="py-24 bg-surface">
    <div class="section">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <span class="sub-title">Nos garanties</span>
          <h2 class="text-headline-large text-on-surface">
            Dans toutes nos missions
          </h2>
          <p class="text-title-medium text-on-surface-variant mt-6">
            Quel que soit le service choisi, vous bénéficiez du même cadre de
            travail clair et transparent.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <Button href="/methode" label="Voir notre méthode" />
            <Button
              href="/contact"
              label="Demander un diagnostic"
              variant="outlined"
            />
          </div>
        </div>

        <Card
          className="bg-secondary-container text-on-secondary-container p-8"
        >
          <div
            class="absolute top-4 right-4 bg-primary/10 text-primary px-3 py-1 rounded-full text-label-small uppercase"
          >
            Inclus
          </div>
          <ul class="space-y-4 mt-2">
            {
              [
                "Périmètre et objectifs clarifiés avant démarrage",
                "Points de validation réguliers",
                "Transparence sur les choix et arbitrages",
                "Propriété des livrables",
                "Documentation à la livraison",
              ].map((item) => (
                <li class="flex items-center gap-3">
                  <Icon
                    className="size-6 rounded-full text-secondary"
                    icon={iCheckCircleFilled}
                  />
                  <span class="text-title-medium">{item}</span>
                </li>
              ))
            }
          </ul>
        </Card>
      </div>
    </div>
  </section>
</Layout>

{/* INVESTISSEMENT */}
<section class="py-24 bg-surface-container-low">
  <div class="section">
    <div class="bg-surface-container p-8 md:p-12 rounded-4xl">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="sub-title">Investissement</span>
          <h2
            class="text-headline-medium md:text-headline-large text-on-surface mb-6"
          >
            Transparence sur les prix, dès le départ.
          </h2>
          <p class="text-title-medium text-on-surface-variant mb-8">
            Un prix dépend du périmètre, du contenu et des intégrations. Pas de
            frais de dossier, pas d'abonnement imposé.
          </p>
          <Button
            href="/contact"
            label="Demander une estimation"
            variant="outlined"
            className="w-fit"
          />
        </div>

        <div
          class="bg-surface rounded-2xl p-6 border border-outline-variant/30 font-mono text-body-medium"
        >
          <div class="space-y-4">
            <div class="flex justify-between items-center">
              <span class="text-on-surface">Site vitrine performant</span>
              <span
                class="bg-tertiary-container text-on-tertiary-container px-2 py-1 rounded text-label-small whitespace-nowrap"
                >Dès 2 500€</span
              >
            </div>
            <p
              class="text-body-small text-on-surface-variant pb-4 border-b border-outline-variant/30"
            >
              Pour TPE/PME : audit, SEO technique, design sur-mesure et
              formation inclus.
            </p>

            <div class="flex justify-between items-center">
              <span class="text-on-surface">Application / sur‑mesure</span>
              <span
                class="bg-surface-container text-on-surface-variant px-2 py-1 rounded text-label-small whitespace-nowrap border border-outline-variant/40"
                >À partir de 5 000€</span
              >
            </div>
            <p
              class="text-body-small text-on-surface-variant pb-4 border-b border-outline-variant/30"
            >
              Plateforme métier, espace client ou tunnel d'achat sur-mesure.
            </p>

            <div class="flex justify-between items-center">
              <span class="text-on-surface">Maintenance & évolutions</span>
              <span
                class="bg-surface-container text-on-surface-variant px-2 py-1 rounded text-label-small whitespace-nowrap border border-outline-variant/40"
                >Sur devis</span
              >
            </div>
            <p class="text-body-small text-on-surface-variant">
              Support, mises à jour et évolutions selon vos besoins.
            </p>
          </div>
          <div
            class="mt-6 pt-4 border-t border-outline-variant/30 flex justify-between items-center"
          >
            <span class="text-on-surface-variant text-body-medium"
              >Frais cachés</span
            >
            <span class="text-headline-small text-primary">0€</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<FaqSection
  title="Questions sur nos prestations"
  description="Voici des réponses concrètes avant d'aller plus loin."
  items={faqItems}
/>

<CtaSection
  title="Prêt à échanger sur votre projet ?"
  description="Décrivez-nous votre besoin, on vous répond rapidement avec un premier retour concret."
  primaryLabel="Demander un diagnostic"
  primaryHref="/contact"
  secondaryLabel="Voir nos réalisations"
  secondaryHref="/realisations"
/>
