---
import Layout from "@layouts/Layout.astro";
import {Button} from "@udixio/ui-react";
import ReassuranceBlocks from "@components/sections/ReassuranceBlocks.astro";
import Faq from "@components/sections/Faq.astro";

const faqItems = [
    {
        question: "Comment cadrer le périmètre avant de se lancer ?",
        answer: "Nous commençons par clarifier les objectifs, les contraintes et les priorités. Cela permet de définir un périmètre cohérent et d'éviter les zones floues. Nous vous partageons ensuite une estimation claire avec des options (périmètre minimal vs périmètre complet).",
    },
    {
        question: "Proposez-vous un suivi après mise en ligne ?",
        answer: "Oui, le suivi après mise en ligne est disponible en option, selon vos besoins.",
    },
    {
        question: "Les livrables m'appartiennent-ils ?",
        answer: "Oui. La propriété des livrables est clarifiée dès le départ, et fait partie de notre cadre de travail.",
    },
];
---

<Layout seo={{
    title: "Services web : clarté du cadrage, maîtrise du résultat • Udixio",
    description: "Un hub clair pour choisir la bonne prestation : site vitrine/refonte, développement sur‑mesure, cadrage & audit.",
}}>
    <section class="section">
        <div class="max-width padding-x">
            <h1 class="text-display-small md:text-display-large">Services web, clairs et maîtrisés</h1>
            <h2 class="text-headline-medium mt-8">Choisir la bonne prestation sans flou</h2>
            <div class="text-body-large mt-6 max-w-prose space-y-4">
                <p>Chaque service est cadré pour éviter les dérives et garder le contrôle.</p>
                <p>Vous ne savez pas par où commencer ? Nous faisons un diagnostic rapide et vous orientons vers la bonne option.</p>
            </div>
            <Button className="mt-8 w-fit" href="/contact" label="Demander un diagnostic gratuit" />
        </div>
    </section>

    <section class="section">
        <div class="max-width padding-x">
            <h2 class="text-display-small">Création &amp; refonte de sites web</h2>
            <div class="text-body-large mt-6 max-w-prose space-y-4">
                <p>Pour un site clair, crédible et simple à faire évoluer.</p>
            </div>
            <ul class="mt-6 list-disc pl-6 text-body-large max-w-prose">
                <li>cadrage des besoins et priorités</li>
                <li>architecture de pages et parcours</li>
                <li>design et intégration front-end</li>
                <li>développement technique</li>
                <li>tests et mise en ligne</li>
            </ul>
            <div class="mt-8 flex flex-wrap gap-4">
                <Button className="w-fit" href="/services/site-vitrine-ou-refonte" label="Voir le détail de l'offre" />
                <Button className="w-fit" variant="outlined" href="/contact" label="Demander un diagnostic" />
            </div>
        </div>
    </section>

    <section class="section">
        <div class="max-width padding-x">
            <h2 class="text-display-small">Développement web sur‑mesure</h2>
            <div class="text-body-large mt-6 max-w-prose space-y-4">
                <p>Quand un site standard ne suffit pas : fonctionnalités ou outils métier dédiés.</p>
            </div>
            <ul class="mt-6 list-disc pl-6 text-body-large max-w-prose">
                <li>fonctionnalités personnalisées</li>
                <li>intégrations techniques</li>
                <li>interfaces métier / back-office</li>
                <li>évolutions et amélioration continue du produit</li>
            </ul>
            <div class="mt-8 flex flex-wrap gap-4">
                <Button className="w-fit" href="/services/developpement-sur-mesure" label="Voir le détail de l'offre" />
                <Button className="w-fit" variant="outlined" href="/contact" label="Demander un diagnostic" />
            </div>
        </div>
    </section>

    <section class="section">
        <div class="max-width padding-x">
            <h2 class="text-display-small">Cadrage, audit et accompagnement</h2>
            <div class="text-body-large mt-6 max-w-prose space-y-4">
                <p>Intervention en amont pour clarifier, prioriser et sécuriser les décisions avant d'engager un chantier.</p>
            </div>
            <ul class="mt-6 list-disc pl-6 text-body-large max-w-prose">
                <li>analyse de l'existant</li>
                <li>clarification des objectifs et contraintes</li>
                <li>recommandations actionnables</li>
                <li>plan d'action et estimation du périmètre</li>
            </ul>
            <Button className="mt-8 w-fit" href="/contact" label="Parlons de votre projet" />
        </div>
    </section>

    <section class="section">
        <div class="max-width padding-x">
            <h2 class="text-display-small">Dans toutes nos missions</h2>
            <ul class="mt-6 list-disc pl-6 text-body-large max-w-prose">
                <li>périmètre et objectifs clarifiés avant démarrage</li>
                <li>points de validation réguliers</li>
                <li>transparence sur les choix et arbitrages</li>
                <li>propriété des livrables</li>
                <li>documentation à la livraison</li>
            </ul>
            <div class="text-body-large mt-6 max-w-prose space-y-4">
                <p><strong>Hébergement initial offert :</strong> non inclus.</p>
                <p><strong>Suivi après mise en ligne :</strong> disponible (optionnel), selon vos besoins.</p>
                <p><strong>Budget :</strong> Un prix n'est jamais “au hasard” : il dépend du périmètre, des contraintes et du niveau de personnalisation. Après un premier échange, nous vous partageons une estimation claire avec les options possibles (périmètre minimal vs périmètre complet).</p>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="max-width padding-x">
            <h2 class="text-display-small">Investissement : transparence d'abord</h2>
            <div class="text-body-large mt-6 max-w-prose space-y-4">
                <p>Un prix dépend du périmètre, du contenu et des intégrations. Nous cadrons ces variables avant toute estimation.</p>
                <p>Vous recevez ensuite une proposition claire avec des options (périmètre minimal vs périmètre complet).</p>
            </div>
        </div>
    </section>

    <ReassuranceBlocks />

    <Faq
        title="Questions fréquentes sur nos prestations"
        items={faqItems}
    />

    <section class="section">
        <div class="max-width padding-x">
            <p class="text-body-large">Vous avez d'autres questions sur nos services ? Contactez-nous, on vous répond vite !</p>
            <Button className="mt-6 w-fit" href="/contact" label="Parlons de votre projet" />
        </div>
    </section>
</Layout>
