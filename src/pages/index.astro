                        <Icon icon={rKey} className="w-10 h-10 fill-on-primary-container"/>
                    </div>
                    <h3 class="text-headline-small font-bold mb-2">Accès Admin</h3>
                    <p class="text-body-small text-on-surface-variant">
                        Contrôle total du CMS
                    </p>
                </div>

                {/* Key Card 3 */}
                <div
                        class="w-64 aspect-[3/4] bg-surface-container rounded-3xl border border-outline-variant/40 p-6 flex flex-col items-center justify-center hover:-translate-y-2 transition-transform duration-300 shadow-lg"
                >
                    <div
                            class="w-20 h-20 bg-tertiary-container rounded-full flex items-center justify-center mb-6"
                    >
                        <Icon
                                icon={rCloud}
                                className="w-10 h-10 fill-on-tertiary-container"
                        />
                    </div>
                    <h3 class="text-headline-small font-bold mb-2">Hébergement</h3>
                    <p class="text-body-small text-on-surface-variant">
                        Propriété directe
                    </p>
                </div>
            </div>

            <div class="mt-16">
                <Button
                        href="/methode"
                        label="Notre politique de réversibilité"
                        variant="text"
                />
            </div>
        </div>
    </section>

    {/* 05b. DUO FONDATEUR - COMPACT TEAM CARD */}
