---
import Layout from "@layouts/Layout.astro";
import {Button} from "@udixio/ui-react";
import {Hero} from "@components/home/hero";
import Realisations from "@components/Realisations.astro";
import Faq from "@components/sections/Faq.astro";

const faqItems = [
    {
        question: "Quel budget prévoir ?",
        answer: "Nous ne donnons pas de prix au hasard. Après un cadrage rapide, nous vous proposons une estimation claire avec les options possibles (périmètre minimal vs périmètre complet). Pas de coûts cachés.",
    },
    {
        question: "Quels sont les délais ?",
        answer: "Tout dépend du périmètre. Nous fixons un planning clair dès le départ, avec des étapes validées ensemble. Vous savez toujours où on en est.",
    },
    {
        question: "Que devrai-je faire de mon côté ?",
        answer: "Nous gérons la technique. Vous fournissez les contenus clés et validez les étapes importantes. On vous guide pour que ce soit simple et rapide.",
    },
    {
        question: "Que se passe-t-il après la mise en ligne ?",
        answer: "Nous restons disponibles. Vous pouvez opter pour un suivi ou avancer en autonomie. Dans tous les cas, vous gardez la maîtrise.",
    },
    {
        question: "À qui appartiennent le site et les accès ?",
        answer: "À vous. Les livrables et les accès restent sous votre contrôle. Pas de dépendance forcée.",
    },
];
---

<Layout seo={{
    title: "Clarté & Maîtrise pour votre site web • Udixio",
    description: "Udixio est l'agence qui remet de l'ordre dans les projets web : cadrage clair, transparence et maîtrise côté client.",
}}>
    <Hero client:idle>
        <div class="max-width relative z-0">
            <div class="absolute right-0 -bottom-8 max-w-[80vw]"></div>
        </div>
    </Hero>

    <section class="section">
        <div class="max-width padding-x">
            <h2 class="text-display-small">Les vrais freins des projets web</h2>
            <div class="text-body-large mt-6 max-w-prose space-y-4">
                <p>Flou sur le périmètre, délais qui glissent, jargon qui embrouille… et parfois une dépendance technique difficile à vivre.</p>
                <p>Notre rôle est de remettre de l'ordre : clarifier, cadrer et rendre chaque étape lisible.</p>
            </div>
            <div class="mt-8 grid gap-4 md:grid-cols-4">
                <div class="rounded-2xl border border-outline-variant bg-surface-container-low p-6">
                    <h3 class="text-title-large">Flou &amp; dérives</h3>
                    <p class="text-body-large mt-4">Objectifs mal définis, délais qui s'étirent.</p>
                </div>
                <div class="rounded-2xl border border-outline-variant bg-surface-container-low p-6">
                    <h3 class="text-title-large">Opacité</h3>
                    <p class="text-body-large mt-4">Décisions techniques difficiles à comprendre.</p>
                </div>
                <div class="rounded-2xl border border-outline-variant bg-surface-container-low p-6">
                    <h3 class="text-title-large">Dépendance</h3>
                    <p class="text-body-large mt-4">Accès bloqués, changements compliqués.</p>
                </div>
                <div class="rounded-2xl border border-outline-variant bg-surface-container-low p-6">
                    <h3 class="text-title-large">Support incertain</h3>
                    <p class="text-body-large mt-4">Après la mise en ligne, plus personne.</p>
                </div>
            </div>
            <Button className="mt-8 w-fit" href="/services" label="Découvrir notre approche" />
        </div>
    </section>

    <section class="section">
        <div class="max-width padding-x">
            <h2 class="text-display-small">Notre approche Clarté &amp; Maîtrise</h2>
            <div class="mt-8 grid gap-4 md:grid-cols-2">
                <div class="rounded-2xl border border-outline-variant bg-surface-container-low p-6">
                    <h3 class="text-title-large">Cadrage</h3>
                    <p class="text-body-large mt-4">On clarifie objectifs, contraintes et périmètre avant de démarrer.</p>
                </div>
                <div class="rounded-2xl border border-outline-variant bg-surface-container-low p-6">
                    <h3 class="text-title-large">Transparence</h3>
                    <p class="text-body-large mt-4">Vous savez où on va, ce qui est livré, et pourquoi.</p>
                </div>
                <div class="rounded-2xl border border-outline-variant bg-surface-container-low p-6">
                    <h3 class="text-title-large">Fiabilité</h3>
                    <p class="text-body-large mt-4">Des livrables clairs, testés, et faciles à reprendre.</p>
                </div>
                <div class="rounded-2xl border border-outline-variant bg-surface-container-low p-6">
                    <h3 class="text-title-large">Maîtrise côté client</h3>
                    <p class="text-body-large mt-4">Vos accès, vos choix, vos décisions. Pas de dépendance.</p>
                </div>
            </div>
            <Button className="mt-8 w-fit" href="/methode" label="Voir notre méthode détaillée" />
        </div>
    </section>

    <section class="section">
        <div class="max-width padding-x">
            <h2 class="text-display-small">Preuves alternatives, sans blabla</h2>
            <div class="text-body-large mt-6 max-w-prose space-y-4">
                <p>Pas d'avis inventés. À la place, des preuves concrètes : outils internes, démos et réalisations visibles.</p>
            </div>
            <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
                <div class="rounded-2xl border border-outline-variant bg-surface-container-low p-6">
                    <h3 class="text-title-large">Udixio UI</h3>
                    <p class="text-body-large mt-4">Bibliothèque interne de composants pour des interfaces cohérentes.</p>
                </div>
                <div class="rounded-2xl border border-outline-variant bg-surface-container-low p-6">
                    <h3 class="text-title-large">NetSimpler</h3>
                    <p class="text-body-large mt-4">CMS interne orienté autonomie et simplicité.</p>
                </div>
                <div class="rounded-2xl border border-outline-variant bg-surface-container-low p-6">
                    <h3 class="text-title-large">Template paysagiste</h3>
                    <p class="text-body-large mt-4">Démo sectorielle pour illustrer notre approche.</p>
                </div>
                <div class="rounded-2xl border border-outline-variant bg-surface-container-low p-6">
                    <h3 class="text-title-large">Portfolio</h3>
                    <p class="text-body-large mt-4">Projets et démos accessibles dans nos réalisations.</p>
                </div>
            </div>
            <Button className="mt-8 w-fit" href="/realisations" label="Voir ces preuves en détail" />
        </div>
    </section>

    <section class="section">
        <div class="max-width padding-x">
            <h2 class="text-display-small">Méthode en 5 étapes</h2>
            <ol class="mt-8 grid gap-4">
                <li class="rounded-2xl border border-outline-variant bg-surface-container-low p-6 text-body-large">1) Cadrage : objectifs, contraintes et périmètre validés.</li>
                <li class="rounded-2xl border border-outline-variant bg-surface-container-low p-6 text-body-large">2) Design : parcours et maquettes compréhensibles.</li>
                <li class="rounded-2xl border border-outline-variant bg-surface-container-low p-6 text-body-large">3) Développement &amp; tests : qualité et fiabilité avant mise en ligne.</li>
                <li class="rounded-2xl border border-outline-variant bg-surface-container-low p-6 text-body-large">4) Livraison : accès, documentation, passation claire.</li>
                <li class="rounded-2xl border border-outline-variant bg-surface-container-low p-6 text-body-large">5) Hypercare : on sécurise les premières semaines.</li>
            </ol>
            <p class="text-body-large mt-6 max-w-prose">Chaque étape est validée ensemble.</p>
            <Button className="mt-8 w-fit" href="/methode" label="Voir la méthode complète" />
        </div>
    </section>

    <section class="section">
        <div class="max-width padding-x">
            <h2 class="text-display-small">Portfolio &amp; démos</h2>
            <div class="text-body-large mt-6 max-w-prose space-y-4">
                <p>Nous montrons ce que nous faisons, sans artifices.</p>
            </div>
            <div class="mt-8">
                <Realisations max={4} />
            </div>
            <Button className="mt-8 w-fit" href="/realisations" label="Accéder aux réalisations" />
        </div>
    </section>

    <section class="section">
        <div class="max-width padding-x">
            <h2 class="text-display-small">Aller plus loin</h2>
            <div class="text-body-large mt-6 max-w-prose space-y-4">
                <p>Guides pratiques pour cadrer un projet web, éviter les dérives et garder la maîtrise.</p>
            </div>
            <div class="mt-8 flex flex-wrap gap-4">
                <Button className="w-fit" href="/ressources" label="Voir les ressources" />
                <Button className="w-fit" variant="outlined" href="/services" label="Explorer nos services" />
            </div>
        </div>
    </section>

    <Faq title="FAQ anti-objections" items={faqItems} />

    <section class="section">
        <div class="max-width padding-x">
            <p class="text-body-large">Besoin d'y voir clair ? On vous répond vite et sans jargon.</p>
            <Button className="mt-6 w-fit" href="/contact" label="Demander un diagnostic" />
        </div>
    </section>
</Layout>
