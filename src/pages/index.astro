---
import Layout from "@layouts/Layout.astro";
import { Button, Chip } from "@udixio/ui-react";
import { Hero } from "@components/Hero.tsx";
// import { HeroPaper } from "@components/home/HeroPaper";
import { Logo } from "@components/Logo";
import Realisations from "@components/Realisations.astro";
import { FeaturesGrid } from "@components/home/modern/FeaturesGrid";
// import { ValueProp } from "@components/home/modern/ValueProp";
import { ProblemSolutionSchema } from "@components/home/modern/ProblemSolutionSchema";
// import { MethodSteps } from "@components/home/modern/MethodSteps";
import { ProcessStickyScroll } from "@components/home/modern/ProcessStickyScroll";
import { QAStickyScroll } from "@components/home/modern/QAStickyScroll";
import { ProofsGrid } from "@components/home/modern/ProofsGrid";
import { FaqAccordion } from "@components/home/modern/FaqAccordion";
import CtaSection from "@components/sections/CtaSection.astro";
import { Card } from "@/components/Card";
import { Underline } from "@components/Underline";
import { Icon } from "@udixio/ui-react";

import { iVisibility } from "@udixio/icons-rounded-400/visibility";
import { iHandshake } from "@udixio/icons-rounded-400/handshake";
import { iBolt } from "@udixio/icons-rounded-400/bolt";
import { iTrendingUp } from "@udixio/icons-rounded-400/trending_up";
import { iFolder } from "@udixio/icons-rounded-400/folder";
import { iKey } from "@udixio/icons-rounded-400/key";
import { iCloud } from "@udixio/icons-rounded-400/cloud";
import { iForest } from "@udixio/icons-rounded-400/forest";
import { iBarChart } from "@udixio/icons-rounded-400/bar_chart";
import { iTune } from "@udixio/icons-rounded-400/tune";
import { number } from "zod";
import { iInfo } from "@udixio/icons-rounded-400/info";
import { iChat } from "@udixio/icons-rounded-400/chat";
import { iLock } from "@udixio/icons-rounded-400/lock";
import { iVisibilityOff } from "@udixio/icons-rounded-400/visibility_off";
import { iPartnerExchange } from "@udixio/icons-rounded-400/partner_exchange";
import { iChecklist } from "@udixio/icons-rounded-400/checklist";
import { iVerifiedUser } from "@udixio/icons-rounded-400/verified_user";
import { SymbolKind } from "vscode-languageserver-types";
import { iCheckCircle } from "@udixio/icons-rounded-400/check_circle";
import { iCheckCircleFilled } from "@udixio/icons-rounded-400/filled/check_circle";
import { Divider } from "@udixio/ui-react";
import { icon } from "@fortawesome/fontawesome-svg-core";
import { motion } from "motion/react";
import { iClose } from "@udixio/icons-rounded-400/close";
import { iCheck } from "@udixio/icons-rounded-400/check";
import { SectionPadding } from "@/components/SectionPadding";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.udixio.fr/#organization",
      name: "Udixio",
      url: "https://www.udixio.fr/",
      logo: "https://www.udixio.fr/images/logo.png",
      sameAs: [
        "https://www.linkedin.com/company/udixio",
        "https://github.com/Udixio",
      ],
      contactPoint: {
        "@type": "ContactPoint",
        email: "florian@udixio.fr",
        contactType: "customer service",
      },
    },
    {
      "@type": "LocalBusiness",
      "@id": "https://www.udixio.fr/#localbusiness",
      name: "Udixio",
      url: "https://www.udixio.fr/",
      email: "florian@udixio.fr",
      image: "https://www.udixio.fr/images/logo.png",
      priceRange: "$$",
      address: [
        {
          "@type": "PostalAddress",
          addressLocality: "Amiens",
          addressRegion: "Hauts-de-France",
          addressCountry: "FR",
        },
        {
          "@type": "PostalAddress",
          addressLocality: "Le Havre",
          addressRegion: "Normandie",
          addressCountry: "FR",
        },
      ],
    },
  ],
};

const faqItems = [
  {
    question: "Combien coûte un site sur mesure pour une PME ?",
    answer:
      "Un site vitrine complet démarre généralement à partir de 2 500 €. Avant tout engagement, nous vous remettons un devis détaillé avec un périmètre clair.",
  },
  {
    question: "Êtes-vous basés à Amiens ou au Havre ?",
    answer:
      "Nous intervenons en Normandie et dans les Hauts-de-France, notamment autour du Havre et d’Amiens. Les échanges se font en présentiel ou en visio selon vos besoins.",
  },
  {
    question: "Suis-je propriétaire du site et de son code ?",
    answer:
      "Oui. Le code source, l’hébergement et les données vous appartiennent. Vous n’êtes pas dépendant d’une solution propriétaire.",
  },
  {
    question: "Un site peut-il vraiment générer des leads ?",
    answer:
      "Oui, à condition qu’il soit bien conçu. SEO technique, structure des pages et contenus sont pensés pour attirer et convertir des prospects qualifiés.",
  },
  {
    question: "Que se passe-t-il après la mise en ligne ?",
    answer:
      "Nous assurons une phase de suivi après le lancement, puis proposons si besoin de la maintenance et des évolutions selon vos objectifs.",
  },
  {
    question: "Puis-je changer de prestataire facilement ?",
    answer:
      "Oui. Vous disposez de tous les accès et d’une documentation suffisante pour reprendre le projet ou le confier à un autre prestataire.",
  },
];
---

<Layout
  seo={{
    title:
      "Udixio • Agence Web (Amiens / Le Havre) - Création de sites générateurs de leads",
    description:
      "Udixio accompagne les TPE/PME avec une approche web sur-mesure et écoresponsable axée sur l'acquisition de trafic et de croissance. Agence en Normandie et Hauts-de-France.",
  }}
  background={false}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <Hero client:load className="self-stretch flex  min-h-[60vh]">
    <div class="flex-1 flex flex-col justify-between">
      <h1
        class="max-w-2xl text-display-large text-on-surface-variant anim-fade anim-slide-from-left anim-duration-1000 ease-out anim-delay-100"
      >
        Pensez juste. On s’occupe du reste.
      </h1>

      <div class="flex gap-8">
        <div class="flex-1">
          <p
            class="text-body-large max-w-96 mb-12 anim-fade anim-slide-from-left anim-duration-1000 ease-out anim-delay-200"
          >
            Chez Udixio, on cadre, structure et fait avancer votre projet, sans
            complexité inutile.
          </p>

          <div class="relative group w-fit">
            <Button
              href="/contact"
              shape="squared"
              label="Obtenir un diagnostic"
              className=" w-fit"
            />
            {/* Annotation Arrow - Absolute Position (Top Right) */}
            <div
              class="hidden sm:flex flex-row items-end absolute -top-8 -right-2 translate-x-full w-max pointer-events-none gap-1"
            >
              <svg
                width="32"
                height="24"
                viewBox="0 0 32 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                class="text-tertiary"
              >
                <path
                  d="M28 6 C 24 14 14 18 4 20 M 4 20 L 9 23 M 4 20 L 7 15"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
              <span class="text-tertiary -rotate-6 text-title-small mb-4 -ml-1">
                (100% Offert !)
              </span>
            </div>
          </div>
        </div>
        <div
          class="flex flex-2 w-full gap-4 anim-fade anim-slide-from-right anim-duration-1000 ease-out anim-delay-400"
        >
          <Card
            className="w-1/3 p-6 flex flex-col items-center gap-4 justify-center text-center bg-tertiary-container text-on-tertiary-container "
          >
            <Icon className="size-16" icon={iTune} />
            <p class="text-title-large">Approche<br /> sur-mesure</p>
          </Card>
          <Card
            className="w-2/3 p-8 bg-surface-container-low   flex flex-col justify-center  "
          >
            <div class="flex flex-col md:flex-row gap-4">
              {
                ["Sur-mesure", "Pensé pour durer", "Eco-responsable"].map(
                  (item) => (
                    <div class="text-label-small text-nowrap border border-outline-variant p-1 px-2 rounded-md">
                      {item}
                    </div>
                  ),
                )
              }
            </div>
            <h2 class="text-headline-medium my-2 text-on-surface">
              Obtenez un site efficace et adaptable.
            </h2>
            <Button
              variant="tonal"
              href="/contact"
              label="Obtenir un diagnostic"
              className="ml-auto"
              >Voir notre approche
            </Button>
          </Card>
        </div>
      </div>
    </div>

    <div class="absolute top-8 right-4 md:top-12 md:right-8 flex justify-end">
      <span
        class="flex items-center gap-3 text-label-small md:text-label-medium font-mono text-tertiary uppercase tracking-widest bg-white/50 backdrop-blur-sm px-4 py-2 rounded-full border border-tertiary/20 anim-fade anim-duration-1000 ease-out"
      >
        <span class="relative flex h-2 w-2">
          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-tertiary"
          ></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-tertiary"
          ></span>
        </span>
        HAUTS-DE-FRANCE
      </span>
    </div>
  </Hero>

  {/* 01. LA MÉTHODE - VISUAL MANIFESTO */}
  <section class="section py-32">
    <div class="max-width padding-x">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-24">
        {/* Sticky Title */}
        <div class="md:col-span-4 relative">
          <div class="sticky top-32">
            <span class="sub-title">Le processus</span>
            <h2 class="text-headline-large leading-tight">
              Une <span class="text-gradient">collaboration directe</span>, du
              cadrage au lancement.
            </h2>
            <div class="mt-8 hidden md:block">
              <svg
                class="w-12 h-12 text-primary animate-bounce-slow"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <path d="M12 5v14M5 12l7 7 7-7"></path>
              </svg>
            </div>
          </div>
        </div>

        {/* Vertical Steps */}
        <div class="md:col-span-8 space-y-8">
          {
            [
              {
                number: 1,
                title: "Audit & Plan",
                description:
                  "On échange pour comprendre vos objectifs, puis on pose un cadre simple : ce qu'on fait, dans quel ordre, et pourquoi.",
              },
              {
                number: 2,
                title: "Design & Prototype",
                description:
                  "On conçoit une interface adaptée à votre activité, que vous validez rapidement avant de passer au développement.",
              },
              {
                number: 3,
                title: "Développement & Tests",
                description:
                  "Le site est développé étape par étape, avec un accès pour suivre l'avancement et tester avant la mise en ligne.",
              },
              {
                number: 4,
                title: "Lancement & Suivi",
                description:
                  "Mise en ligne maîtrisée, puis accompagnement pour la prise en main et les ajustements nécessaires.",
              },
            ].map((step) => (
              <div class="group relative pl-8 border-l-2 border-outline-variant transition-colors duration-500 anim-fade-up delay-200">
                <span class="text-title-medium absolute -left-[1.35rem] top-0 flex h-10 w-10 items-center justify-center rounded-full bg-surface border-2 border-outline-variant transition-all ">
                  {step.number}
                </span>
                <h3 class="text-headline-small mb-4 text-on-surface">
                  {step.title}
                </h3>
                <p class="text-body-large text-on-surface-variant font-light max-w-lg pb-16">
                  {step.description}
                </p>
              </div>
            ))
          }

          <Button
            href="/savoir-faire"
            label="Explorer notre savoir-faire"
            variant="outlined"
            className="w-fit"
          />
        </div>
      </div>
    </div>
  </section>

  {/* 02. LES BASES - ASYMMETRIC SPLIT */}
  <section class="py-32 bg-surface-container-low">
    <div class="section">
      <div class="flex flex-col md:flex-row gap-16 md:gap-32 items-start">
        <div class="md:w-1/3 sticky top-32">
          <span class="sub-title">Les bases</span>
          <h2 class="text-headline-large">Ce qui fait la différence</h2>
          <p class="mt-8 text-body-large max-w-xs anim-fade-up">
            Beaucoup de projets bloquent ou dérivent sans cadre simple. Ce qui
            change vraiment :
          </p>
          <ul
            class="mt-4 space-y-2 text-body-large text-on-surface-variant list-disc pl-6"
          >
            <li>savoir où on va</li>
            <li>comment on y va</li>
            <li>et qui fait quoi</li>
          </ul>
        </div>
        <Card className="md:w-2/3 w-full p-8 md:p-12   anim-slide-from-right">
          <div class="flex flex-col gap-4 mt-4">
            {
              [
                {
                  title: "Deux interlocuteurs, pas d’intermédiaire",
                  description: `Vous échangez directement avec nous, du début à la fin.
Les décisions sont prises plus vite, sans perte d’information.`,
                  icon: iPartnerExchange,
                },
                {
                  title: "Un projet cadré dès le départ",
                  description:
                    "Chaque étape est posée simplement : vous savez ce qui est fait, ce qui vient ensuite, et pourquoi.",
                  icon: iChecklist,
                },
                {
                  title: "Expertise & Fiabilité",
                  description:
                    "Des choix techniques solides, pensés pour durer et évoluer sans repartir de zéro.",
                  icon: iVerifiedUser,
                },
                {
                  title: "Vous gardez la main",
                  description:
                    "Vous gardez l’accès, la compréhension et la maîtrise de votre site, sans dépendre de nous.",
                  icon: iKey,
                },
              ].map((feature, index) => (
                <div
                  style={{ ["--anim-delay"]: `${100 * index}ms` }}
                  class="group flex gap-6 items-start p-4 rounded-2xl border border-transparent  anim-in-fade
anim-slide-from-right
anim-duration-1000
anim-delay-200
 "
                >
                  <div class=" p-4 aspect-square rounded-xl bg-surface-container-highest text-on-surface-variant flex items-center justify-center ">
                    <Icon className="size-8" icon={feature.icon} />
                  </div>
                  <div>
                    <h3 class="text-headline-small text-on-surface mb-1">
                      {feature.title}
                    </h3>
                    <p class="text-body-medium text-on-surface-variant ">
                      {feature.description}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </Card>
      </div>
    </div>
  </section>

  {/* 02b. OFFRE CLAIRE - COMPACT SPLIT WITH VISUAL CHECKLIST */}
  <section class="section py-24 bg-surface overflow-hidden">
    <div class="max-width padding-x">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-headline-large text-on-surface">
            Comment nous créons votre site
          </h2>
          <p class="text-title-medium text-on-surface-variant mt-6">
            Chaque étape de votre projet web est accompagnée par nos deux
            experts, du plan stratégique à la mise en ligne. Vous gardez la
            maîtrise et la visibilité, avec un accompagnement complet et
            cohérent.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <Button href="/services" label="Voir nos services" />
            <Button href="/methode" label="Notre méthode" variant="outlined" />
          </div>
        </div>

        {/* Visual Checklist Card */}
        <Card
          className="bg-secondary-container text-on-secondary-container p-8"
        >
          <div
            class="absolute top-4 right-4 bg-primary/10 text-primary px-3 py-1 rounded-full text-label-small uppercase"
          >
            Inclus
          </div>
          <ul class="space-y-4 mt-2">
            {
              [
                "Audit & Stratégie digitale",
                "Design UI/UX sur-mesure",
                "Développement performant",
                "Optimisation SEO Technique",
                "Formation & Autonomie",
              ].map((item) => (
                <li class="flex items-center gap-3">
                  <Icon
                    className="size-6 rounded-full text-secondary"
                    icon={iCheckCircleFilled}
                  />

                  <span class="text-title-medium ">{item}</span>
                </li>
              ))
            }
          </ul>
        </Card>
      </div>
    </div>
  </section>

  {/* 02c. BENEFICES - VALUE CHIPS */}
  <section class="section py-24 bg-surface">
    <div class="max-w-4xl mb-12">
      <h2 class="text-headline-large">
        Des bénéfices concrets.<br />
        <span class="text-gradient">Sans détour.</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        [
          {
            icon: iVisibility,
            title: "Attirer des clients",
            description:
              "Un SEO local optimisé pour générer des visites qualifiées chaque jour.",
          },
          {
            icon: iHandshake,
            title: "Inspirer confiance",
            description:
              "Un site professionnel qui crédibilise votre entreprise auprès de prospects et partenaires.",
          },
          {
            icon: iBolt,
            title: "Gagner du temps",
            description:
              "Automatisation de la prise de contact pour libérer vos équipes commerciales.",
          },
          {
            icon: iTrendingUp,
            title: "Booster votre activité",
            description:
              "Des indicateurs clairs pour transformer votre site en levier de croissance mesurable.",
          },
        ].map((benefit) => (
          <Card variant="outlined" className="group p-6">
            <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-6 transition-transform">
              <Icon icon={benefit.icon} className="w-6 h-6 fill-current" />
            </div>
            <h3 class="text-headline-small  mb-2">{benefit.title}</h3>
            <p class="text-on-surface-variant">{benefit.description}</p>
          </Card>
        ))
      }
    </div>
  </section>

  {/* 03. NOTRE RÉPONSE - DARK MODE IMMERSION */}
  <SectionPadding as="section" start client:idle>
    <Card
      className=" dark bg-surface-container-high rounded-b-none  text-on-surface shadow-xl/30 padding"
    >
      <div class="text-center mb-24 mt-8">
        <span class="sub-title">Notre approche</span>
        <h2 class="text-headline-large md:text-headline-large">
          Vos objectifs d'abord :<br /><span class="text-gradient"
            >des réponses claires</span
          >
        </h2>
        <p class="text-title-medium mt-6">
          Des choix utiles, expliqués et alignés avec vos priorités.
        </p>
      </div>
      <QAStickyScroll client:visible />
    </Card>
  </SectionPadding>

  {/* 04. PREUVES */}
  <section class="section py-32">
    <div class="max-width padding-x">
      <div class="flex justify-between items-end mb-12">
        <div>
          <span class="sub-title">Preuves</span>
          <h2 class="text-headline-large text-on-surface">
            Des preuves concrètes,<br />pas des promesses
          </h2>
          <p class="text-title-medium text-on-surface-variant mt-4 max-w-2xl">
            Des indicateurs mesurables, accessibles et vérifiables sur chaque
            projet livré.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-24">
        <Card variant="outlined" className="p-6  bg-surface-container-low">
          <h3 class="text-headline-small mb-2">Qualité mesurée</h3>
          <p class="text-body-medium text-on-surface-variant">
            Performance, SEO, accessibilité : des scores partagés pour chaque
            projet livré.
          </p>
        </Card>
        <Card variant="outlined" className="p-6  bg-surface-container-low">
          <h3 class="text-headline-small mb-2">Audits vérifiables</h3>
          <p class="text-body-medium text-on-surface-variant">
            Lighthouse, Core Web Vitals : des résultats lisibles pour évaluer la
            qualité.
          </p>
        </Card>
        <Card variant="outlined" className="p-6  bg-surface-container-low">
          <h3 class="text-headline-small mb-2">Sobriété maîtrisée</h3>
          <p class="text-body-medium text-on-surface-variant">
            Poids de page et indicateurs environnementaux suivis pour limiter
            l'impact.
          </p>
        </Card>
      </div>

      <Card
        variant="outlined"
        className="mt-12 bg-surface-container-low grid gap-px grid-cols-1 md:grid-cols-2 lg:grid-cols-4 "
      >
        {
          [
            {
              title: "Scores de Performance 100/100",
              description:
                "Nous visons l'excellence mesurable (Lighthouse) sur la vitesse et le SEO, prouvée sur nos réalisations.",
              badge: "Qualité mesurée",
            },
            {
              title: "Indépendance Technique Totale",
              description:
                "Nous utilisons des outils ouverts et performants (Astro, React, CMS sur-mesure) pour vous libérer des systèmes fermés.",
              badge: "Propriété Client",
            },
            {
              title: "Outils Développés en Interne",
              description:
                "Notre CMS léger Netsimpler et notre propre librairie design Udixio UI garantissent efficacité et personnalisation.",
              badge: "Créateurs",
            },
            {
              title: "Méthodologie Cadrée et Publique",
              description:
                "Notre processus (ateliers, points de validation, garanties post-lancement) est documenté pour avancer en toute confiance.",
              badge: "Méthodologie",
            },
          ].map((proof, index) => (
            <div class="flex ">
              {index !== 0 && <Divider orientation="vertical" />}
              <div class="flex flex-col p-8  h-full">
                <div class="mb-6 self-start px-3 py-1 rounded-full border border-primary/20 text-primary text-label-small font-mono uppercase tracking-wider">
                  {proof.badge}
                </div>
                <div class="mt-auto">
                  <h3 class="text-title-large font-bold mb-3 leading-tight">
                    {proof.title}
                  </h3>
                  <p class="text-body-medium text-on-surface-variant/80">
                    {proof.description}
                  </p>
                </div>
              </div>
            </div>
          ))
        }
      </Card>

      <section class="section">
        <div class="flex items-center justify-between mb-10">
          <h3 class="text-headline-large">Dernières réalisations</h3>
          <Button
            href="/realisations"
            label="Voir nos réalisations"
            variant="tonal"
          />
        </div>
        <Realisations max={7} />
      </section>
    </div>
  </section>

  {/* 04b. INVESTISSEMENT */}
  <section class="section py-24 bg-surface">
    <div class="max-width padding-x">
      <div class="bg-surface-container p-8 md:p-12 rounded-4xl">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <span class="sub-title">Investissement</span>
            <h2
              class="text-headline-medium md:text-headline-large text-on-surface mb-6"
            >
              Des bases claires pour comprendre ce que vous payez.
            </h2>
            <p class="text-title-medium text-on-surface-variant mb-8">
              Selon votre projet, voici les périmètres habituels. Pas de frais
              de dossier, pas d'abonnement imposé.
            </p>
            <Button
              href="/services"
              label="Voir le détail"
              variant="outlined"
              className="w-fit"
            />
          </div>

          {/* Bill Breakdown */}
          <div
