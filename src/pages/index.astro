---
import Layout from "@layouts/Layout.astro";
import {Button} from "@udixio/ui-react";
import {Hero} from "@components/home/hero";
import Realisations from "@components/Realisations.astro";
import {FeaturesGrid} from "@components/home/modern/FeaturesGrid";
// import { ValueProp } from "@components/home/modern/ValueProp";
import {ProblemSolutionSchema} from "@components/home/modern/ProblemSolutionSchema";
// import { MethodSteps } from "@components/home/modern/MethodSteps";
import {ProcessStickyScroll} from "@components/home/modern/ProcessStickyScroll";
import {ProofsGrid} from "@components/home/modern/ProofsGrid";
import {FaqAccordion} from "@components/home/modern/FaqAccordion";

const faqItems = [
    {
        question: "Quel budget pour un site sur-mesure ?",
        answer:
            "Nous travaillons sur devis détaillé. Après un cadrage offert, vous recevez une proposition chiffrée (options claires). Vous savez où va chaque euro : zéro surprise.",
    },
    {
        question: "Pourquoi travailler avec une petite équipe (Le Duo) ?",
        answer:
            "Pour l'agilité et la responsabilité. Pas de téléphone arabe : ceux qui vous conseillent sont ceux qui codent. Votre projet est notre priorité absolue, pas un numéro de dossier.",
    },
    {
        question: "Est-ce que je serai propriétaire de mon site ?",
        answer:
            "Oui, à 100%. Code source, nom de domaine, hébergement : tout est à vous. Nous ne créons aucune dépendance technique artificielle (pas d'abonnement caché).",
    },
    {
        question: "Comment éviter que les délais dérapent ?",
        answer:
            "Tout se joue au cadrage. Nous fixons un planning réaliste avec des jalons de validation. Si un imprévu survient, on en discute tout de suite. Transparence totale.",
    },
    {
        question: "Et après la mise en ligne ?",
        answer:
            "Nous incluons une période de support réactif (hypercare) pour démarrer sereinement. Ensuite, formation admin incluse pour que vous soyez autonome.",
    },
];
---

<Layout
        seo={{
            title: "Clarté & Maîtrise pour votre site web • Udixio",
            description:
                "Udixio est l'agence web qui structure vos projets digitaux : méthode claire, transparence totale et zéro dépendance technique.",
        }}
        background={false}
>
    <Hero client:idle>
        <div class="max-width relative z-0">
            <div class="absolute right-0 -bottom-8 max-w-[80vw]"></div>
        </div>
    </Hero>

    <section class="section">
        <div class="max-width padding-x">
            <h2 class="text-display-small text-center md:text-left">
                Les vrais freins des projets web
            </h2>
            <div
                    class="text-body-large mt-6 max-w-prose space-y-4 text-center md:text-left"
            >
                <p>
                    Trop de projets web finissent en frustration : budget dépassé, délais
                    explosés, ou site impossible à modifier soi-même. Le problème n'est
                    pas toujours la technique, mais le <strong>manque de méthode</strong>.
                </p>
            </div>

            <FeaturesGrid client:visible/>

            <div class="mt-12 flex justify-center md:justify-start">
                <Button
                        variant="outlined"
                        href="/services"
                        label="Découvrir comment on travaille"
                />
            </div>
        </div>
    </section>

    <section class="section bg-surface-container-lowest py-24">
        <div class="max-width padding-x">
            <h2 class="text-display-small text-center mb-8">
                Notre réponse : du tac au tac
            </h2>
            <p class="text-body-large max-w-2xl mx-auto text-center mb-12">
                Survolez les cartes pour découvrir nos solutions structurelles.
            </p>

            <ProblemSolutionSchema client:visible/>
        </div>
    </section>

    <section class="section">
        <div class="max-width padding-x">
            <h2 class="text-display-small text-center md:text-left mb-12">
                Nos preuves tangibles
            </h2>
            <ProofsGrid client:visible/>

            <div class="mt-12 flex justify-center md:justify-start">
                <Button
                        className="w-fit"
                        href="/realisations"
                        label="Explorer nos réalisations"
                />
            </div>
        </div>
    </section>

    <section class="section bg-surface-container-lowest py-24">
        <div class="max-width padding-x">
            <div class="mb-12 text-center md:text-left">
                <h2 class="text-display-small">Un processus rodé</h2>
                <p class="text-body-large mt-4 max-w-prose">
                    5 étapes, 0 surprise. Une méthodologie qui a fait ses preuves pour
                    livrer à temps et en qualité.
                </p>
            </div>

            <ProcessStickyScroll client:visible/>

            <div class="mt-8 flex justify-center">
                <Button
                        className="w-fit"
                        href="/methode"
                        label="Comprendre notre méthode en détail"
                />
            </div>
        </div>
    </section>

    <section class="section">
        <div class="max-width padding-x">
            <h2 class="text-display-small mb-12">Réalisations récentes</h2>

            <Realisations max={4}/>

            <div class="mt-12 flex justify-center">
                <Button
                        variant="outlined"
                        href="/realisations"
                        label="Voir tout le portfolio"
                />
            </div>
        </div>
    </section>

    <section class="section bg-surface-container-lowest py-24">
        <div class="max-width padding-x">
            <div
                    class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6"
            >
                <div class="max-w-2xl">
                    <h2 class="text-display-small mb-4">Guides & Conseils</h2>
                    <p class="text-body-large text-on-surface-variant">
                        Pour vous aider à mûrir votre projet avant même de signer. Du
                        contenu actionnable, offert par la maison.
                    </p>
                </div>
                <Button
                        variant="outlined"
                        href="/blog"
                        label="Voir tous les articles"
                />
            </div>

            <div class="grid gap-6 md:grid-cols-3">
                {
                    [
                        {
                            title: "Le guide du cahier des charges",
                            cat: "Méthode",
                            desc: "Le modèle complet pour ne rien oublier lors de la définition de votre besoin.",
                            href: "#",
                        },
                        {
                            title: "Refonte : les pièges à éviter",
                            cat: "Stratégie",
                            desc: "Pourquoi 50% des refontes échouent (et comment faire partie des réussites).",
                            href: "#",
                        },
                        {
                            title: "SEO : Comprendre les bases",
                            cat: "Technique",
                            desc: "Le jargon du référencement expliqué aux dirigeants.",
                            href: "#",
                        },
                    ].map((resource) => (
                            <a
                                    href={resource.href}
                                    class="group block p-8 rounded-3xl bg-surface border border-outline-variant/50 hover:border-primary/50 transition-colors"
                            >
              <span class="inline-block px-3 py-1 rounded-full bg-primary/10 text-primary text-label-small font-bold mb-4">
                {resource.cat}
              </span>
                                <h3 class="text-title-large font-bold mb-3 group-hover:text-primary transition-colors">
                                    {resource.title}
                                </h3>
                                <p class="text-body-medium text-on-surface-variant">
                                    {resource.desc}
                                </p>
                            </a>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="section bg-surface-container-lowest py-24">
        <div class="max-width padding-x">
            <div
                    class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6"
            >
                <div class="max-w-2xl">
                    <h2 class="text-display-small mb-4">Guides & Conseils</h2>
                    <p class="text-body-large text-on-surface-variant">
                        Pour vous aider à mûrir votre projet avant même de signer. Du
                        contenu actionnable, offert par la maison.
                    </p>
                </div>
                <Button
                        variant="outlined"
                        href="/blog"
                        label="Voir tous les articles"
                />
            </div>

            <div class="grid gap-6 md:grid-cols-3">
                {
                    [
                        {
                            title: "Le guide du cahier des charges",
                            cat: "Méthode",
                            desc: "Le modèle complet pour ne rien oublier lors de la définition de votre besoin.",
                            href: "#",
                        },
                        {
                            title: "Refonte : les pièges à éviter",
                            cat: "Stratégie",
                            desc: "Pourquoi 50% des refontes échouent (et comment faire partie des réussites).",
                            href: "#",
                        },
                        {
                            title: "SEO : Comprendre les bases",
                            cat: "Technique",
                            desc: "Le jargon du référencement expliqué aux dirigeants.",
                            href: "#",
                        },
                    ].map((resource) => (
                            <a
                                    href={resource.href}
                                    class="group block p-8 rounded-3xl bg-surface border border-outline-variant/50 hover:border-primary/50 transition-colors"
                            >
              <span class="inline-block px-3 py-1 rounded-full bg-primary/10 text-primary text-label-small font-bold mb-4">
                {resource.cat}
              </span>
                                <h3 class="text-title-large font-bold mb-3 group-hover:text-primary transition-colors">
                                    {resource.title}
                                </h3>
                                <p class="text-body-medium text-on-surface-variant">
                                    {resource.desc}
                                </p>
                            </a>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="section bg-surface-container-high py-24">
        <div class="max-width padding-x">
            <h2 class="text-display-small text-center mb-12">
                Questions fréquentes (sans tabou)
            </h2>
            <FaqAccordion client:visible items={faqItems}/>
        </div>
    </section>

    <section class="section">
        <div class="max-width padding-x">
            <div
                    class="rounded-3xl bg-primary text-on-primary p-8 md:p-16 text-center md:text-left overflow-hidden relative"
            >
                <div
                        class="absolute top-0 right-0 w-64 h-64 bg-white/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3"
                >
                </div>

                <div class="relative z-10 grid gap-8 md:grid-cols-2 items-center">
                    <div>
                        <h2 class="text-display-medium mb-6">
                            Besoin d'y voir plus clair ?
                        </h2>
                        <p class="text-body-large opacity-90 mb-8 max-w-lg">
                            Chaque projet commence par une conversation. Racontez-nous vos
                            enjeux, nous vous dirons franchement si nous sommes l'agence qu'il
                            vous faut (et sinon, on vous le dira aussi).
                        </p>
                    </div>
                    <div
                            class="flex flex-col sm:flex-row gap-4 justify-center md:justify-end"
                    >
                        <Button
                                className="bg-white text-primary hover:bg-white/90"
                                href="/contact"
                                label="Demander un diagnostic offert"
                        />
                        <Button
                                variant="outlined"
                                className="border-white text-white hover:bg-white/10"
                                href="/services"
                                label="Voir nos services"
                        />
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>
