---
import Layout from "@layouts/Layout.astro";
import {Button} from "@udixio/ui-react";
import {Hero} from "@components/Hero.tsx";
// import { HeroPaper } from "@components/home/HeroPaper";
import {Logo} from "@components/Logo";
import Realisations from "@components/Realisations.astro";
import {FeaturesGrid} from "@components/home/modern/FeaturesGrid";
// import { ValueProp } from "@components/home/modern/ValueProp";
import {ProblemSolutionSchema} from "@components/home/modern/ProblemSolutionSchema";
// import { MethodSteps } from "@components/home/modern/MethodSteps";
import {ProcessStickyScroll} from "@components/home/modern/ProcessStickyScroll";
import {ProofsGrid} from "@components/home/modern/ProofsGrid";
import {FaqAccordion} from "@components/home/modern/FaqAccordion";
import {Card} from "@/components/Card";
import {Underline} from "@components/Underline";
import {Icon} from "@udixio/ui-react";

import rVisibility from "@material-design-icons/svg/outlined/visibility.svg?raw";
import rHandshake from "@material-design-icons/svg/outlined/handshake.svg?raw";
import rBolt from "@material-design-icons/svg/outlined/bolt.svg?raw";
import rTrendingUp from "@material-design-icons/svg/outlined/trending_up.svg?raw";
import rFolder from "@material-design-icons/svg/outlined/folder.svg?raw";
import rKey from "@material-design-icons/svg/outlined/key.svg?raw";
import rCloud from "@material-design-icons/svg/outlined/cloud.svg?raw";
import rForest from "@material-design-icons/svg/outlined/forest.svg?raw";
import rBarChart from "@material-design-icons/svg/outlined/bar_chart.svg?raw";

const faqItems = [
    {
        question: "Quel budget prévoir pour un site sur-mesure ?",
        answer:
            "Après un cadrage initial, nous remettons un devis détaillé avec inclus/exclus et options. Vous comprenez ce qui est prévu avant de lancer la production.",
    },
    {
        question: "Comment suivez-vous l'avancement ?",
        answer:
            "Vous avez accès au suivi du projet et à des points réguliers. Chaque décision est expliquée simplement pour garder la main.",
    },
    {
        question: "Serai-je propriétaire de mon site ?",
        answer:
            "Oui. Code source, accès et données vous appartiennent. Nous privilégions des technologies ouvertes et une documentation claire.",
    },
    {
        question: "Comment gérez-vous les délais ?",
        answer:
            "Le planning est défini dès le cadrage avec des jalons de validation. En cas d'ajustement, on en parle tout de suite.",
    },
    {
        question: "Que se passe-t-il après la mise en ligne ?",
        answer:
            "Une phase d'hypercare est prévue pour le démarrage, puis une formation pour vous rendre autonome. La maintenance évolutive reste possible.",
    },
    {
        question: "Puis-je récupérer mes accès et changer de prestataire ?",
        answer:
            "Oui. Les accès, le code et les livrables sont à vous. Nous documentons le projet pour garantir la réversibilité.",
    },
];
---

<Layout
        seo={{
            title: "Clarté & Maîtrise pour votre site web • Udixio",
            description:
                "Udixio structure vos projets digitaux : méthode claire, transparence, sobriété et autonomie durable.",
        }}
        background={false}
>
    <Hero client:load>
        <div
                class="w-full max-w-[90rem] mx-auto px-4 flex flex-col justify-center min-h-[50vh]"
        >
            {/* Trendy Deconstructed Title */}
            <div class="w-full flex justify-end mb-8 md:mb-0 md:-translate-y-4">
        <span
                class="flex items-center gap-3 text-label-small md:text-label-medium font-mono text-tertiary uppercase tracking-widest bg-white/50 backdrop-blur-sm px-4 py-2 rounded-full border border-tertiary/20 anim-fade anim-duration-1000 ease-out"
        >
          <span class="relative flex h-2 w-2">
            <span
                    class="animate-ping absolute inline-flex h-full w-full rounded-full bg-tertiary opacity-75"
            ></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-tertiary"
            ></span>
          </span>
          HAUTS-DE-FRANCE
        </span>
            </div>
            <h1
                    class="flex flex-col uppercase mix-blend-darken text-on-surface-variant"
            >
                {/* Row 1: Left */}
                <span
                        class="self-start flex flex-col md:flex-row md:items-baseline gap-2 md:gap-4 group"
                >
          <span
                  class="text-headline-small normal-case mb-2 md:mb-0 block anim-fade anim-slide-from-left anim-duration-1000 ease-out"
          >
            — L'agence web
          </span>
          <span
                  class="text-display-large text-on-surface anim-fade anim-slide-from-left anim-duration-1000 ease-out anim-delay-100"
          >UDIXIO</span
          >
        </span>

                {/* Row 2: Right/Indented */}
                <span
                        class="self-start md:self-end md:mr-12 text-display-large opacity-70 anim-fade anim-slide-from-left anim-duration-1000 ease-out anim-delay-200"
                >
          ACCOMPAGNE
        </span>

                {/* Row 3: Mixed (Small 'en' + Big 'Transparence') */}
                <span
                        class="self-start md:self-center flex flex-col md:flex-row items-baseline gap-2 md:gap-6 mt-2 md:mt-0"
                >
          <span
                  class="text-headline-medium lowercase anim-fade anim-slide-from-bottom anim-duration-1000 ease-out anim-delay-300"
          >
            en toute
          </span>
          <span
                  class="relative italic inline-block text-display-large text-gradient anim-fade anim-slide-from-bottom anim-duration-1000 ease-out anim-delay-400"
          >
            TRANSPARENCE
            <Underline client:idle className="text-primary/30" delay={0.6}/>
          </span>
        </span>
            </h1>

            {/* Deconstructed Footer: Description Left, CTA Right */}
            <div
                    class="flex flex-col md:flex-row justify-between items-start md:items-end mt-16 md:mt-24 gap-8 anim-fade anim-duration-1500 border-t border-outline-variant/50 pt-8"
            >
                <p
                        class="text-body-large max-w-md text-on-surface-variant anim-fade anim-duration-1000 ease-out anim-delay-200"
                >
                    <strong>Fini le jargon et les boîtes noires.</strong><br/>
                    Un cadrage net, des décisions expliquées et un suivi partagé. Agence web
                    pour TPE/PME exigeantes : visibilité, crédibilité et acquisition maîtrisées.
                </p>

                <div
                        class="flex flex-wrap gap-4 anim-scale-in anim-duration-1000 anim-delay-500"
                >
                    <div class="relative group">
                        <Button
                                href="/contact"
                                shape="squared"
                                label="Obtenir un diagnostic"
                                className="bg-primary text-on-primary"
                        />
                        {/* Annotation Arrow - Absolute Position (Top Right) */}
                        <div
                                class="hidden sm:flex flex-col items-center absolute bottom-full -right-4 translate-x-1/4 mb-1 w-max pointer-events-none group-hover:-translate-y-1 transition-transform duration-300"
                        >
              <span
                      class="text-tertiary font-bold -rotate-6 text-title-small"
                      style="font-family: 'Comforter', cursive;"
              >
                (100% Offert !)
              </span>
                            <svg
                                    width="24"
                                    height="24"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="text-tertiary -mt-1 -ml-8"
                            >
                                <path
                                        d="M18 2C16 8 10 16 4 20M4 20L10 18M4 20L8 14"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"></path>
                            </svg>
                        </div>
                    </div>
                    <Button
                            variant="outlined"
                            href="/realisations"
                            label="Parcourir nos réalisations"
                    />
                </div>
            </div>
        </div>
    </Hero>

    {/* 01. LA MÉTHODE - VISUAL MANIFESTO */}
    <section class="section py-32 bg-surface">
        <div class="max-width padding-x">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-24">
                {/* Sticky Title */}
                <div class="md:col-span-4 relative">
                    <div class="sticky top-32">
            <span class="text-title-small text-tertiary mb-4 block"
            >01 — LE PROCESSUS</span
            >
                        <h2 class="text-headline-large leading-tight ">
                            3 étapes claires.<br/>
                            <span class="text-gradient">Rythme maîtrisé.</span>
                        </h2>
                        <div class="mt-8 hidden md:block">
                            <svg
                                    class="w-12 h-12 text-primary animate-bounce-slow"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                            >
                                <path d="M12 5v14M5 12l7 7 7-7"></path>
                            </svg>
                        </div>
                    </div>
                </div>

                {/* Vertical Steps */}
                <div class="md:col-span-8 space-y-24">
                    {/* Step 1 */}
                    <div
                            class="group relative pl-8 border-l-2 border-outline-variant hover:border-primary transition-colors duration-500 anim-fade-up delay-200"
                    >
            <span
                    class="absolute -left-[1.35rem] top-0 flex h-10 w-10 items-center justify-center rounded-full bg-surface border-2 border-outline-variant group-hover:border-secondary group-hover:bg-secondary group-hover:text-on-secondary transition-all text-title-medium font-bold"
            >1</span
            >
                        <h3 class="text-headline-medium mb-4 text-on-surface">
                            Cadrage des objectifs
                        </h3>
                        <p
                                class="text-body-large text-on-surface-variant font-light max-w-lg"
                        >
                            Atelier initial, priorités et contraintes posées. Le périmètre est
                            validé avant d'avancer.
                        </p>
                    </div>

                    {/* Step 2 */}
                    <div
                            class="group relative pl-8 border-l-2 border-outline-variant hover:border-primary transition-colors duration-500 anim-fade-up delay-200"
                    >
            <span
                    class="absolute -left-[1.35rem] top-0 flex h-10 w-10 items-center justify-center rounded-full bg-surface border-2 border-outline-variant group-hover:border-secondary group-hover:bg-secondary group-hover:text-on-secondary transition-all text-title-medium font-bold"
            >2</span
            >
                        <h3 class="text-headline-medium mb-4 text-on-surface">
                            Plan d'action clair
                        </h3>
                        <p
                                class="text-body-large text-on-surface-variant font-light max-w-lg"
                        >
                            Feuille de route claire, validations régulières et suivi lisible
                            pour garder le contrôle.
                        </p>
                    </div>

                    {/* Step 3 */}
                    <div
                            class="group relative pl-8 border-l-2 border-outline-variant hover:border-primary transition-colors duration-500 anim-fade-up delay-200"
                    >
            <span
                    class="absolute -left-[1.35rem] top-0 flex h-10 w-10 items-center justify-center rounded-full bg-surface border-2 border-outline-variant group-hover:border-secondary group-hover:bg-secondary group-hover:text-on-secondary transition-all text-title-medium font-bold"
            >3</span
            >
                        <h3 class="text-headline-medium mb-4 text-on-surface">
                            Autonomie et transmission
                        </h3>
                        <p
                                class="text-body-large text-on-surface-variant font-light max-w-lg"
                        >
                            Code source, accès et documentation remis. Formation incluse pour
                            vous rendre autonome.
                        </p>
                    </div>

                    <Button
                            href="/methode"
                            label="Explorer la méthode en détail"
                            variant="outlined"
                            className="w-fit"
                    />
                </div>
            </div>
        </div>
    </section>

    {/* 02. LES BASES - ASYMMETRIC SPLIT */}
    <section class="py-32 bg-surface-container-low overflow-hidden">
        <div class="section relative z-10">
            <div class="flex flex-col md:flex-row gap-16 md:gap-32 items-start">
                <div class="md:w-1/3 sticky top-32">
          <span class="text-label-large text-gradient mb-4 block"
          >02 — LES BASES</span
          >
                    <h2 class="text-headline-large text-on-surface tracking-tighter">
                        Les bases<br/>d'un projet clair
                    </h2>
                    <p
                            class="mt-8 text-body-large text-on-surface-variant max-w-xs anim-fade-up"
                    >
                        Beaucoup de projets avancent mal faute de repères simples. Ce qui
                        fait la différence : un cadre lisible, une méthode partagée et un
                        pilotage transparent.
                    </p>
                </div>
                <Card className="md:w-2/3 w-full p-8 md:p-12   anim-slide-from-right">
                    <FeaturesGrid client:visible/>
                </Card>
            </div>
        </div>
    </section>

    {/* 02b. OFFRE CLAIRE - COMPACT SPLIT WITH VISUAL CHECKLIST */}
    <section class="section py-24 bg-surface overflow-hidden">
        <div class="max-width padding-x">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
                <div>
                    <h2 class="text-headline-large text-on-surface">
                        Une offre claire,<br/>du cadrage à l'autonomie
                    </h2>
                    <p class="text-title-medium text-on-surface-variant mt-6">
                        Nous concevons des sites web sur-mesure, de l'audit initial au
                        déploiement. Chaque livrable est posé dès le départ, avec un
                        planning réaliste et sans coûts cachés.
                    </p>
                    <div class="mt-8 flex flex-wrap gap-4">
                        <Button
                                href="/services"
                                label="Voir ce qui est inclus"
                                variant="outlined"
                        />
                        <Button href="/methode" label="Notre méthode" variant="text"/>
                    </div>
                </div>

                {/* Visual Checklist Card */}
                <div
                        class="bg-surface-container-low p-8 rounded-3xl border border-outline-variant/50 relative"
                >
                    <div
                            class="absolute top-4 right-4 bg-primary/10 text-primary px-3 py-1 rounded-full text-label-small font-bold uppercase tracking-wide"
                    >
                        Inclus
                    </div>
                    <ul class="space-y-4 mt-2">
                        {
                            [
                                "Audit & Stratégie digitale",
                                "Design UI/UX sur-mesure",
                                "Développement performant",
                                "Optimisation SEO Technique",
                                "Formation & Autonomie",
                            ].map((item) => (
                                    <li class="flex items-center gap-3">
                  <span class="flex-shrink-0 w-6 h-6 rounded-full bg-primary text-on-primary flex items-center justify-center text-[10px]">
                    <svg
                            width="12"
                            height="12"
                            viewBox="0 0 12 12"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                    >
                      <polyline points="2 6 4.5 9 10 3"/>
                    </svg>
                  </span>
                                        <span class="text-title-medium text-on-surface">{item}</span>
                                    </li>
                            ))
                        }
                    </ul>
                </div>
            </div>
        </div>
    </section>

    {/* 02c. BENEFICES - VALUE CHIPS */}
    <section class="section py-24 bg-surface">
        <div class="max-width padding-x">
            <div class="max-w-4xl mb-12">
                <h2 class="text-headline-large text-on-surface">
                    Des bénéfices concrets.<br/>
                    <span class="text-on-surface-variant opacity-60">Sans détour.</span>
                </h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                {/* Item 1 */}
                <div
                        class="group p-6 rounded-2xl bg-surface-container-lowest border border-outline-variant/30 hover:border-primary/50 transition-colors duration-300"
                >
                    <div
                            class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-6 group-hover:scale-110 transition-transform"
                    >
                        <Icon icon={rVisibility} className="w-6 h-6 fill-current"/>
                    </div>
                    <h3 class="text-headline-small font-bold mb-2">Visibilité</h3>
                    <p class="text-body-medium text-on-surface-variant">
                        Plus de trafic qualifié grâce à un SEO technique irréprochable.
                    </p>
                </div>

                {/* Item 2 */}
                <div
                        class="group p-6 rounded-2xl bg-surface-container-lowest border border-outline-variant/30 hover:border-primary/50 transition-colors duration-300"
                >
                    <div
                            class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-6 group-hover:scale-110 transition-transform"
                    >
                        <Icon icon={rHandshake} className="w-6 h-6 fill-current"/>
                    </div>
                    <h3 class="text-headline-small font-bold mb-2">Crédibilité</h3>
                    <p class="text-body-medium text-on-surface-variant">
                        Une image pro et rassurante dès la première seconde.
                    </p>
                </div>

                {/* Item 3 */}
                <div
                        class="group p-6 rounded-2xl bg-surface-container-lowest border border-outline-variant/30 hover:border-primary/50 transition-colors duration-300"
                >
                    <div
                            class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-6 group-hover:scale-110 transition-transform"
                    >
                        <Icon icon={rBolt} className="w-6 h-6 fill-current"/>
                    </div>
                    <h3 class="text-headline-small font-bold mb-2">Gain de temps</h3>
                    <p class="text-body-medium text-on-surface-variant">
                        CMS simple et autonomie totale pour vos mises à jour.
                    </p>
                </div>

                {/* Item 4 */}
                <div
                        class="group p-6 rounded-2xl bg-surface-container-lowest border border-outline-variant/30 hover:border-primary/50 transition-colors duration-300"
                >
                    <div
                            class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-6 group-hover:scale-110 transition-transform"
                    >
                        <Icon icon={rTrendingUp} className="w-6 h-6 fill-current"/>
                    </div>
                    <h3 class="text-headline-small font-bold mb-2">Croissance</h3>
                    <p class="text-body-medium text-on-surface-variant">
                        Investissement piloté sans aléas budgétaires.
                    </p>
                </div>
            </div>
        </div>
    </section>

    {/* 03. NOTRE RÉPONSE - DARK MODE IMMERSION */}
    <section
            class="section py-32 bg-inverse-surface text-inverse-on-surface relative"
    >
        <div class="max-width padding-x">
            <div class="text-center mb-24">
        <span class="text-label-large font-mono text-primary-fixed mb-4 block"
        >03 — NOTRE APPROCHE</span
        >
                <h2 class="text-headline-large md:text-headline-large">
                    Vos objectifs d'abord :<br/><span class="text-primary-fixed"
                >des réponses claires</span
                >
                </h2>
                <p class="text-title-medium mt-6 text-inverse-on-surface/70">
                    Des choix simples, expliqués et reliés à vos priorités.
                </p>
            </div>
            <ProblemSolutionSchema client:visible/>
        </div>
    </section>

    {/* 04. PREUVES - WIDE GALLERY */}
    <section class="section py-32">
        <div class="max-width padding-x">
            <div class="flex justify-between items-end mb-8">
                <div>
                    <h2 class="text-headline-large text-on-surface">
                        Des preuves claires, pas des promesses
                    </h2>
                    <p class="text-title-medium text-on-surface-variant mt-4 max-w-2xl">
                        Nos choix techniques et nos résultats sont vérifiables : indicateurs
                        publiés, audits lisibles et sobriété mesurée.
                    </p>
                </div>
                <Button
                        href="/realisations"
                        label="Tout voir"
                        variant="outlined"
                        className="border-transparent"
                />
            </div>

            <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
                <div
                        class="p-6 rounded-2xl border border-outline-variant/40 bg-surface"
                >
                    <h3 class="text-headline-small font-bold mb-2">Qualité mesurée</h3>
                    <p class="text-body-medium text-on-surface-variant">
                        Performance, SEO, accessibilité : des scores partagés pour chaque
                        projet livré.
                    </p>
                </div>
                <div
                        class="p-6 rounded-2xl border border-outline-variant/40 bg-surface"
                >
                    <h3 class="text-headline-small font-bold mb-2">Audits vérifiables</h3>
                    <p class="text-body-medium text-on-surface-variant">
                        Résultats lisibles (ex. Lighthouse, Core Web Vitals) pour valider la
                        qualité.
                    </p>
                </div>
                <div
                        class="p-6 rounded-2xl border border-outline-variant/40 bg-surface"
                >
                    <h3 class="text-headline-small font-bold mb-2">Sobriété maîtrisée</h3>
                    <p class="text-body-medium text-on-surface-variant">
                        Poids de page et éco‑indicateurs suivis pour limiter l'empreinte.
                    </p>
                </div>
            </div>

            <ProofsGrid client:visible/>

            <div class="mt-24">
                <div class="flex items-center justify-between mb-10">
                    <h3 class="text-headline-large">Dernières réalisations</h3>
                    <Button
                            href="/realisations"
                            label="Voir toutes les réalisations"
                            variant="text"
                    />
                </div>
                <Realisations max={4}/>
            </div>
        </div>
    </section>

    {/* 04b. INVESTISSEMENT & MAITRISE */}
    {/* 04b. INVESTISSEMENT & MAITRISE - TRANSPARENCY PANEL */}
    <section class="section py-24 bg-surface">
        <div class="max-width padding-x">
            <div class="bg-surface-container p-8 md:p-12 rounded-[2.5rem]">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                    <div>
                        <h2
                                class="text-headline-medium md:text-headline-large text-on-surface mb-6"
                        >
                            Transparence totale<br/>sur l'investissement.
                        </h2>
                        <p class="text-title-medium text-on-surface-variant mb-8">
                            Pas de "coûts cachés" ou de "frais de dossier" obscurs. Tout est
                            listé, tout est justifié.
                        </p>
                        <Button
                                href="/services"
                                label="Détail des prestations"
                                variant="outlined"
                                className="bg-surface"
                        />
                    </div>

                    {/* Bill Breakdown Visual */}
                    <div
                            class="bg-surface rounded-2xl p-6 shadow-sm border border-outline-variant/30 font-mono text-body-medium"
                    >
                        <div
                                class="flex justify-between border-b border-outline-variant/30 pb-4 mb-4 text-on-surface-variant uppercase tracking-wider text-label-small"
                        >
                            <span>Poste</span>
                            <span>Statut</span>
                        </div>
                        <div class="space-y-4">
                            <div class="flex justify-between items-center">
                                <span>Audit & Stratégie</span>
                                <span
                                        class="bg-tertiary-container text-on-tertiary-container px-2 py-1 rounded text-label-small"
                                >INCLUS</span
                                >
                            </div>
                            <div class="flex justify-between items-center">
                                <span>Design UI/UX</span>
                                <span
                                        class="bg-tertiary-container text-on-tertiary-container px-2 py-1 rounded text-label-small"
                                >INCLUS</span
                                >
                            </div>
                            <div class="flex justify-between items-center">
                                <span>Intégration & Dev</span>
                                <span
                                        class="bg-tertiary-container text-on-tertiary-container px-2 py-1 rounded text-label-small"
                                >INCLUS</span
                                >
                            </div>
                            <div class="flex justify-between items-center">
                                <span>Formation Admin</span>
                                <span
                                        class="bg-tertiary-container text-on-tertiary-container px-2 py-1 rounded text-label-small"
                                >INCLUS</span
                                >
                            </div>
                            <div class="flex justify-between items-center opacity-60">
                                <span>Maintenance Evolutive</span>
                                <span
                                        class="border border-outline-variant px-2 py-1 rounded text-label-small"
                                >OPTION</span
                                >
                            </div>
                        </div>
                        <div
                                class="mt-6 pt-4 border-t border-outline-variant/30 flex justify-between items-center text-headline-small text-primary font-sans font-bold"
