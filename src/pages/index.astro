---
import Layout from "@layouts/Layout.astro";
import { Button, Icon } from "@udixio/ui-react";
import { Hero } from "@components/Hero.tsx";
import Realisations from "@components/Realisations.astro";
import { QAStickyScroll } from "@components/home/modern/QAStickyScroll";
import FaqSection from "@components/sections/FaqSection.astro";
import CtaSection from "@components/sections/CtaSection.astro";
import { Card } from "@/components/Card";
import { SectionPadding } from "@/components/SectionPadding";

import { iPartnerExchange } from "@udixio/icons-rounded-400/partner_exchange";
import { iChecklist } from "@udixio/icons-rounded-400/checklist";
import { iVerifiedUser } from "@udixio/icons-rounded-400/verified_user";
import { iKey } from "@udixio/icons-rounded-400/key";
import { iVisibility } from "@udixio/icons-rounded-400/visibility";
import { iTune } from "@udixio/icons-rounded-400/tune";
import { iStorefront } from "@udixio/icons-rounded-400/storefront";
import { iGroups } from "@udixio/icons-rounded-400/groups";
import { iRocketLaunch } from "@udixio/icons-rounded-400/rocket_launch";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.udixio.fr/#organization",
      name: "Udixio",
      description:
        "Agence web spécialisée en création de sites performants et écoresponsables pour TPE/PME en Hauts-de-France et Normandie. Développement sur-mesure, SEO technique et stratégie digitale.",
      url: "https://www.udixio.fr/",
      logo: "https://www.udixio.fr/images/logo.png",
      image: "https://www.udixio.fr/images/logo.png",
      sameAs: [
        "https://www.linkedin.com/company/udixio",
        "https://github.com/Udixio",
      ],
      knowsAbout: [
        "Création de site web",
        "Développement web sur-mesure",
        "SEO technique",
        "Éco-conception numérique",
        "Astro",
        "React",
        "Stratégie digitale",
        "Performance web",
        "Accessibilité WCAG",
      ],
      contactPoint: {
        "@type": "ContactPoint",
        email: "florian@udixio.fr",
        contactType: "customer service",
      },
    },
    {
      "@type": "LocalBusiness",
      "@id": "https://www.udixio.fr/#localbusiness",
      name: "Udixio",
      url: "https://www.udixio.fr/",
      email: "florian@udixio.fr",
      telephone: "+33647235448",
      image: "https://www.udixio.fr/images/logo.png",
      priceRange: "$$",
      openingHoursSpecification: [
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          opens: "09:00",
          closes: "18:00",
        },
      ],
      address: [
        {
          "@type": "PostalAddress",
          addressLocality: "Amiens",
          addressRegion: "Hauts-de-France",
          addressCountry: "FR",
        },
        {
          "@type": "PostalAddress",
          addressLocality: "Le Havre",
          addressRegion: "Normandie",
          addressCountry: "FR",
        },
      ],
    },
  ],
};

const faqItems = [
  {
    question: "Combien ça coûte ?",
    answer:
      "À partir de 2 500€ pour un site vitrine. Chaque projet démarre par une estimation gratuite, après un échange sur votre besoin.",
  },
  {
    question: "Suis-je propriétaire du site ?",
    answer:
      "Oui. Code source, hébergement et accès CMS sont remis à la livraison — sans condition et sans dépendance à notre infrastructure.",
  },
  {
    question: "En combien de temps ?",
    answer:
      "4 à 8 semaines pour un site vitrine selon le périmètre. Un planning détaillé est fourni dès la phase de cadrage.",
  },
];
---

<Layout
  seo={{
    title:
      "Udixio • Agence Web (Amiens / Le Havre) - Création de sites générateurs de leads",
    description:
      "Udixio accompagne les TPE/PME avec une approche web sur-mesure et écoresponsable axée sur l'acquisition de trafic et de croissance. Agence en Normandie et Hauts-de-France.",
  }}
  background={false}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  {/* HERO */}
  <Hero client:load className="self-stretch flex  min-h-[60vh]">
    <div class="flex-1 flex flex-col justify-between">
      <h1
        class="max-w-2xl text-display-large anim-fade anim-slide-from-left anim-duration-1000 ease-out anim-delay-100"
      >
        Pensez juste.<br />
        <span class="text-secondary">On s'occupe du reste.</span>
      </h1>

      <div class="flex gap-8 j">
        <div class="flex-1">
          <p
            class="text-body-large max-w-96 mb-12 anim-fade anim-slide-from-left anim-duration-1000 ease-out anim-delay-200"
          >
            Chez Udixio, on cadre, structure et fait avancer votre projet, sans
            complexité inutile.
          </p>

          <div class="relative group w-fit">
            <Button
              href="/contact"
              shape="squared"
              label="Obtenir un diagnostic"
              className=" w-fit"
            />
            {/* Annotation Arrow */}
            <div
              class="hidden sm:flex flex-row items-end absolute -top-8 -right-2 translate-x-full w-max pointer-events-none gap-1"
            >
              <svg
                width="32"
                height="24"
                viewBox="0 0 32 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                class="text-tertiary"
              >
                <path
                  d="M28 6 C 24 14 14 18 4 20 M 4 20 L 9 23 M 4 20 L 7 15"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
              <span class="text-tertiary -rotate-6 text-title-small mb-4 -ml-1">
                (100% Offert !)
              </span>
            </div>
          </div>

          {/* Preuve immédiate */}
          <div
            class="flex gap-3 flex-wrap mt-8 text-label-small text-on-surface-variant font-mono anim-fade anim-duration-1000 ease-out anim-delay-400"
          >
            <span>100/100 Lighthouse</span>
            <span class="text-outline-variant">·</span>
            <span>5 projets livrés</span>
            <span class="text-outline-variant">·</span>
            <span>Hauts-de-France & Normandie</span>
          </div>
        </div>
        <div
          class="flex flex-2 justify-end w-full gap-4 anim-fade anim-slide-from-right anim-duration-1000 ease-out anim-delay-400"
        >
          <Card
            className="w-2/3 p-8 bg-surface-container   flex flex-col justify-center  "
          >
            <div class="flex flex-col md:flex-row gap-4">
              {
                ["Sur-mesure", "Pensé pour durer", "Eco-responsable"].map(
                  (item) => (
                    <div class="text-label-small text-nowrap border border-outline-variant p-1 px-2 rounded-md">
                      {item}
                    </div>
                  ),
                )
              }
            </div>
            <h2 class="text-headline-medium my-2 text-on-surface">
              Un site qui génère des résultats — pas juste une présence en
              ligne.
            </h2>
            <Button variant="tonal" href="/methode" className="ml-auto"
              >Voir notre approche
            </Button>
          </Card>
        </div>
      </div>
    </div>

    <div class="absolute top-8 right-4 md:top-12 md:right-8 flex justify-end">
      <span
        class="flex items-center gap-3 text-label-small md:text-label-medium font-mono text-tertiary uppercase tracking-widest bg-white/50 backdrop-blur-sm px-4 py-2 rounded-full border border-tertiary/20 anim-fade anim-duration-1000 ease-out"
      >
        <span class="relative flex h-2 w-2">
          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-tertiary"
          ></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-tertiary"
          ></span>
        </span>
        HAUTS-DE-FRANCE
      </span>
    </div>
  </Hero>

  {/* 01. PROBLÈMES TYPIQUES */}
  <section class="py-24 bg-surface-container-low">
    <div class="section">
      <span class="sub-title anim-in anim-fade">Situations courantes</span>
      <h2
        class="text-headline-large text-on-surface mb-12 anim-in anim-fade anim-delay-150"
      >
        Ce qui bloque aujourd'hui votre projet web
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          [
            {
              icon: iVisibility,
              problem: "Votre site existe mais ne génère aucun contact",
              consequence:
                "Vous perdez des prospects chaque jour au profit de concurrents mieux positionnés.",
              cta: "Voir le service site web",
              href: "/services/site-vitrine-ou-refonte",
            },
            {
              icon: iTune,
              problem:
                "Vos process internes reposent sur des tableurs ou des outils manuels",
              consequence:
                "Vos équipes perdent du temps, font des erreurs, et votre croissance est bridée par vos outils.",
              cta: "Voir le développement sur-mesure",
              href: "/services/developpement-sur-mesure",
            },
            {
              icon: iChecklist,
              problem: "Vous avez un projet web mais pas de cadre clair",
              consequence:
                "Sans périmètre défini, les dérives de budget et de délais sont la règle, pas l'exception.",
              cta: "Demander un diagnostic",
              href: "/contact",
            },
          ].map((item, index) => (
            <Card
              variant="outlined"
              className="p-8 flex flex-col gap-6 bg-surface-container-low anim-in anim-fade anim-slide-from-bottom"
              style={{ ["--anim-delay"]: `${index * 150}ms` }}
            >
              <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center">
                <Icon icon={item.icon} className="w-6 h-6 fill-current" />
              </div>
              <div>
                <h3 class="text-headline-small text-on-surface mb-3">
                  {item.problem}
                </h3>
                <p class="text-body-large text-on-surface-variant">
                  {item.consequence}
                </p>
              </div>
              <Button
                href={item.href}
                label={item.cta}
                variant="outlined"
                className="mt-auto w-fit"
              />
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  {/* 02. Q/A - CE QUE VOUS OBTENEZ CONCRÈTEMENT */}
  <SectionPadding as="section" start client:idle>
    <Card
      className=" dark bg-surface-container-high rounded-b-none  text-on-surface shadow-xl/30 padding"
    >
      <div class="text-center mb-24 mt-8">
        <span class="sub-title anim-in anim-fade">Ce que ça change</span>
        <h2
          class="text-headline-large md:text-headline-large anim-in anim-fade anim-slide-from-bottom anim-duration-1000 anim-delay-150"
        >
          Concrètement,<br /><span class="text-gradient"
            >ce que vous obtenez</span
          >
        </h2>
        <p class="text-title-medium mt-6 anim-in anim-fade anim-delay-300">
          Quatre questions que vous vous posez — ce qu'on fait pour y répondre.
        </p>
      </div>
      <QAStickyScroll client:visible />
    </Card>
  </SectionPadding>

  {/* 03. RÉALISATIONS */}
  <section class="">
    <div class="flex section items-center justify-between mb-10">
      <h2 class="text-headline-large anim-in anim-fade anim-slide-from-left">
        Des projets réels, avec des résultats mesurables
      </h2>
      <Button
        href="/realisations"
        label="Voir nos réalisations"
        variant="tonal"
      />
    </div>
    <Realisations max={5} />
  </section>

  {/* 04. POURQUOI NOUS - MÉCANISMES CONCRETS + DUO */}
  <section class="py-32 bg-surface-container-low">
    <div class="section">
      <div class="flex flex-col md:flex-row gap-16 md:gap-32 items-start">
        <div class="md:w-1/3 sticky top-32">
          <span class="sub-title anim-in anim-fade">Pourquoi nous</span>
          <h2
            class="text-headline-large anim-in anim-fade anim-slide-from-left anim-duration-1000 anim-delay-150"
          >
            Ce qui change<br /><span class="text-gradient"
              >quand vous travaillez avec nous</span
            >
          </h2>
          <p
            class="mt-8 text-body-large max-w-xs text-on-surface-variant anim-in anim-fade anim-delay-300"
          >
            Quatre garanties concrètes, vérifiables sur chaque livraison.
          </p>
          <div class="mt-8 flex flex-col gap-3">
            {
              [
                {
                  initials: "JV",
                  name: "Joël Vigreux",
                  role: "Dev full-stack",
                  containerClass:
                    "bg-primary-container text-on-primary-container",
                },
                {
                  initials: "FV",
                  name: "Florian Vigreux",
                  role: "Conseil & cadrage",
                  containerClass:
                    "bg-secondary-container text-on-secondary-container",
                },
              ].map((person) => (
                <div class="flex items-center gap-3">
                  <div
                    class={`h-10 w-10 rounded-full flex items-center justify-center text-label-large font-bold ${person.containerClass}`}
                  >
                    {person.initials}
                  </div>
                  <div>
                    <div class="text-title-small font-bold text-on-surface">
                      {person.name}
                    </div>
                    <div class="text-label-small text-on-surface-variant">
                      {person.role}
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
          <Button
            href="/agence"
            label="Découvrir l'équipe"
            variant="outlined"
            className="mt-6 w-fit"
          />
        </div>

        <Card className="md:w-2/3 w-full p-8 md:p-12 anim-slide-from-right">
          <div class="flex flex-col gap-4 mt-4">
            {
              [
                {
                  title: "Vous échangez directement avec Joël ou Florian",
                  description:
                    "Celui qui conçoit votre site est celui à qui vous parlez. Pas de chef de projet intermédiaire, pas de perte d'information.",
                  icon: iPartnerExchange,
                },
                {
                  title: "Périmètre validé avant toute ligne de code",
                  description:
                    "Un document de cadrage est rédigé et partagé avant tout démarrage. Rien n'avance sans votre accord explicite.",
                  icon: iChecklist,
                },
                {
                  title: "Scores Lighthouse 100/100 sur nos livrables",
                  description:
                    "Performance, SEO, accessibilité : des résultats mesurables, vérifiables sur chaque réalisation publiée.",
                  icon: iVerifiedUser,
                },
                {
                  title: "Git, hébergement et CMS remis à la livraison",
                  description:
                    "Dépôt Git, accès admin, hébergement documenté — tout vous appartient sans condition dès la mise en ligne.",
                  icon: iKey,
                },
              ].map((feature, index) => (
                <div
                  style={{ ["--anim-delay"]: `${100 * index}ms` }}
                  class="group flex gap-6 items-start p-4 rounded-2xl anim-in-fade anim-slide-from-right anim-duration-1000 anim-delay-200"
                >
                  <div class="p-4 aspect-square rounded-xl bg-surface-container-highest text-on-surface-variant flex items-center justify-center">
                    <Icon className="size-8" icon={feature.icon} />
                  </div>
                  <div>
                    <h3 class="text-headline-small text-on-surface mb-1">
                      {feature.title}
                    </h3>
                    <p class="text-body-medium text-on-surface-variant">
                      {feature.description}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </Card>
      </div>
    </div>
  </section>

  {/* 05. POUR QUI */}
  <section class="section py-24 bg-surface-container-low">
    <div class="max-width padding-x">
      <div class="text-center mb-12">
        <span class="sub-title anim-in anim-fade">Pour qui</span>
        <h2
          class="text-headline-large text-on-surface anim-in anim-fade anim-delay-150"
        >
          Les profils pour lesquels ça fonctionne vraiment
        </h2>
        <p
          class="text-title-medium text-on-surface-variant mt-4 max-w-2xl mx-auto anim-in anim-fade anim-delay-300"
        >
          Nous travaillons avec des structures qui ont un besoin précis et
          veulent un partenaire qui cadre, livre et explique.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          [
            {
              icon: iStorefront,
              title: "TPE, artisans & commerçants locaux",
              description:
                "Vous avez besoin d'un site professionnel qui vous apporte des clients. Pas de jargon, pas de complexité inutile.",
              containerClass: "bg-tertiary-container",
              iconClass: "fill-on-tertiary-container",
            },
            {
              icon: iGroups,
              title: "PME en croissance",
              description:
                "Votre site actuel ne reflète plus votre niveau. Vous voulez un outil évolutif, sans dépendance à un prestataire opaque.",
              containerClass: "bg-primary-container",
              iconClass: "fill-on-primary-container",
            },
            {
              icon: iRocketLaunch,
              title: "Porteurs de projets digitaux",
              description:
                "Vous lancez un produit, une plateforme ou un service. Vous avez besoin d'un partenaire technique qui cadre et livre.",
              containerClass: "bg-secondary-container",
              iconClass: "fill-on-secondary-container",
            },
          ].map((persona, index) => (
            <div
              class="bg-surface-container rounded-3xl border border-outline-variant/40 p-8 flex flex-col items-center gap-5 text-center anim-in anim-fade anim-slide-from-bottom"
              style={{ ["--anim-delay"]: `${index * 150}ms` }}
            >
              <div
                class={`w-16 h-16 rounded-full flex items-center justify-center ${persona.containerClass}`}
              >
                <Icon
                  icon={persona.icon}
                  className={`w-8 h-8 ${persona.iconClass}`}
                />
              </div>
              <div>
                <h3 class="text-headline-small mb-2">{persona.title}</h3>
                <p class="text-body-medium text-on-surface-variant">
                  {persona.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* 06. PRIX RÉSUMÉ */}
  <section class="py-12 bg-surface">
    <div class="section">
      <div
        class="flex flex-wrap items-center justify-between gap-4 bg-surface-container rounded-2xl p-6 border border-outline-variant/30"
      >
        <div class="flex flex-wrap gap-6 font-mono text-body-medium">
          <span
            >Site vitrine <strong class="text-primary">dès 2 500€</strong></span
          >
          <span class="text-outline-variant">·</span>
          <span>Application <strong>dès 5 000€</strong></span>
          <span class="text-outline-variant">·</span>
          <span>Frais cachés <strong class="text-primary">0€</strong></span>
        </div>
        <Button
          href="/services"
          label="Voir le détail des tarifs"
          variant="outlined"
          className="shrink-0"
        />
      </div>
    </div>
  </section>

  {/* 07. FAQ */}
  <FaqSection
    title="Les points à clarifier avant de démarrer"
    description="Trois questions fréquentes — avec des réponses directes."
    items={faqItems}
  />

  {/* 08. CTA FINAL */}
  <CtaSection
    title="On cadre votre projet en 30 minutes"
    description="Décrivez-nous votre besoin, on vous répond avec un premier retour concret — et un périmètre clair dès le départ."
    primaryLabel="Demander un diagnostic"
    primaryHref="/contact"
    secondaryLabel="Voir nos services"
    secondaryHref="/services"
  />
</Layout>
