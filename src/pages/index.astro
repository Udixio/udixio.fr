---
import Layout from "@layouts/Layout.astro";
import { Button, Icon } from "@udixio/ui-react";
import { Hero } from "@components/Hero.tsx";
import Realisations from "@components/Realisations.astro";
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import {
  StickyScroll,
  type StickyScrollItem,
} from "@components/sticky-scroll-reveal";

import imgContract from "@assets/images/project estimate contract signing desk pen.avif";
import imgTeam from "@assets/images/team collaboration laptop kanban board progress.avif";
import imgPerformance from "@assets/images/web analytics dashboard speed performance charts laptop  .avif";
import imgIndependence from "@assets/images/person hands laptop keyboard ownership freedom workspace.avif";

const [optContract, optTeam, optPerformance, optIndependence] =
  await Promise.all([
    getImage({ src: imgContract, format: "avif", width: 800 }),
    getImage({ src: imgTeam, format: "avif", width: 800 }),
    getImage({ src: imgPerformance, format: "avif", width: 800 }),
    getImage({ src: imgIndependence, format: "avif", width: 800 }),
  ]);

const stickyScrollItems: StickyScrollItem[] = [
  {
    title: "Périmètre défini, devis précis",
    description:
      "Un atelier initial permet de cadrer le projet et fixer un devis ferme avant tout développement. Pas de mauvaise surprise sur la facture finale.",
    imageSrc: optContract.src,
    imageAlt: "Périmètre et devis",
  },
  {
    title: "Suivi clair à chaque étape",
    description:
      "Vous suivez l'avancement en temps réel, validez chaque étape et comprenez les décisions prises — sans jargon, sans zone d'ombre.",
    imageSrc: optTeam.src,
    imageAlt: "Suivi de projet",
  },
  {
    title: "Performance et SEO solides",
    description:
      "Chaque choix technique vise un site rapide, bien référencé et durable — Lighthouse 100/100 comme objectif de base, pas comme exception.",
    imageSrc: optPerformance.src,
    imageAlt: "Performance et SEO",
  },
  {
    title: "Contrôle total sur votre site",
    description:
      "Accès complet, code source livré, hébergement à votre main : vous restez indépendant après la livraison, sans abonnement imposé.",
    imageSrc: optIndependence.src,
    imageAlt: "Indépendance et contrôle",
  },
];
import FaqSection from "@components/sections/FaqSection.astro";
import CtaSection from "@components/sections/CtaSection.astro";
import { Card } from "@/components/Card";
import { SectionPadding } from "@/components/SectionPadding";
import { AnimatedCounter } from "@/components/home/AnimatedCounter";
import { ShowcaseHero } from "@/components/home/modern/ShowcaseHero";
import type { ProjectProps } from "@/components/project/Project";

import { iPartnerExchange } from "@udixio/icons-rounded-400/partner_exchange";
import { iChecklist } from "@udixio/icons-rounded-400/checklist";
import { iVerifiedUser } from "@udixio/icons-rounded-400/verified_user";
import { iKey } from "@udixio/icons-rounded-400/key";
import { iVisibility } from "@udixio/icons-rounded-400/visibility";
import { iTune } from "@udixio/icons-rounded-400/tune";
import { iStorefront } from "@udixio/icons-rounded-400/storefront";
import { iGroups } from "@udixio/icons-rounded-400/groups";
import { iRocketLaunch } from "@udixio/icons-rounded-400/rocket_launch";
import { iArrowRight } from "@udixio/icons-rounded-400/arrow_right";

const realisations = await getCollection("realisation");
realisations.sort(
  (a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity),
);
const firstProjectSourceColor =
  realisations[0]?.data?.images?.background?.sourceColor;

const showcaseProjects: ProjectProps[] = realisations.slice(0, 10).map((r) => ({
  slug: r.id,
  ...r.data,
  images: {
    ...r.data.images,
    background: r.data.images.background!,
  },
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.udixio.fr/#organization",
      name: "Udixio",
      description:
        "Agence web spécialisée en création de sites performants et écoresponsables pour TPE/PME en Hauts-de-France et Normandie. Développement sur-mesure, SEO technique et stratégie digitale.",
      url: "https://www.udixio.fr/",
      logo: "https://www.udixio.fr/images/logo.png",
      image: "https://www.udixio.fr/images/logo.png",
      sameAs: [
        "https://www.linkedin.com/company/udixio",
        "https://github.com/Udixio",
      ],
      knowsAbout: [
        "Création de site web",
        "Développement web sur-mesure",
        "SEO technique",
        "Éco-conception numérique",
        "Astro",
        "React",
        "Stratégie digitale",
        "Performance web",
        "Accessibilité WCAG",
      ],
      contactPoint: {
        "@type": "ContactPoint",
        email: "florian@udixio.fr",
        contactType: "customer service",
      },
    },
    {
      "@type": "LocalBusiness",
      "@id": "https://www.udixio.fr/#localbusiness",
      name: "Udixio",
      url: "https://www.udixio.fr/",
      email: "florian@udixio.fr",
      telephone: "+33647235448",
      image: "https://www.udixio.fr/images/logo.png",
      priceRange: "$$",
      openingHoursSpecification: [
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          opens: "09:00",
          closes: "18:00",
        },
      ],
      address: [
        {
          "@type": "PostalAddress",
          addressLocality: "Amiens",
          addressRegion: "Hauts-de-France",
          addressCountry: "FR",
        },
        {
          "@type": "PostalAddress",
          addressLocality: "Le Havre",
          addressRegion: "Normandie",
          addressCountry: "FR",
        },
      ],
    },
  ],
};

const faqItems = [
  {
    question: "Combien ça coûte ?",
    answer:
      "À partir de 2 500€ pour un site vitrine. Chaque projet démarre par une estimation gratuite, après un échange sur votre besoin.",
  },
  {
    question: "Suis-je propriétaire du site ?",
    answer:
      "Oui. Code source, hébergement et accès CMS sont remis à la livraison — sans condition et sans dépendance à notre infrastructure.",
  },
  {
    question: "En combien de temps ?",
    answer:
      "4 à 8 semaines pour un site vitrine selon le périmètre. Un planning détaillé est fourni dès la phase de cadrage.",
  },
];
---

<Layout
  seo={{
    title:
      "Udixio • Agence Web (Amiens / Le Havre) - Création de sites générateurs de leads",
    description:
      "Udixio accompagne les TPE/PME avec une approche web sur-mesure et écoresponsable axée sur l'acquisition de trafic et de croissance. Agence en Normandie et Hauts-de-France.",
  }}
  background={false}
  defaultSourceColor={firstProjectSourceColor}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="relative">
    <Hero client:idle className="self-stretch flex flex-col min-h-[65vh]">
      {/* Headline - full width, massive */}
      <h1 class="mb-6 md:mb-12 text-display-large">
        <span class="text-gradient">Agence web</span><br />
        au
        <span class=""> Havre </span>et <span class=""> Amiens </span>
      </h1>

      {/* Two-column: copy + card */}
      <div class="flex flex-col md:flex-row gap-10 md:gap-16 flex-1">
        {/* LEFT — Copy + CTA */}
        <div class="flex flex-col gap-8 md:max-w-md justify-center self-start">
          <p class="text-body-large text-on-surface-variant">
            Chez Udixio, on vous accompagne dans la création de vos projets
            digitaux avec une approche claire, structurée et sans complexité
            inutile.
          </p>

          <div
            class="relative group w-fit anim-fade anim-duration-700 ease-out anim-delay-500"
          >
            <Button
              href="/contact"
              label="Obtenir un diagnostic"
              className="w-fit"
            />
            <div
              class="hidden sm:flex flex-row items-end absolute -top-8 -right-2 translate-x-full w-max pointer-events-none gap-1"
            >
              <svg
                width="32"
                height="24"
                viewBox="0 0 32 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                class="text-tertiary"
              >
                <path
                  d="M28 6 C 24 14 14 18 4 20 M 4 20 L 9 23 M 4 20 L 7 15"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
              <span class="text-tertiary -rotate-6 text-title-small mb-4 -ml-1">
                (100% Offert !)
              </span>
            </div>
          </div>
        </div>
      </div>
    </Hero>
    {/* RIGHT — Hero showcase synchronisé via nanoStore */}
    <div
      id="showcase-hero-portal"
      class="absolute bottom-0 section inset-x-0 h-1/2 pointer-events-none"
    >
      <ShowcaseHero projects={showcaseProjects} client:idle />
    </div>
  </div>
  {
    /* ═══════════════════════════════════════════
      04 · RÉALISATIONS
  ═══════════════════════════════════════════ */
  }
  <section class="pt-28 pb-12">
    <div class="section pb-0">
      <div
        class="flex flex-col md:flex-row items-start md:items-end justify-between gap-6 mb-12"
      >
        <div>
          <span class="sub-title anim-in anim-fade">Nos réalisations</span>
          <h2
            class="text-headline-large max-w-xl anim-in anim-fade anim-slide-from-left anim-duration-700 anim-delay-150"
          >
            Des projets réels,<br /><span class="text-gradient"
              >des résultats mesurables</span
            >
          </h2>
        </div>
      </div>
      <div class="flex-3 relative h-[500px]">
        <div
          class="absolute h-full right-0 w-screen max-w-[calc(50vw+50%-2rem)]"
        >
          <div>
            <Realisations max={10} />
          </div>
        </div>
      </div>

      <div class="relative flex pr-12 mt-48">
        <Card className="flex group      justify-evenly gap-8 p-12">
          <div class="flex-1 flex flex-col gap-8 justify-between">
            <div>
              <p class="text-headline-medium">
                Et si le prochain projet, était le vôtre ?
              </p>
              <p class="mt-4">
                Un site web de qualité transforme votre visibilité en
                opportunités, attire des clients et soutient durablement votre
                croissance.
              </p>
            </div>

            <Button
              href="/contact"
              label="Lancer mon projet"
              icon={iArrowRight}
              iconPosition="right"
            />
          </div>

          <div
            class="grid flex-1 border-t-2 border-dashed border-outline-variant md:border-t-0 md:border-l-2"
          >
            {
              [
                {
                  value: "+87%",
                  description: "Acquisition continue de nouveaux clients",
                },
                {
                  value: "×5%",
                  description: "Accélération de la croissance commerciale",
                },
                {
                  value: "+14,2%",
                  description: "Gain de productivité au quotidien",
                },
              ].map(({ value, description }) => (
                <div class="border-b-2 border-dashed border-outline-variant p-6 last:border-0">
                  <>
                    <p class="text-headline-medium fi text-primary">{value}</p>
                    <p class="">{description}</p>
                  </>
                </div>
              ))
            }
          </div>
        </Card>
        <div
          style="transform: translateX(100%)"
          class="absolute bottom-0 right-0 -rotate-90 origin-bottom-right"
        >
          <a
            href="https://www.intracen.org/file/itcsmeco2025pdf"
            target="_blank"
            rel="noopener noreferrer"
            title="Rapport mondial sur la compétitivité des PME (ITC - Nations Unies)"
            class="text-body-small whitespace-nowrap text-outline translate-y-full"
          >
            DONNÉES : ITC (ONU / OMC)
          </a>
        </div>
      </div>
    </div>

    <div class="section pt-0"></div>
  </section>
  <section class="py-28">
    <div class="section">
      <span class="sub-title anim-in anim-fade">Situations courantes</span>
      <h2
        class="text-headline-large text-on-surface mb-16 max-w-2xl anim-in anim-fade anim-slide-from-left anim-duration-700 anim-delay-150"
      >
        Ce qui bloque<br /><span class="text-gradient">votre projet web</span>
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-5 md:grid-rows-2 gap-6">
        {/* Card 1 — Large, spans 2 rows */}
        <Card
          className="relative md:col-span-2 md:row-span-2 p-10 md:p-12 flex flex-col gap-8  anim-in anim-fade anim-slide-from-bottom"
        >
          <div class="relative z-10 flex flex-col gap-6 h-full">
            <div
              class="w-14 h-14 rounded-2xl bg-primary/10 text-primary flex items-center justify-center"
            >
              <Icon icon={iVisibility} className="w-7 h-7 fill-current" />
            </div>
            <div class="flex-1">
              <h3 class="text-headline-medium text-on-surface mb-4">
                Votre site existe mais ne génère aucun contact
              </h3>
              <p class="text-body-large text-on-surface-variant max-w-lg">
                Vous perdez des prospects chaque jour au profit de concurrents
                mieux positionnés. Un site qui ne convertit pas est un coût, pas
                un investissement.
              </p>
            </div>
            <Button
              href="/services/site-vitrine-ou-refonte"
              label="Voir le service site web"
              variant="outlined"
              className="w-fit"
            />
          </div>
        </Card>

        {/* Card 2 */}
        <Card
          className="relative  md:col-span-3 p-8 flex flex-col gap-6   anim-in anim-fade anim-slide-from-bottom anim-delay-150"
        >
          <div class="relative z-10 flex flex-col gap-4 h-full">
            <div
              class="w-12 h-12 rounded-xl bg-tertiary/10 text-tertiary flex items-center justify-center"
            >
              <Icon icon={iTune} className="w-6 h-6 fill-current" />
            </div>
            <h3 class="text-headline-small text-on-surface">
              Vos process reposent sur des outils manuels
            </h3>
            <p class="text-body-medium text-on-surface-variant">
              Tableurs, copier-coller, emails : votre croissance est bridée par
              vos outils.
            </p>
            <Button
              href="/services/developpement-sur-mesure"
              label="Développement sur-mesure"
              variant="outlined"
              className="w-fit mt-auto"
            />
          </div>
        </Card>

        {/* Card 3 */}
        <Card
          className="relative md:col-span-3 p-8 flex flex-col gap-6 duration-500 anim-in anim-fade anim-slide-from-bottom anim-delay-300"
        >
          <div class="relative z-10 flex flex-col gap-4 h-full">
            <div
              class="w-12 h-12 rounded-xl bg-secondary/10 text-secondary flex items-center justify-center"
            >
              <Icon icon={iChecklist} className="w-6 h-6 fill-current" />
            </div>
            <h3 class="text-headline-small text-on-surface">
              Vous avez un projet mais pas de cadre clair
            </h3>
            <p class="text-body-medium text-on-surface-variant">
              Sans périmètre défini, les dérives de budget et de délais sont la
              règle.
            </p>
            <Button
              href="/contact"
              label="Demander un diagnostic"
              variant="outlined"
              className="w-fit mt-auto"
            />
          </div>
        </Card>
      </div>
    </div>
  </section>

  {
    /* ═══════════════════════════════════════════
      03 · CE QUE VOUS OBTENEZ — Q/A Sticky Scroll
  ═══════════════════════════════════════════ */
  }
  <SectionPadding as="section" start client:idle>
    <Card
      className="dark bg-surface-container-low rounded-b-none text-on-surface shadow-xl/30"
    >
      <div class="section">
        <div class="text-center mb-24 mt-8">
          <span class="sub-title text-center anim-in anim-fade"
            >Ce que ça change</span
          >
          <h2
            class="text-display-small anim-in anim-fade anim-slide-from-bottom anim-duration-700 anim-delay-150"
          >
            Concrètement,<br /><span class="text-gradient"
              >ce que vous obtenez</span
            >
          </h2>
          <p
            class="text-title-medium text-on-surface-variant mt-6 max-w-xl mx-auto anim-in anim-fade anim-delay-300"
          >
            Quatre questions que vous vous posez — et ce qu'on fait pour y
            répondre.
          </p>
        </div>
        <StickyScroll items={stickyScrollItems} client:visible />
      </div>
    </Card>
  </SectionPadding>

  {
    /* ═══════════════════════════════════════════
      05 · POURQUOI NOUS — Bento Grid + Team
  ═══════════════════════════════════════════ */
  }
  <section class="py-28 bg-surface-container-low">
    <div class="section">
      <div class="text-center mb-16">
        <span class="sub-title text-center anim-in anim-fade"
          >Pourquoi nous</span
        >
        <h2
          class="text-headline-large anim-in anim-fade anim-slide-from-bottom anim-duration-700 anim-delay-150"
        >
          Ce qui change<br /><span class="text-gradient"
            >quand vous travaillez avec nous</span
          >
        </h2>
        <p
          class="text-title-medium text-on-surface-variant mt-6 max-w-xl mx-auto anim-in anim-fade anim-delay-300"
        >
          Quatre garanties concrètes, vérifiables sur chaque livraison.
        </p>
      </div>

      {/* Bento Grid */}
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {/* Feature 1 — Wide */}
        <Card
          className="md:col-span-2 p-10 md:p-12 flex flex-col gap-6   anim-in anim-fade anim-slide-from-bottom"
        >
          <div
            class="w-14 h-14 rounded-2xl bg-primary/10 text-primary flex items-center justify-center"
          >
            <Icon icon={iPartnerExchange} className="w-7 h-7 fill-current" />
          </div>
          <h3 class="text-headline-medium text-on-surface">
            Vous échangez directement avec Joël ou Florian
          </h3>
          <p class="text-body-large text-on-surface-variant max-w-lg">
            Celui qui conçoit votre site est celui à qui vous parlez. Pas de
            chef de projet intermédiaire, pas de perte d'information. Chaque
            décision est claire et partagée.
          </p>
        </Card>

        {/* Feature 2 — Square */}
        <Card
          className="p-10 flex flex-col gap-6 group  anim-in anim-fade anim-slide-from-bottom anim-delay-150"
        >
          <div
            class="w-14 h-14 rounded-2xl bg-tertiary/10 text-tertiary flex items-center justify-center"
          >
            <Icon icon={iChecklist} className="w-7 h-7 fill-current" />
          </div>
          <h3 class="text-headline-small text-on-surface">
            Périmètre validé avant toute ligne de code
          </h3>
          <p class="text-body-medium text-on-surface-variant">
            Un document de cadrage est rédigé et partagé. Rien n'avance sans
            votre accord explicite.
          </p>
        </Card>

        {/* Feature 3 — Square */}
        <Card
          className="p-10 flex flex-col gap-6 group anim-in anim-fade anim-slide-from-bottom anim-delay-200"
        >
          <div
            class="w-14 h-14 rounded-2xl bg-primary/10 text-primary flex items-center justify-center"
          >
            <Icon icon={iVerifiedUser} className="w-7 h-7 fill-current" />
          </div>
          <h3 class="text-headline-small text-on-surface">
            Scores Lighthouse 100/100
          </h3>
          <p class="text-body-medium text-on-surface-variant">
            Performance, SEO, accessibilité : des résultats mesurables,
            vérifiables sur chaque réalisation.
          </p>
        </Card>

        {/* Feature 4 — Wide */}
        <Card
          className="md:col-span-2 p-10 md:p-12 flex flex-col gap-6 group  anim-in anim-fade anim-slide-from-bottom anim-delay-300"
        >
          <div
            class="w-14 h-14 rounded-2xl bg-secondary/10 text-secondary flex items-center justify-center"
          >
            <Icon icon={iKey} className="w-7 h-7 fill-current" />
          </div>
          <h3 class="text-headline-medium text-on-surface">
            Git, hébergement et CMS remis à la livraison
          </h3>
          <p class="text-body-large text-on-surface-variant max-w-lg">
            Dépôt Git, accès admin, hébergement documenté — tout vous appartient
            sans condition dès la mise en ligne. Zéro dépendance.
          </p>
        </Card>
      </div>

      {/* Team Strip */}
      <div
        class="mt-16 flex flex-col sm:flex-row items-center justify-center gap-8 anim-in anim-fade anim-slide-from-bottom anim-delay-200"
      >
        <div class="flex items-center gap-4">
          <div
            class="h-12 w-12 rounded-full flex items-center justify-center text-label-large font-bold bg-primary-container text-on-primary-container"
          >
            JV
          </div>
          <div>
            <div class="text-title-small font-bold text-on-surface">
              Joël Vigreux
            </div>
            <div class="text-label-small text-on-surface-variant">
              Dev full-stack
            </div>
          </div>
        </div>

        <div class="hidden sm:block w-px h-10 bg-outline-variant/40 rotate-12">
        </div>

        <div class="flex items-center gap-4">
          <div
            class="h-12 w-12 rounded-full flex items-center justify-center text-label-large font-bold bg-secondary-container text-on-secondary-container"
          >
            FV
          </div>
          <div>
            <div class="text-title-small font-bold text-on-surface">
              Florian Vigreux
            </div>
            <div class="text-label-small text-on-surface-variant">
              Conseil & cadrage
            </div>
          </div>
        </div>

        <Button
          href="/agence"
          label="Découvrir l'équipe"
          variant="outlined"
          className="w-fit"
        />
      </div>
    </div>
  </section>

  {
    /* ═══════════════════════════════════════════
      06 · POUR QUI
  ═══════════════════════════════════════════ */
  }
  <section class="py-28">
    <div class="section">
      <div class="text-center mb-16">
        <span class="sub-title text-center anim-in anim-fade">Pour qui</span>
        <h2
          class="text-headline-large anim-in anim-fade anim-slide-from-bottom anim-duration-700 anim-delay-150"
        >
          Les profils pour lesquels<br /><span class="text-gradient"
            >ça fonctionne vraiment</span
          >
        </h2>
        <p
          class="text-title-medium text-on-surface-variant mt-6 max-w-2xl mx-auto anim-in anim-fade anim-delay-300"
        >
          Nous travaillons avec des structures qui ont un besoin précis et
          veulent un partenaire qui cadre, livre et explique.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          [
            {
              icon: iStorefront,
              title: "TPE, artisans & commerçants",
              description:
                "Vous avez besoin d'un site professionnel qui vous apporte des clients. Pas de jargon, pas de complexité inutile.",
              accent: "primary",
              bgClass: "bg-primary/8",
              iconClass: "bg-primary-container text-on-primary-container",
            },
            {
              icon: iGroups,
              title: "PME en croissance",
              description:
                "Votre site actuel ne reflète plus votre niveau. Vous voulez un outil évolutif, sans dépendance à un prestataire opaque.",
              accent: "tertiary",
              bgClass: "bg-tertiary/8",
              iconClass: "bg-tertiary-container text-on-tertiary-container",
            },
            {
              icon: iRocketLaunch,
