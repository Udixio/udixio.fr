---
import Layout from "@layouts/Layout.astro";
import {Button} from "@udixio/ui-react";
import {Hero} from "@components/home/Hero.tsx";
import Realisations from "@components/Realisations.astro";
import {FeaturesGrid} from "@components/home/modern/FeaturesGrid";
// import { ValueProp } from "@components/home/modern/ValueProp";
import {ProblemSolutionSchema} from "@components/home/modern/ProblemSolutionSchema";
// import { MethodSteps } from "@components/home/modern/MethodSteps";
import {ProcessStickyScroll} from "@components/home/modern/ProcessStickyScroll";
import {ProofsGrid} from "@components/home/modern/ProofsGrid";
import {FaqAccordion} from "@components/home/modern/FaqAccordion";

const faqItems = [
    {
        question: "Quel budget prévoir pour un site sur-mesure ?",
        answer:
            "Après un cadrage offert, nous remettons un devis détaillé avec inclus/exclus et options. Vous comprenez ce qui est prévu avant de lancer la production.",
    },
    {
        question: "Comment suivez-vous l'avancement ?",
        answer:
            "Vous avez accès au suivi du projet et à des points réguliers. Chaque décision est expliquée simplement pour garder la main.",
    },
    {
        question: "Serai-je propriétaire de mon site ?",
        answer:
            "Oui. Code source, accès et données vous appartiennent. Nous privilégions des technologies ouvertes et une documentation claire.",
    },
    {
        question: "Comment gérez-vous les délais ?",
        answer:
            "Le planning est défini dès le cadrage avec des jalons de validation. En cas d'ajustement, on en parle tout de suite.",
    },
    {
        question: "Que se passe-t-il après la mise en ligne ?",
        answer:
            "Une phase d'hypercare est prévue pour le démarrage, puis une formation pour vous rendre autonome. La maintenance évolutive reste possible.",
    },
];
---

<Layout
        seo={{
            title: "Clarté & Maîtrise pour votre site web • Udixio",
            description:
                "Udixio structure vos projets digitaux : méthode claire, transparence, sobriété et autonomie durable.",
        }}
        background={false}
>
    <Hero client:idle>
        <div class="max-width relative z-0">
            <div class="absolute right-0 -bottom-8 max-w-[80vw]"></div>
        </div>
    </Hero>

    <section class="section">
        <div class="max-width padding-x">
            <h2 class="text-display-small text-center md:text-left">
                Les freins qui ralentissent vos projets web
            </h2>
            <div
                    class="text-body-large mt-6 max-w-prose space-y-4 text-center md:text-left"
            >
                <p>
                    Beaucoup de projets échouent par manque de clarté : périmètre qui
                    s'étire, décisions floues, et autonomie limitée. Le frein principal
                    n'est pas la technique, mais l'absence de méthode partagée.
                </p>
            </div>

            <FeaturesGrid client:visible/>

            <div class="mt-12 flex justify-center md:justify-start">
                <Button
                        variant="outlined"
                        href="/services"
                        label="Découvrir comment on travaille"
                />
            </div>
        </div>
    </section>

    <section class="section bg-surface-container-lowest py-24">
        <div class="max-width padding-x">
            <h2 class="text-display-small text-center mb-8">
                Notre réponse : claire et structurée
            </h2>
            <p class="text-body-large max-w-2xl mx-auto text-center mb-12">
                Survolez les cartes pour voir comment nous répondons, étape par étape.
            </p>

            <ProblemSolutionSchema client:visible/>
        </div>
    </section>

    <section class="section">
        <div class="max-width padding-x">
            <h2 class="text-display-small text-center md:text-left mb-12">
                Nos preuves concrètes
            </h2>
            <ProofsGrid client:visible/>

            <div class="mt-12 flex justify-center md:justify-start">
                <Button
                        className="w-fit"
                        href="/realisations"
                        label="Voir des exemples de réalisations"
                />
            </div>
        </div>
    </section>

    <section class="section bg-surface-container-lowest py-24">
        <div class="max-width padding-x">
            <div class="mb-12 text-center md:text-left">
                <h2 class="text-display-small">Un processus clair</h2>
                <p class="text-body-large mt-4 max-w-prose">
                    5 étapes, une feuille de route lisible. La méthode sécurise le
                    planning et la qualité sans promesses irréalistes.
                </p>
            </div>

            <ProcessStickyScroll client:visible/>

            <div class="mt-8 flex justify-center">
                <Button
                        className="w-fit"
                        href="/methode"
                        label="Comprendre notre méthode en détail"
                />
            </div>
        </div>
    </section>

    <section class="section">
        <div class="max-width padding-x">
            <h2 class="text-display-small mb-12">Réalisations récentes</h2>

            <Realisations max={4}/>

            <div class="mt-12 flex justify-center">
                <Button
                        variant="outlined"
                        href="/realisations"
                        label="Voir tout le portfolio"
                />
            </div>
        </div>
    </section>

    <section class="section bg-surface-container-lowest py-24">
        <div class="max-width padding-x">
            <div
                    class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6"
            >
                <div class="max-w-2xl">
                    <h2 class="text-display-small mb-4">Engagements clairs</h2>
                    <p class="text-body-large text-on-surface-variant">
                        Des règles simples pour éviter les zones d'ombre et garder le
                        contrôle à chaque étape.
                    </p>
                </div>
                <Button
                        variant="outlined"
                        href="/services"
                        label="Voir nos services"
                />
            </div>

            <div class="grid gap-6 md:grid-cols-3">
                {
                    [
                        {
                            title: "Devis détaillé",
                            cat: "Transparence",
                            desc: "Inclus et exclus clairement listés, options chiffrées dès le départ.",
                            href: "/services",
                        },
                        {
                            title: "Suivi partagé",
                            cat: "Clarté",
                            desc: "Accès au tableau de bord et points réguliers pour décider ensemble.",
                            href: "/methode",
                        },
                        {
                            title: "Autonomie client",
                            cat: "Propriété",
                            desc: "Code source, accès et formation pour reprendre la main après livraison.",
                            href: "/methode",
                        },
                    ].map((resource) => (
                            <a
                                    href={resource.href}
                                    class="group block p-8 rounded-3xl bg-surface border border-outline-variant/50 hover:border-primary/50 transition-colors"
                            >
              <span class="inline-block px-3 py-1 rounded-full bg-primary/10 text-primary text-label-small font-bold mb-4">
                {resource.cat}
              </span>
                                <h3 class="text-title-large font-bold mb-3 group-hover:text-primary transition-colors">
                                    {resource.title}
                                </h3>
                                <p class="text-body-medium text-on-surface-variant">
                                    {resource.desc}
                                </p>
                            </a>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="section bg-surface-container-lowest py-24">
        <div class="max-width padding-x">
            <div
                    class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6"
            >
                <div class="max-w-2xl">
                    <h2 class="text-display-small mb-4">Ressources pour cadrer</h2>
                    <p class="text-body-large text-on-surface-variant">
                        Des contenus courts et utiles pour avancer sereinement, avant
                        même de lancer votre projet.
                    </p>
                </div>
                <Button
                        variant="outlined"
                        href="/blog"
                        label="Voir toutes les ressources"
                />
            </div>

            <div class="grid gap-6 md:grid-cols-3">
                {
                    [
                        {
                            title: "Cadrer votre besoin",
                            cat: "Méthode",
                            desc: "Les questions essentielles pour clarifier objectifs, périmètre et priorités.",
                            href: "/blog",
                        },
                        {
                            title: "Refonte sereine",
                            cat: "Stratégie",
                            desc: "Les points de vigilance pour éviter les dérives et garder un cap clair.",
                            href: "/blog",
                        },
                        {
                            title: "SEO expliqué simplement",
                            cat: "Clarté",
                            desc: "Les bases du référencement, sans jargon, pour prendre les bonnes décisions.",
                            href: "/blog",
                        },
                    ].map((resource) => (
                            <a
                                    href={resource.href}
                                    class="group block p-8 rounded-3xl bg-surface border border-outline-variant/50 hover:border-primary/50 transition-colors"
                            >
              <span class="inline-block px-3 py-1 rounded-full bg-primary/10 text-primary text-label-small font-bold mb-4">
                {resource.cat}
              </span>
                                <h3 class="text-title-large font-bold mb-3 group-hover:text-primary transition-colors">
                                    {resource.title}
                                </h3>
                                <p class="text-body-medium text-on-surface-variant">
                                    {resource.desc}
                                </p>
                            </a>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="section bg-surface-container-high py-24">
        <div class="max-width padding-x">
            <h2 class="text-display-small text-center mb-12">
                Questions fréquentes (sans tabou)
            </h2>
            <FaqAccordion client:visible items={faqItems}/>
        </div>
    </section>

    <section class="section">
        <div class="max-width padding-x">
            <div
                    class="rounded-3xl bg-primary text-on-primary p-8 md:p-16 text-center md:text-left overflow-hidden relative"
            >
                <div
                        class="absolute top-0 right-0 w-64 h-64 bg-white/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3"
                >
                </div>

                <div class="relative z-10 grid gap-8 md:grid-cols-2 items-center">
                    <div>
                        <h2 class="text-display-medium mb-6">
                            Besoin d'y voir plus clair ?
                        </h2>
                        <p class="text-body-large opacity-90 mb-8 max-w-lg">
                            Chaque projet commence par une conversation. Racontez-nous vos
                            enjeux, nous vous dirons clairement si nous sommes l'agence qu'il
                            vous faut (et sinon, on vous l'expliquera).
                        </p>
                    </div>
                    <div
                            class="flex flex-col sm:flex-row gap-4 justify-center md:justify-end"
                    >
                        <Button
                                className="bg-white text-primary hover:bg-white/90"
                                href="/contact"
                                label="Demander un diagnostic offert"
                        />
                        <Button
                                variant="outlined"
                                className="border-white text-white hover:bg-white/10"
                                href="/services"
                                label="Voir nos services"
                        />
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>
