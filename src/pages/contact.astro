---
import Layout from "@layouts/Layout.astro";
import {FormContact} from "@components/FormContact";
import {Button} from "@udixio/ui-react";
import Faq from "@components/sections/Faq.astro";

const faqItems = [
    {
        question: "Que se passe-t-il après l'envoi ?",
        answer: "Nous revenons vers vous rapidement pour clarifier le besoin et proposer un cadre d'échange. Pas de pression commerciale.",
    },
    {
        question: "Faut-il un brief complet ?",
        answer: "Non. Quelques éléments suffisent : objectifs, contexte, contraintes. On vous aide à structurer le reste.",
    },
    {
        question: "Est-ce que vous répondez vite ?",
        answer: "Oui. En général sous 1 jour ouvré.",
    },
    {
        question: "Je préfère un échange direct, c'est possible ?",
        answer: "Oui, vous pouvez nous écrire ou nous appeler. Le formulaire est là pour vous simplifier la vie, pas pour vous enfermer.",
    },
];
---

<Layout seo={{
    title: "Contact — un échange clair et cadré • Udixio",
    description: "Parlez-nous de votre projet : on clarifie le besoin, puis on vous propose un cadre simple.",
}}>
    <section class="section">
        <div class="max-width padding-x">
            <h1 class="text-display-small md:text-display-large">Parlons de votre projet</h1>
            <h2 class="text-headline-medium mt-8">Un échange clair, sans jargon</h2>
            <div class="text-body-large mt-6 max-w-prose space-y-4">
                <p>Décrivez votre contexte, vos objectifs et vos contraintes. Nous vous aidons à cadrer le reste.</p>
                <p>Vous recevrez un retour rapide pour organiser un échange utile.</p>
            </div>
            <div id="contact-form" class="mt-8">
                <FormContact client:only="react" />
            </div>
            <div class="text-body-large mt-8 max-w-prose">
                <p>Préférez un contact direct ? Écrivez-nous à contact@udixio.fr ou appelez le [téléphone] (du lundi au vendredi, 9h-18h).</p>
            </div>
        </div>
    </section>

    <Faq title="FAQ contact" items={faqItems} />

    <section class="section">
        <div class="max-width padding-x">
            <p class="text-body-large">Besoin d'un cadre clair ? On vous répond rapidement.</p>
            <Button className="mt-6 w-fit" href="#contact-form" label="Demander un diagnostic" />
        </div>
    </section>
</Layout>
