---
import Layout from "@layouts/Layout.astro";
import {Button} from "@udixio/ui-react";
import Faq from "@components/sections/Faq.astro";
const faqItems = [
    {
        question: "Comment assurez-vous que le projet reste cadré ?",
        answer: "Chaque étape a des objectifs clairs et des validations. Le périmètre est défini ensemble, et toute évolution est discutée avant d'être engagée.",
    },
    {
        question: "Comment se passent les décisions techniques ?",
        answer: "Nous expliquons chaque choix avec des mots simples et un impact concret. Rien n'est imposé sans échange.",
    },
    {
        question: "Puis-je demander des modifications en cours de route ?",
        answer: "Oui. Les ajustements sont possibles à chaque étape. S'il s'agit d'un changement majeur, on le recadre ensemble pour protéger le planning et le budget.",
    },
    {
        question: "Quels sont les délais ?",
        answer: "Ils dépendent du périmètre. Nous fournissons un planning clair dès le départ, avec des étapes validées ensemble.",
    },
    {
        question: "Que dois-je fournir côté client ?",
        answer: "Les éléments clés (contenus, visuels, contraintes métier) et vos retours de validation. Nous vous guidons pour que ce soit fluide.",
    },
    {
        question: "À qui appartiennent les livrables et les accès ?",
        answer: "À vous. Le code, les fichiers et les accès sont remis au client. Vous restez maître de vos outils.",
    },
    {
        question: "Travaillez-vous à distance ?",
        answer: "Oui, avec des échanges réguliers. Des rendez-vous en présentiel sont possibles dans les Hauts-de-France.",
    },
    {
        question: "Y a-t-il un support après la mise en ligne ?",
        answer: "Oui, un accompagnement est possible après lancement, selon vos besoins.",
    },
];
---

<Layout seo={{
    title: "Notre méthode : transparence, rigueur et résultats • Udixio",
    description: "Une méthode claire en 5 étapes pour cadrer, livrer et vous laisser la maîtrise.",
}}>
    <section class="section">
        <div class="max-width padding-x">
            <h1 class="text-display-small md:text-display-large">Notre méthode : transparence, rigueur et résultats</h1>
            <h2 class="text-headline-medium mt-8">Une approche structurée pour sécuriser votre projet</h2>
            <div class="text-body-large mt-6 max-w-prose space-y-4">
                <p>Beaucoup de projets web échouent à cause d'un manque de cadrage ou de communication. Chez Udixio, nous avons formalisé une méthode de travail qui élimine les zones d'ombre.</p>
                <p>Visibilité sur l'avancement, décisions claires, et maîtrise du périmètre.</p>
                <p>Collaboration, validation continue, pédagogie.</p>
            </div>
            <Button className="mt-8 w-fit" href="#etapes" label="Voir les étapes du projet" />
        </div>
    </section>

    <section id="etapes" class="section">
        <div class="max-width padding-x">
            <h2 class="text-display-small">Nos 5 étapes clés</h2>
            <div class="mt-8 grid gap-6">
                <div class="rounded-2xl border border-outline-variant bg-surface-container-low p-6">
                    <h3 class="text-title-large">Étape 1 - Cadrage</h3>
                    <p class="text-body-large mt-4">On clarifie objectifs, contraintes et périmètre. Livrables : synthèse de cadrage et plan d'action.</p>
                </div>
                <div class="rounded-2xl border border-outline-variant bg-surface-container-low p-6">
                    <h3 class="text-title-large">Étape 2 - Design &amp; structure</h3>
                    <p class="text-body-large mt-4">Architecture des pages et maquettes compréhensibles. Livrables : maquettes validées avant production.</p>
                </div>
                <div class="rounded-2xl border border-outline-variant bg-surface-container-low p-6">
                    <h3 class="text-title-large">Étape 3 - Développement &amp; tests</h3>
                    <p class="text-body-large mt-4">Intégration et développement sur une base fiable, avec contrôles de qualité avant validation.</p>
                </div>
                <div class="rounded-2xl border border-outline-variant bg-surface-container-low p-6">
                    <h3 class="text-title-large">Étape 4 - Livraison</h3>
                    <p class="text-body-large mt-4">Mise en ligne, remise des accès et documentation. Vous gardez la main.</p>
                </div>
                <div class="rounded-2xl border border-outline-variant bg-surface-container-low p-6">
                    <h3 class="text-title-large">Étape 5 - Hypercare</h3>
                    <p class="text-body-large mt-4">On sécurise les premières semaines et on reste disponible si besoin.</p>
                </div>
            </div>
            <p class="text-body-large mt-8 max-w-prose">On avance ensemble, pas à pas. Vous validez chaque étape.</p>
            <Button className="mt-8 w-fit" href="/contact" label="Demander un échange" />
        </div>
    </section>

    <section class="section">
        <div class="max-width padding-x">
            <h2 class="text-display-small">Nos outils de travail &amp; gages de qualité</h2>
            <div class="text-body-large mt-6 max-w-prose space-y-4">
                <p>Suivi partagé, documents clairs, et échanges réguliers. Vous voyez l'avancement en continu.</p>
                <p>Qualité et bonnes pratiques : accessibilité, performance, SEO on-page, sécurité, tests avant mise en ligne.</p>
                <p>Notre code est documenté, votre site est conçu pour durer : facile à faire évoluer par n'importe quel développeur compétent, ou par nous dans le cadre d'un partenariat long terme.</p>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="max-width padding-x">
            <h2 class="text-display-small">Anti-dépendance : vous gardez la maîtrise</h2>
            <div class="text-body-large mt-6 max-w-prose space-y-4">
                <p>Les livrables et les accès vous appartiennent. Vous gardez la main sur vos comptes et vos données.</p>
                <p>La documentation et la passation font partie de la livraison, pour garantir la réversibilité.</p>
            </div>
        </div>
    </section>

    <Faq
        title="Questions fréquentes sur notre manière de travailler"
        items={faqItems}
    />

    <section class="section">
        <div class="max-width padding-x">
            <p class="text-body-large">Vous avez d'autres questions sur notre méthode ? Contactez-nous, nous sommes transparents !</p>
            <Button className="mt-6 w-fit" href="/contact" label="Demandez un appel découverte" />
        </div>
    </section>
</Layout>
