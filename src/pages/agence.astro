---
import Layout from "@layouts/Layout.astro";
import { Button, Icon } from "@udixio/ui-react";
import { Card } from "@/components/Card";
import { Hero } from "@components/Hero";
import { SectionPadding } from "@components/SectionPadding";
import FaqSection from "@components/sections/FaqSection.astro";
import CtaSection from "@components/sections/CtaSection.astro";
import { iVisibility } from "@udixio/icons-rounded-400/visibility";
import { iChecklist } from "@udixio/icons-rounded-400/checklist";
import { iInfo } from "@udixio/icons-rounded-400/info";
import { iHandshake } from "@udixio/icons-rounded-400/handshake";
import { iPartnerExchange } from "@udixio/icons-rounded-400/partner_exchange";
import { iVerifiedUser } from "@udixio/icons-rounded-400/verified_user";
import { iKey } from "@udixio/icons-rounded-400/key";

const faqItems = [
  {
    question: "Depuis quand existe l'agence ?",
    answer:
      "Udixio a été fondée en 2024. Nous sommes jeunes en tant que structure : cette fraîcheur est notre force, avec une approche claire, pragmatique et orientée résultats.",
  },
  {
    question: "Pourquoi le nom Udixio ?",
    answer:
      "Udixio = vous + digital (UX, UI) + io (référence à l'univers technologique). En somme, on marie l'humain et la tech.",
  },
  {
    question: "Quelle est votre structure juridique ?",
    answer:
      "Udixio opère via ACCESSWEB LIMITED (Private Company Limited by Shares, Ltd), enregistrée en Irlande. CRN : 760413.",
  },
  {
    question: "Qui pilote les projets ?",
    answer:
      "Les fondateurs restent impliqués et l'équipe s'élargit selon les besoins. Vous savez toujours qui fait quoi.",
  },
];
---

<Layout
  seo={{
    title: "Udixio : Clarté & Maîtrise, duo fondateur • Udixio",
    description:
      "Une agence à taille humaine, fondée par deux frères, pour des projets web cadrés et transparents.",
  }}
  background={false}
>
  <Hero client:load>
    <div class="flex-1 flex flex-col justify-between gap-12">
      <div>
        <span class="sub-title">L'agence</span>
        <h1
          class="max-w-2xl text-display-medium text-on-surface-variant anim-fade anim-slide-from-left anim-duration-1000 ease-out anim-delay-100"
        >
          Clarté, maîtrise et <span class="text-gradient">duo fondateur</span>
        </h1>
      </div>
      <div>
        <p
          class="text-body-large max-w-96 mb-12 anim-fade anim-slide-from-left anim-duration-1000 ease-out anim-delay-200"
        >
          Une agence à taille humaine, fondée par deux frères, pour des projets
          web cadrés et transparents.
        </p>
        <div class="flex flex-wrap gap-4">
          <Button href="/contact" shape="squared" label="Nous contacter" />
          <Button href="/methode" label="Notre méthode" variant="outlined" />
        </div>
      </div>
    </div>
  </Hero>

  {/* MISSION */}
  <SectionPadding client:visible start end as="section">
    <div class="py-32 bg-surface-container-low">
      <div class="section">
        <div class="flex flex-col md:flex-row gap-16 md:gap-32 items-start">
          <div class="md:w-1/3 sticky top-32">
            <span class="sub-title">Notre mission</span>
            <h2 class="text-headline-large">
              Apporter de la <span class="text-gradient">clarté</span> à chaque
              projet
            </h2>
            <p class="mt-8 text-body-large max-w-xs text-on-surface-variant">
              Trop de projets web avancent dans le flou. Nous avons formalisé
              une approche pour changer ça.
            </p>
          </div>
          <Card className="md:w-2/3 w-full p-8 md:p-12 anim-slide-from-right">
            <div class="flex flex-col gap-4 mt-4">
              {
                [
                  {
                    title: "Transparence",
                    description:
                      "Pas de jargon, des décisions expliquées. Vous savez toujours pourquoi et comment.",
                    icon: iVisibility,
                  },
                  {
                    title: "Rigueur",
                    description:
                      "Un cadre clair, des étapes validées. Le projet avance sans zones d'ombre.",
                    icon: iChecklist,
                  },
                  {
                    title: "Pédagogie",
                    description:
                      "On rend la technique compréhensible pour que vous gardiez la maîtrise.",
                    icon: iInfo,
                  },
                  {
                    title: "Engagement",
                    description:
                      "On s'implique réellement, du cadrage à la livraison. Pas de sous-traitance opaque.",
                    icon: iHandshake,
                  },
                ].map((value, index) => (
                  <div
                    style={{ ["--anim-delay"]: `${100 * index}ms` }}
                    class="group flex gap-6 items-start p-4 rounded-2xl anim-in-fade anim-slide-from-right anim-duration-1000 anim-delay-200"
                  >
                    <div class="p-4 aspect-square rounded-xl bg-surface-container-highest text-on-surface-variant flex items-center justify-center">
                      <Icon className="size-8" icon={value.icon} />
                    </div>
                    <div>
                      <h3 class="text-headline-small text-on-surface mb-1">
                        {value.title}
                      </h3>
                      <p class="text-body-medium text-on-surface-variant">
                        {value.description}
                      </p>
                    </div>
                  </div>
                ))
              }
            </div>
          </Card>
        </div>
      </div>
    </div>
  </SectionPadding>

  {/* DUO FONDATEUR */}
  <section class="py-32 bg-surface">
    <div class="section">
      <span class="sub-title anim-in anim-fade">Le duo</span>
      <h2 class="text-headline-large mb-4 anim-in anim-fade anim-slide-from-left anim-duration-1000 anim-delay-150">
        Deux experts, <span class="text-gradient">sans intermédiaire</span>
      </h2>
      <p class="text-title-medium text-on-surface-variant max-w-2xl mb-12 anim-in anim-fade anim-delay-300">
        Votre projet est pris en charge par deux experts complémentaires,
        de la réflexion à la mise en ligne. Vous échangez directement avec
        ceux qui le conçoivent et le réalisent.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-3xl">
        {/* Joel */}
        <div class="bg-surface-container rounded-3xl p-8 border border-outline-variant/30 flex flex-col anim-in anim-fade anim-slide-from-left anim-delay-150">
          <div class="flex flex-col items-center gap-4 mb-6">
            <div
              class="h-20 w-20 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center text-headline-medium font-bold border-2 border-primary/20"
            >
              JV
            </div>
            <div class="text-center">
              <div class="text-title-large font-bold text-on-surface">Joel Vigreux</div>
              <div class="text-label-small text-on-surface-variant uppercase tracking-wider mt-1">
                Directeur Technique
              </div>
            </div>
          </div>
          <ul class="space-y-2 text-body-medium text-on-surface-variant mb-6 list-disc pl-5">
            <li>Développement full-stack</li>
            <li>Architecture & performance web</li>
            <li>Outils internes (Udixio UI, Netsimpler)</li>
          </ul>
          <Button
            href="https://www.linkedin.com/in/joel-vigreux/"
            variant="outlined"
            label="Profil LinkedIn"
            className="w-fit mt-auto"
            target="_blank"
          />
        </div>

        {/* Florian */}
        <div class="bg-surface-container rounded-3xl p-8 border border-outline-variant/30 flex flex-col anim-in anim-fade anim-slide-from-right anim-delay-300">
          <div class="flex flex-col items-center gap-4 mb-6">
            <div
              class="h-20 w-20 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center text-headline-medium font-bold border-2 border-secondary/20"
            >
              FV
            </div>
            <div class="text-center">
              <div class="text-title-large font-bold text-on-surface">Florian Vigreux</div>
              <div class="text-label-small text-on-surface-variant uppercase tracking-wider mt-1">
                Directeur Conseil
              </div>
            </div>
          </div>
          <ul class="space-y-2 text-body-medium text-on-surface-variant mb-6 list-disc pl-5">
            <li>Relation client & cadrage</li>
            <li>Stratégie digitale & conseil</li>
            <li>Pilotage et suivi de projet</li>
          </ul>
          <Button
            href="https://www.linkedin.com/in/florian-vigreux/"
            variant="outlined"
            label="Profil LinkedIn"
            className="w-fit mt-auto"
            target="_blank"
          />
        </div>
      </div>

      <Button href="/contact" label="Discutons de votre projet" className="mt-10" />
    </div>
  </section>

  {/* CHIFFRES CLÉS */}
  <section class="py-24 bg-surface-container-low">
    <div class="section text-center">
      <span class="sub-title anim-in anim-fade">En chiffres</span>
      <h2 class="text-headline-large text-on-surface mb-12 anim-in anim-fade anim-delay-150">
        Notre bilan
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-3xl mx-auto">
        {
          [
            { value: "5+", label: "projets livrés" },
            { value: "100/100", label: "Lighthouse, notre standard" },
            { value: "8 ans+", label: "d'expérience cumulée" },
          ].map((stat, index) => (
            <div
              class="bg-surface rounded-3xl p-8 border border-outline-variant/40 anim-in anim-fade anim-slide-from-bottom"
              style={{ ["--anim-delay"]: `${index * 150}ms` }}
            >
              <div class="text-display-small font-bold text-primary">{stat.value}</div>
              <div class="text-label-large text-on-surface-variant uppercase tracking-wider mt-2">
                {stat.label}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* FORMATIONS */}
  <section class="py-24 bg-surface">
    <div class="section">
      <span class="sub-title anim-in anim-fade">Parcours</span>
      <h2 class="text-headline-large text-on-surface mb-4 anim-in anim-fade anim-slide-from-left anim-duration-1000 anim-delay-150">
        Formations & expertise
      </h2>
      <p class="text-title-medium text-on-surface-variant max-w-2xl mb-12 anim-in anim-fade anim-delay-300">
        Nos parcours de formation et compétences reconnues.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          [
            {
              type: "Formation diplômante",
              name: "Développeur Web et Web Mobile",
              org: "Titre professionnel niveau 5 (bac +2)",
              year: "Joël Vigreux",
            },
            {
              type: "Bootcamp",
              name: "Commerce & Marketing digital",
              org: "Rocket School",
              year: "Florian Vigreux · 2023",
            },
          ].map((cert, index) => (
            <Card
              variant="outlined"
              className="p-6 bg-surface-container-low anim-in anim-fade anim-scale"
              style={{ ["--anim-delay"]: `${index * 150}ms` }}
            >
              <div class="text-label-small text-primary uppercase tracking-wider mb-2">
                {cert.type}
              </div>
              <h3 class="text-headline-small mb-1">{cert.name}</h3>
              <p class="text-body-medium text-on-surface-variant">{cert.org}</p>
              <p class="text-body-small text-on-surface-variant mt-1">{cert.year}</p>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  {/* LOCALISATION */}
  <section class="py-24 bg-surface">
      <div class="section text-center">
        <span class="sub-title">Où sommes-nous ?</span>
        <h2 class="text-headline-large text-on-surface mb-6">
          Hauts-de-France & <span class="text-gradient">Normandie</span>
        </h2>
        <p
          class="text-title-medium text-on-surface-variant max-w-2xl mx-auto mb-16"
        >
          Basés entre Amiens et Le Havre. Nous travaillons principalement à
          distance, avec des rendez-vous physiques possibles sur demande.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {
            [
              {
                icon: iPartnerExchange,
                title: "Contact direct",
                desc: "Vous échangez directement avec les fondateurs, sans interlocuteur intermédiaire.",
              },
              {
                icon: iVerifiedUser,
                title: "Flexibilité totale",
                desc: "Échanges en présentiel ou en visio selon vos besoins. Disponibles du lundi au vendredi, 9h–18h.",
              },
              {
                icon: iKey,
                title: "Réponse rapide",
                desc: "Nous revenons vers vous sous 1 jour ouvré. Écrivez-nous à contact@udixio.fr.",
              },
            ].map((item) => (
              <Card variant="outlined" className="group p-8">
                <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-6">
                  <Icon icon={item.icon} className="w-6 h-6 fill-current" />
                </div>
                <h3 class="text-headline-small mb-2">{item.title}</h3>
                <p class="text-on-surface-variant">{item.desc}</p>
              </Card>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <FaqSection
    title="Questions fréquentes sur Udixio"
    description="Tout ce que vous voulez savoir sur notre agence avant d'aller plus loin."
    items={faqItems}
  />

  <CtaSection
    title="Envie de nous rencontrer ?"
    description="Décrivez-nous votre projet, on vous répond rapidement avec un premier retour concret."
    primaryLabel="Nous contacter"
    primaryHref="/contact"
    secondaryLabel="Voir nos réalisations"
    secondaryHref="/realisations"
  />
</Layout>
