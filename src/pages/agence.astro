---
import Layout from "@layouts/Layout.astro";
import {Button} from "@udixio/ui-react";
import Faq from "@components/sections/Faq.astro";

const faqItems = [
    {
        question: "Depuis quand existe l'agence ?",
        answer: "Udixio a été fondée en 2024. Nous sommes jeunes en tant que structure : cette fraîcheur est notre force, avec une approche claire, pragmatique et orientée résultats.",
    },
    {
        question: "Pourquoi le nom Udixio ?",
        answer: "Udixio = vous + digital (UX, UI) + io (référence à l'univers technologique). En somme, on marie l'humain et la tech.",
    },
    {
        question: "Quelle est votre structure juridique ?",
        answer: "Udixio opère via ACCESSWEB LIMITED (Private Company Limited by Shares, Ltd), enregistrée en Irlande. CRN : 760413.",
    },
    {
        question: "Qui pilote les projets ?",
        answer: "Les fondateurs restent impliqués et l'équipe s'élargit selon les besoins. Vous savez toujours qui fait quoi.",
    },
];
---

<Layout seo={{
    title: "Udixio — Clarté & Maîtrise, duo fondateur • Udixio",
    description: "Une agence à taille humaine, fondée par deux frères, pour des projets web cadrés et transparents.",
}}>
    <section class="section">
        <div class="max-width padding-x">
            <h1 class="text-display-small md:text-display-large">Udixio : clarté, maîtrise et duo fondateur</h1>
        </div>
    </section>

    <section class="section">
        <div class="max-width padding-x">
            <h2 class="text-display-small">Notre mission</h2>
            <div class="text-body-large mt-6 max-w-prose space-y-4">
                <p>Udixio est née d'un constat : trop de projets web avancent dans le flou. Notre mission est d'apporter de la clarté, de la structure et de la maîtrise côté client.</p>
                <p>Transparence : pas de jargon, des décisions expliquées.</p>
                <p>Rigueur : un cadre clair, des étapes validées.</p>
                <p>Pédagogie : on rend la technique compréhensible.</p>
                <p>Engagement : on s'implique réellement, du cadrage à la livraison.</p>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="max-width padding-x">
            <h2 class="text-display-small">Le duo fondateur (et une équipe qui s'élargit)</h2>
            <div class="text-body-large mt-6 max-w-prose space-y-4">
                <p><strong>Joël Vigreux</strong> — Co-fondateur, Développement full-stack : développement front-end et back-end, architecture technique, performance, qualité et maintenabilité.</p>
                <p><strong>Florian Vigreux</strong> — Co-fondateur, Développement commercial &amp; pilotage : relation client, cadrage des besoins, suivi de projet, coordination et traduction des enjeux business vers la technique.</p>
                <p>Une agence lancée récemment, mais structurée autour d'un binôme complémentaire. L'équipe s'élargit selon les projets, sans perdre la clarté du pilotage.</p>
            </div>
            <Button className="mt-6 w-fit" href="/contact" label="Envie d'en savoir plus ? Discutons ensemble." />
        </div>
    </section>

    <section class="section">
        <div class="max-width padding-x">
            <h2 class="text-display-small">Où sommes-nous ?</h2>
            <div class="text-body-large mt-6 max-w-prose space-y-4">
                <p>Basée dans les Hauts-de-France, avec présence à Amiens et Le Havre.</p>
                <p>Nous travaillons principalement à distance, ce qui nous permet d'être flexibles. Des rendez-vous physiques sont possibles sur demande.</p>
                <p>Préférez un contact direct ? Écrivez-nous à contact@udixio.fr ou appelez le [téléphone] (du lundi au vendredi, 9h-18h).</p>
            </div>
            <Button className="mt-6 w-fit" href="/contact" label="Contactez-nous" />
        </div>
    </section>

    <section class="section">
        <div class="max-width padding-x">
            <h2 class="text-display-small">Nos engagements concrets</h2>
            <ul class="mt-6 list-disc pl-6 text-body-large max-w-prose">
                <li>périmètre clarifié avant démarrage</li>
                <li>validations à chaque étape clé</li>
                <li>accès et livrables remis au client</li>
                <li>explications claires des choix techniques</li>
            </ul>
        </div>
    </section>

    <Faq title="Questions fréquentes sur Udixio" items={faqItems} />

    <section class="section">
        <div class="max-width padding-x">
            <p class="text-body-large">Envie de nous rencontrer ? Contactez-nous !</p>
            <Button className="mt-6 w-fit" href="/contact" label="Contactez-nous" />
        </div>
    </section>
</Layout>
