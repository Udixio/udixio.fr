---
import Layout from "@layouts/Layout.astro";
import {Navigation} from "@/components/app/Navigation"
import {Actions} from "@/components/app/Actions.tsx"
---
<Layout menu={false} footer={false} seo={{noindex: true}} background={false}>
    <div class="h-[100vh] flex">
        <Navigation client:load/>
        <slot/>
        <Actions client:load/>
    </div>
    <script>
        import {actions} from 'astro:actions';

        (async () => {
            const isLoginPage = window.location.pathname === '/login';
            if (isLoginPage) {
                const {data, error} = await actions.checkAuth({})
                if (error) {
                    window.location.replace('/500');
                }
                if (data?.authenticated) {
                    window.location.replace('/app');
                }
            }
            try {
                const {data, error} = await actions.checkAuth({})
                if (error) {
                    window.location.replace('/500');
                }
                if (!data?.authenticated) {
                    window.location.replace('/login');
                }
            } catch (e) {
                window.location.replace('/500');
            }
        })();
    </script>

    <noscript>
        <div class="p-4 text-sm text-red-600">
            JavaScript est requis pour vérifier votre session. Activez JavaScript ou
            rendez-vous sur <a class="underline" href="/login">/login</a> pour vous connecter.
        </div>
    </noscript>
</Layout>