---
import Obfuscate from "react-obfuscate";
import {Icon} from "@udixio/ui-react";
import {FormContact} from "../components/FormContact";
import {faComments} from "@fortawesome/free-solid-svg-icons";
---

<section id="contact" class=" theme-blue py-16 md:py-32 md:mt-32 z-20">

    <div

            class=" md:px-6 max-w-screen-2xl mx-auto ">
        <div class="bg-surface-container-highest lg:flex rounded-3xl overflow-hidden">
            <div class="left flex-1 padding !pb-12 pt-8">
                <div class="flex gap-4 group rounded-xl mt-2">
                    <div class="transition-all duration-300 flex items-center  justify-center rounded-lg  h-12 w-12 border border-outline-variant">
                        <Icon className="h-6 w-6 fill-on-surface-variant" icon={faComments}></Icon>
                    </div>
                    <div><p class="text-title-small mt-0.5">Échange clair, sans jargon</p>
                        <div class="text-on-surface-variant max-w-prose text-body-small">
                            <p class="mt-1">Expliquez vos objectifs et vos contraintes, on vous aide à cadrer.</p>
                            <Obfuscate
                                    client:visible
                                    className="mt-4 inline-block underline-offset-4 underline !text-bold text-secondary focus-visible:text-primary hover:text-primary"
                                    email={import.meta.env.PUBLIC_EMAIL_TO}
                                    headers={{
                                        body: `Bonjour,

    Je m'appelle [Nom], et je souhaiterais vous parler d'un projet. Voici quelques détails :

    Projet : [Brève description]
    Objectifs : [Principaux objectifs]
    Délai : [Délai souhaité]
    Budget : [Budget estimé]
    Je suis disponible pour en parler. Vous pouvez me contacter par email à [Votre Email] ou au [Votre Numéro].

    Cordialement,

    [Nom]`,
                                    }}
                            />
                        </div>
                    </div>
                </div>
                <!--<div class="flex gap-4 mt-12 group rounded-xl ">-->
                <!--    <div class="transition-all duration-300 flex items-center  justify-center rounded-lg  h-12 w-12 border border-outline-variant">-->
                <!--        <Icon className="h-6 w-6 fill-on-surface-variant" icon={faPhone}></Icon>-->
                <!--    </div>-->
                <!--    <div><p class="text-title-small mt-0.5">Discuter avec nous</p>-->
                <!--        <div class="text-on-surface-variant max-w-prose text-body-small">-->
                <!--            <p class="mt-1">Notre équipe est là pour vous aider.</p>-->
                <!--            <Link className="mt-4 block" href="mailto:example@gmaim.com">example@gmaim.com-->
                <!--            </Link>-->
                <!--        </div>-->
                <!--    </div>-->
                <!--</div>-->
            </div>
            <div class="right padding bg-surface-container-low flex-2 m-2 pt-8 rounded-2xl">
                <h2 class="text-display-small max-w-prose"><span
                        class="text-gradient">Restons en contact</span><br/>
                    pour cadrer votre projet</h2>
                <p class="mt-4 max-w-prose">Donnez-nous le contexte, on vous propose un cadre clair et la bonne
                    prochaine étape.</p>
                <FormContact client:only="react"/>
            </div>

        </div>
    </div>
</section>

<style is:global>
    .grecaptcha-badge {
        visibility: hidden;
    }
</style>

<footer class="relative">
    <nav class="max-w-screen-2xl mx-auto px-6 py-6 flex flex-wrap justify-center gap-6 text-body-small">
        <a class="underline-offset-4 hover:underline" href="/">Accueil</a>
        <a class="underline-offset-4 hover:underline" href="/services">Services</a>
        <a class="underline-offset-4 hover:underline" href="/methode">Méthode</a>
        <a class="underline-offset-4 hover:underline" href="/realisations">Réalisations</a>
        <a class="underline-offset-4 hover:underline" href="/ressources">Ressources</a>
        <a class="underline-offset-4 hover:underline" href="/agence">Agence</a>
        <a class="underline-offset-4 hover:underline" href="/contact">Contact</a>
        <a class="underline-offset-4 hover:underline" href="/mentions-legales">Mentions légales</a>
    </nav>
    <div class="max-w-screen-2xl mx-auto px-6 pb-6 text-body-small text-center text-on-surface-variant">
        <p>Basés dans les Hauts-de-France (Amiens &amp; Le Havre). Contact direct : contact@udixio.fr / [téléphone].</p>
        <p class="mt-2">© 2025 Concu avec ❤️ par Udixio</p>
    </div>
</footer>
