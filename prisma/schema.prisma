// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================
// Data model for Admin Platform
// =============================

// Commercial "client status" removed to simplify: deal statuses now carry the relationship signal

// Project execution status (more operational than lifecycle)

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  BLOCKED
  REVIEW
  MAINTENANCE
  COMPLETED
  CANCELLED
}

// Audit execution status

enum AuditStatus {
  DRAFT
  SCHEDULED
  RUNNING
  NEEDS_REVIEW
  PASSED
  FAILED
  ARCHIVED
}

// Audit type, allows future extensions

enum AuditType {
  LIGHTHOUSE
  SEO
  PERFORMANCE
  ACCESSIBILITY
  SECURITY
  MANUAL
  OTHER
}

// (Supprimé) Catégories fermées remplacées par des tags libres sur Technology

// NOUVEAU : On définit précisément le type de canal pour l'interface UI
enum ContactChannel {
  EMAIL
  PHONE_MOBILE
  PHONE_LANDLINE
  LINKEDIN
  WHATSAPP
  SLACK
  TELEGRAM
  WEBSITE
  OTHER
}

// NOUVEAU : Remplace l'ancien modèle Contact.
// Ce modèle ne stocke que le "moyen" de contacter, pas l'identité de la personne.
model ContactPoint {
  id        String         @id @default(cuid())
  channel   ContactChannel @default(EMAIL)
  value     String // ex: "+33612345678" ou "bob@example.com"
  label     String? // ex: "Bureau", "Perso", "Urgence", "Comptabilité"
  isPrimary Boolean        @default(false)

  // Relations polymorphes (optionnelles)
  // Un moyen de contact peut appartenir à une Organisation
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?

  // OU appartenir à un Client (qui est une Personne/User)
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([clientId])
}

model Organization {
  id        String  @id @default(cuid())
  name      String
  legalName String? // optional registered name

  address   String?
  city      String?
  zip       String?
  country   String?
  vatNumber String?

  projects Project[]
  deals    Deal[]

  // Fil d'historique (notes) rattachées à l'organisation
  notes Note[] @relation("OrganizationNotes")

  tags Tag[]

  contactPoints ContactPoint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slug        String
  logo        String?
  members     Member[]
  invitations Invitation[]

  // Nouveaux sites Web appartenant à l'organisation
  websites Website[]

  @@unique([slug])
  @@index([name])
  @@map("organization")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  priority    Int? // 1 (highest) .. n
  startDate   DateTime?
  dueDate     DateTime?
  notes       String?

  // Relations
  // Organization that owns this project
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  // Les projets ne possèdent plus directement des domaines ni des audits
  // Un projet intervient sur un ou plusieurs sites Web (Website)
  websites Website[]

  // Back‑relation optionnelle: audits réalisés dans le cadre de ce projet
  audits Audit[]

  // Related deals (optional back-reference)
  deals Deal[]

  // Arbitrary structured data (deployment info, stack, etc.)
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([organizationId])
}

model Domain {
  id         String   @id @default(cuid())
  host       String // e.g., example.com, app.example.com
  isPrimary  Boolean  @default(false)
  sslEnabled Boolean? // whether HTTPS/valid cert is enabled
  notes      String?

  // Relation: un domaine pointe vers une infrastructure technique (Website)
  website   Website @relation(fields: [websiteId], references: [id])
  websiteId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([host])
  @@index([websiteId])
}

model Audit {
  id     String      @id @default(cuid())
  type   AuditType   @default(LIGHTHOUSE)
  status AuditStatus @default(DRAFT)

  // Required: JSON fields for Lighthouse and scroller data
  lighthouse Json? // raw Lighthouse result JSON object
  scroller   Json? // scrolling metrics, CLS traces, etc.

  title       String? // optional descriptive title
  description String?
  runAt       DateTime? // when the audit run took place
  startedAt   DateTime?
  finishedAt  DateTime?
  createdBy   String? // auditor name or user id (if no user model yet)

  // Relation principale: l'audit concerne un Website (obligatoire)
  website   Website @relation(fields: [websiteId], references: [id])
  websiteId String

  // Relation optionnelle au Project (cadre d'exécution)
  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?

  // Additional structured data per audit
  metrics   Json? // normalized KPIs (TTFB, LCP, etc.)
  resources Json? // assets, screenshots, trace links
  metadata  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([websiteId])
  @@index([projectId])
  @@index([type, status])
  @@index([runAt])
}

// =============================
// Website (Site Web)
// =============================

model Website {
  id String @id @default(cuid())

  // Propriétaire du site
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  // Technologies utilisées par le site (relation via table explicite, permet de stocker la version)
  technologyLinks WebsiteTechnology[]

  // Relations
  domains Domain[]
  audits  Audit[]

  // Projets liés (many-to-many implicite)
  projects Project[]

  // Tags (étiquettes) rattachés au Website via la table Tag (M2M implicite)
  tags Tag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// =============================
// Technology (dictionnaire unique des techno)
// =============================

model Technology {
  id   String   @id @default(cuid())
  name String
  // Tags normalisés via la table Tag (M2M) — remplace l'ancien String[] local
  tags Tag[]
  logo String?

  // Websites utilisant cette technologie (via table de liaison explicite)
  websiteLinks WebsiteTechnology[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Unicité par nom pour éviter les doublons (ex: "WordPress")
  @@unique([name])
}

// =============================
// Table de liaison explicite Website <-> Technology
// Permet d'ajouter un champ version pour tracer la version utilisée
// =============================
model WebsiteTechnology {
  // Clé composite (un lien par couple website/technology)
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  websiteId String

  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)
  technologyId String

  // Métadonnées de la relation
  version String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([websiteId, technologyId])
  @@index([technologyId])
  @@index([websiteId])
}

model User {
  id            String    @id @default(cuid())
  name          String
  firstName     String?
  lastName      String?
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]

  members     Member[]
  invitations Invitation[]

  role       String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?
  // Relations
  // contacts supprimés au profit des ContactPoint liés à Client/Organization

  // A User is a Client by default (1-1). The Client record stores CRM-specific info.
  client Client?

  // Notes écrites par l'utilisateur (auteur)
  authoredNotes Note[] @relation("AuthoredNotes")

  @@unique([email])
  @@map("user")
}

// =============================
// Client (profil CRM minimal) — 1:1 avec User
// =============================

/// Un Client représente un profil CRM minimal pour une personne (User).
/// Règles métier (gérées côté application):
/// - À la création d’un User, créer un Client associé.
/// - À la désactivation/suppression d’un User, archiver/anonymiser le Client selon la politique.
model Client {
  id String @id @default(cuid())

  // 1-1 relation with User
  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  jobTitle String?
  gender   String?

  metadata Json?

  // Relations
  deals         Deal[]
  // NOUVEAU : Les moyens de contacter ce client spécifiquement
  contactPoints ContactPoint[]

  // Fil d'historique (notes) rattachées au client
  notes Note[] @relation("ClientNotes")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("client")
}

// =============================
// Deal / Opportunity
// =============================

enum DealStatus {
  LEAD
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
  ON_HOLD
}

model Deal {
  id     String     @id @default(cuid())
  title  String
  status DealStatus @default(LEAD)

  amount      Decimal? @db.Decimal(12, 2) // potential amount
  probability Int? // 0..100

  tags Tag[]

  openedAt DateTime? // when the deal started
  closedAt DateTime? // when deal won/lost

  // Relations
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?

  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?

  // Primary person for the deal; migrating from direct User link to Client
  client   Client? @relation(fields: [clientId], references: [id])
  clientId String?

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Fil d'historique (notes) rattachées au deal
  notes Note[] @relation("DealNotes")

  @@index([organizationId])
  @@index([projectId])
  @@index([clientId])
  @@index([status])
}

// =============================
// Note / Historique
// =============================

model Note {
  id        String   @id @default(cuid())
  content   String // texte long
  createdAt DateTime @default(now())

  // Auteur optionnel (messages système sans auteur possible)
  author   User?   @relation("AuthoredNotes", fields: [authorId], references: [id], onDelete: SetNull)
  authorId String?

  // Cibles optionnelles (liens polymorphes simples via FKs optionnels)
  organization   Organization? @relation("OrganizationNotes", fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?

  client   Client? @relation("ClientNotes", fields: [clientId], references: [id], onDelete: Cascade)
  clientId String?

  deal   Deal?   @relation("DealNotes", fields: [dealId], references: [id], onDelete: Cascade)
  dealId String?

  // Empêche les doublons de même contenu pour un même deal (idempotence côté DB)
  @@unique([dealId, content])
  @@index([authorId])
  @@index([organizationId])
  @@index([clientId])
  @@index([dealId])
  @@map("note")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String?

  impersonatedBy String?

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime

  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitation")
}

model Tag {
  id    String  @id @default(cuid())
  name  String
  color String? // ex: "#FF5733" ou "blue-500"

  // Relations : Un tag peut être associé à plusieurs entités
  deals         Deal[]
  organizations Organization[]
  websites      Website[]
  technologies  Technology[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
  @@map("tag")
}
