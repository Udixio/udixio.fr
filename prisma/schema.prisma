// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================
// Data model for Admin Platform
// =============================

// Commercial "client status" removed to simplify: deal statuses now carry the relationship signal

// Project execution status (more operational than lifecycle)

// ProjectStatus supprimé (vision Produit): un projet est une entité vivante sans statut de cycle de vie

// Audit execution status

enum AuditStatus {
  DRAFT
  SCHEDULED
  RUNNING
  NEEDS_REVIEW
  PASSED
  FAILED
  ARCHIVED
}

// Audit type, allows future extensions

enum AuditType {
  LIGHTHOUSE
  SEO
  PERFORMANCE
  ACCESSIBILITY
  SECURITY
  MANUAL
  OTHER
}

enum ContactChannel {
  EMAIL
  PHONE_MOBILE
  PHONE_LANDLINE
  LINKEDIN
  WHATSAPP
  SLACK
  TELEGRAM
  WEBSITE
  OTHER
}

model ContactPoint {
  id        String         @id @default(cuid())
  channel   ContactChannel @default(EMAIL)
  value     String // ex: "+33612345678" ou "bob@example.com"
  label     String? // ex: "Bureau", "Perso", "Urgence", "Comptabilité"
  isPrimary Boolean        @default(false)

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?

  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([clientId])
  @@map("contact_point")
}

model Organization {
  id        String  @id @default(cuid())
  name      String
  legalName String? // optional registered name

  address   String?
  city      String?
  zip       String?
  country   String?
  vatNumber String?

  projects Project[]
  deals    Deal[]

  // Fil d'historique rattaché à l'organisation (Commentaires)
  comments Comment[] @relation("OrganizationComments")

  // Historique des activités liées à l'organisation
  activities Activity[] @relation("OrganizationActivities")

  // Tags via table de liaison explicite
  organizationTagLinks OrganizationTagLink[]

  contactPoints ContactPoint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slug        String
  logo        String?
  members     Member[]
  invitations Invitation[]

  // Les sites web sont désormais rattachés aux Projets de l'organisation (Organization -> Project -> Website)

  @@unique([slug])
  @@index([name])
  @@map("organization")
}

model Project {
  id          String  @id @default(cuid())
  name        String
  description String?
  priority    Int? // 1 (highest) .. n

  // Relations
  // Organization that owns this project
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  // Les projets ne possèdent plus directement des domaines ni des audits
  // Un projet intervient sur un ou plusieurs sites Web (Website)
  websites Website[]

  // Back‑relation optionnelle: audits réalisés dans le cadre de ce projet
  audits Audit[]

  // Related deals (optional back-reference)
  deals Deal[]

  // Arbitrary structured data (deployment info, stack, etc.)
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([organizationId])
  @@map("project")
}

model Domain {
  id         String   @id @default(cuid())
  host       String // e.g., example.com, app.example.com
  isPrimary  Boolean  @default(false)
  sslEnabled Boolean? // whether HTTPS/valid cert is enabled
  notes      String?

  // Relation: un domaine pointe vers une infrastructure technique (Website)
  website   Website @relation(fields: [websiteId], references: [id])
  websiteId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([host])
  @@index([websiteId])
  @@map("domain")
}

model Audit {
  id     String      @id @default(cuid())
  type   AuditType   @default(LIGHTHOUSE)
  status AuditStatus @default(DRAFT)

  // Required: JSON fields for Lighthouse and scroller data
  lighthouse Json? // raw Lighthouse result JSON object
  scroller   Json? // scrolling metrics, CLS traces, etc.

  title       String? // optional descriptive title
  description String?
  runAt       DateTime? // when the audit run took place
  startedAt   DateTime?
  finishedAt  DateTime?
  createdBy   String? // auditor name or user id (if no user model yet)

  // Relation principale: l'audit concerne un Website (obligatoire)
  website   Website @relation(fields: [websiteId], references: [id])
  websiteId String

  // Relation optionnelle au Project (cadre d'exécution)
  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?

  // Additional structured data per audit
  metrics   Json? // normalized KPIs (TTFB, LCP, etc.)
  resources Json? // assets, screenshots, trace links
  metadata  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([websiteId])
  @@index([projectId])
  @@index([type, status])
  @@index([runAt])
  @@map("audit")
}

// =============================
// Website (Site Web)
// =============================

model Website {
  id String @id @default(cuid())

  // Appartenance obligatoire à un Projet (vision Produit)
  project   Project @relation(fields: [projectId], references: [id])
  projectId String

  // Technologies utilisées par le site (relation via table explicite, permet de stocker la version)
  technologyLinks WebsiteTechnologyLink[]

  // Tags liés via une table de liaison explicite (pas de champ Website.tags direct)
  websiteTagLinks WebsiteTagLink[]

  // Fil d'historique (commentaires) rattachés au site web
  comments Comment[] @relation("WebsiteComments")

  // Historique des activités liées au site web
  activities Activity[] @relation("WebsiteActivities")

  // Relations
  domains Domain[]
  audits  Audit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("website")
}

// =============================
// Technology (dictionnaire unique des techno)
// =============================

model Technology {
  id                 String              @id @default(cuid())
  name               String
  // Tags via table de liaison explicite
  technologyTagLinks TechnologyTagLink[]
  logo               String?

  // Websites utilisant cette technologie (via table de liaison explicite)
  websiteLinks WebsiteTechnologyLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Unicité par nom pour éviter les doublons (ex: "WordPress")
  @@unique([name])
  @@map("technology")
}

// =============================
// Table de liaison explicite Website <-> Technology
// Permet d'ajouter un champ version pour tracer la version utilisée
// =============================
model WebsiteTechnologyLink {
  // Clé composite (un lien par couple website/technology)
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  websiteId String

  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)
  technologyId String

  // Métadonnées de la relation
  version String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([websiteId, technologyId])
  @@index([technologyId])
  @@index([websiteId])
  @@map("website_technology_link")
}

// =============================
// Table de liaison explicite Website <-> Tag
// Permet d'ajouter des métadonnées (source, date de détection, etc.)
// =============================
model WebsiteTagLink {
  // Clé composite (un lien par couple website/tag)
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  websiteId String

  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId String

  // Métadonnées optionnelles
  source     String? // ex: "crawler", "import", "manual"
  detectedAt DateTime? // quand le tag a été détecté/assigné

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([websiteId, tagId])
  @@index([tagId])
  @@index([websiteId])
  @@map("website_tag_link")
}

model User {
  id            String    @id @default(cuid())
  name          String
  firstName     String?
  lastName      String?
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]

  members     Member[]
  invitations Invitation[]

  role       String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?
  // Relations
  // contacts supprimés au profit des ContactPoint liés à Client/Organization

  // A User is a Client by default (1-1). The Client record stores CRM-specific info.
  client Client?

  // Commentaires écrits par l'utilisateur (auteur)
  authoredComments Comment[] @relation("AuthoredComments")

  // Activités effectuées par l'utilisateur (acteur)
  performedActivities Activity[] @relation("ActivityPerformer")

  // Liens de tags créés par l'utilisateur (back-relations optionnelles)
  createdOrganizationTagLinks OrganizationTagLink[] @relation("OrganizationTagLinkCreatedBy")
  createdDealTagLinks         DealTagLink[]         @relation("DealTagLinkCreatedBy")
  createdTechnologyTagLinks   TechnologyTagLink[]   @relation("TechnologyTagLinkCreatedBy")

  @@unique([email])
  @@map("user")
}

// =============================
// Client (profil CRM minimal) — 1:1 avec User
// =============================

/// Un Client représente un profil CRM minimal pour une personne (User).
/// Règles métier (gérées côté application):
/// - À la création d’un User, créer un Client associé.
/// - À la désactivation/suppression d’un User, archiver/anonymiser le Client selon la politique.
model Client {
  id String @id @default(cuid())

  // 1-1 relation with User
  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  jobTitle String?
  gender   String?

  metadata Json?

  // Relations
  deals         Deal[]
  // NOUVEAU : Les moyens de contacter ce client spécifiquement
  contactPoints ContactPoint[]

  // Fil d'historique (commentaires) rattaché au client
  comments Comment[] @relation("ClientComments")

  // Historique des activités liées au client
  activities Activity[] @relation("ClientActivities")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("client")
}

// =============================
// Deal / Opportunity
// =============================

enum DealStatus {
  LEAD
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
  ON_HOLD
}

model Deal {
  id     String     @id @default(cuid())
  title  String
  status DealStatus @default(LEAD)

  amount      Decimal? @db.Decimal(12, 2) // potential amount
  probability Int? // 0..100

  // Tags via table de liaison explicite
  dealTagLinks DealTagLink[]

  openedAt DateTime? // when the deal started
  closedAt DateTime? // when deal won/lost

  // Relations
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?

  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?

  // Primary person for the deal; migrating from direct User link to Client
  client   Client? @relation(fields: [clientId], references: [id])
  clientId String?

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Fil d'historique (commentaires) rattaché au deal
  comments Comment[] @relation("DealComments")

  // Historique des activités liées au deal
  activities Activity[] @relation("DealActivities")

  @@index([organizationId])
  @@index([projectId])
  @@index([clientId])
  @@index([status])
  @@map("deal")
}

// =============================
// Comment / Discussion humaine (avec fils de discussion)
// =============================

model Comment {
  id        String    @id @default(cuid())
  content   String // texte long
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  // Auteur optionnel (messages système sans auteur possible)
  author   User?   @relation("AuthoredComments", fields: [authorId], references: [id], onDelete: SetNull)
  authorId String?

  // Fil de discussion: auto‑relation parent/réponses
  parent   Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: SetNull)
  parentId String?
  replies  Comment[] @relation("CommentThread")

  // Cibles optionnelles (liens polymorphes simples via FKs optionnels)
  organization   Organization? @relation("OrganizationComments", fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?

  client   Client? @relation("ClientComments", fields: [clientId], references: [id], onDelete: Cascade)
  clientId String?

  deal   Deal?   @relation("DealComments", fields: [dealId], references: [id], onDelete: Cascade)
  dealId String?

  // Lien optionnel vers un Website (commentaires techniques spécifiques au site)
  website   Website? @relation("WebsiteComments", fields: [websiteId], references: [id], onDelete: Cascade)
  websiteId String?

  // Empêche les doublons de même contenu pour un même deal (idempotence côté DB)
  @@unique([dealId, content])
  @@index([authorId])
  @@index([organizationId])
  @@index([clientId])
  @@index([dealId])
  @@index([websiteId])
  @@map("comment")
}

// =============================
// Activity / Journal de bord (historique système)
// =============================

model Activity {
  id          String @id @default(cuid())
  type        String
  description String
  metadata    Json?

  performer   User?   @relation("ActivityPerformer", fields: [performerId], references: [id], onDelete: SetNull)
  performerId String?

  // Cibles optionnelles (polymorphes)
  organization   Organization? @relation("OrganizationActivities", fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?

  client   Client? @relation("ClientActivities", fields: [clientId], references: [id], onDelete: Cascade)
  clientId String?

  deal   Deal?   @relation("DealActivities", fields: [dealId], references: [id], onDelete: Cascade)
  dealId String?

  website   Website? @relation("WebsiteActivities", fields: [websiteId], references: [id], onDelete: Cascade)
  websiteId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([performerId])
  @@index([organizationId])
  @@index([clientId])
  @@index([dealId])
  @@index([websiteId])
  @@map("activity")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String?

  impersonatedBy String?

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime

  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitation")
}

model Tag {
  id    String  @id @default(cuid())
  name  String
  color String? // ex: "#FF5733" ou "blue-500"

  // Relations via tables de liaison explicites
  dealTagLinks         DealTagLink[]
  organizationTagLinks OrganizationTagLink[]
  // Liaison explicite avec Website via WebsiteTagLink
  websiteTagLinks      WebsiteTagLink[]
  technologyTagLinks   TechnologyTagLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
  @@map("tag")
}

// =============================
// Tables de liaison explicites Tag <-> (Organization | Deal | Technology)
// =============================

model OrganizationTagLink {
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId String

  // Métadonnées optionnelles
  createdBy   User?     @relation("OrganizationTagLinkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  source      String?
  detectedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([organizationId, tagId])
  @@index([tagId])
  @@index([organizationId])
  @@map("organization_tag_link")
}

model DealTagLink {
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId String

  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId String

  // Métadonnées optionnelles
  createdBy   User?     @relation("DealTagLinkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  source      String?
  detectedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([dealId, tagId])
  @@index([tagId])
  @@index([dealId])
  @@map("deal_tag_link")
}

model TechnologyTagLink {
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)
  technologyId String

  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId String

  // Métadonnées optionnelles
  createdBy   User?     @relation("TechnologyTagLinkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  source      String?
  detectedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([technologyId, tagId])
  @@index([tagId])
  @@index([technologyId])
  @@map("technology_tag_link")
}
